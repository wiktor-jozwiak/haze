// Upper deck: horizontal signal chain (IN → blocks → OUT), drawn as real stompboxes patched
// jack to jack. A box shows its main knobs (drag up/down or wheel to turn, pointer = real value),
// status LED, block name, active subtype and the footswitch. The bottom inspector edits every
// parameter; both read the same patch.
import { T } from "theme.slint";
import { Led, Icons } from "widgets.slint";

/// One knob on a pedal face: short label, position 0..1 and the displayed value.
export struct PedalKnob {
    label: string,
    norm: float,
    text: string,
}

export struct Pedal {
    title: string,
    type-name: string,
    on: bool,
    has-sw: bool,
    led: int,
    hue: color,
    ink: color,
    movable: bool,
    is-amp: bool,
    knobs: [PedalKnob],
    /// index into Glyphs (Panel.nodes order), used by the inspector header emblem
    kind: int,
}

/// Status LED (kept under the old name; drawn, not a bitmap).
export component LedImg inherits Rectangle {
    in property <int> state; // 0 off, 1 green, 2 red, 3 yellow
    width: 10px;
    height: 10px;
    Led {
        x: (parent.width - 8px) / 2;
        y: (parent.height - 8px) / 2;
        size: 8px;
        state: root.state;
    }
}

// ---------------------------------------------------------------- blocks

/// Small hex screw head in the enclosure corners.
component Screw inherits Rectangle {
    width: 5px;
    height: 5px;
    border-radius: 2.5px;
    background: #00000059;
    Rectangle {
        x: 1px;
        y: 1px;
        width: 3px;
        height: 3px;
        border-radius: 1.5px;
        background: #ffffff2e;
    }
}

/// Side jack: the patch cable plugs in here.
component Jack inherits Rectangle {
    width: 6px;
    height: 12px;
    border-radius: 2px;
    background: @linear-gradient(180deg, #C9CDD4 0%, #7D828B 55%, #4B4F57 100%);
}

/// Jewel status LED with a soft halo when lit.
component Jewel inherits Rectangle {
    in property <color> c;
    in property <bool> lit;
    width: 22px;
    height: 22px;
    Rectangle {
        visible: lit;
        border-radius: 11px;
        background: c.with-alpha(0.22);
    }
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: #000000a0;
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: lit ? c : #2A2D35;
            Rectangle {
                x: 1.5px;
                y: 1.5px;
                width: 3px;
                height: 3px;
                border-radius: 1.5px;
                background: lit ? #ffffffb0 : #ffffff14;
            }
        }
    }
}

/// Chicken-skirt knob: black cap, silver skirt, white pointer (-135°..+135°).
component FaceKnob inherits Rectangle {
    in property <float> norm;
    in property <length> size: 22px;
    property <angle> a: (-135 + 270 * clamp(norm, 0, 1)) * 1deg;
    width: size;
    height: size;
    // skirt
    Rectangle {
        border-radius: root.size / 2;
        background: @linear-gradient(160deg, #D8DBE0 0%, #8C9099 100%);
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1.5px;
        drop-shadow-color: #00000090;
    }
    // cap
    Rectangle {
        width: root.size - 5px;
        height: root.size - 5px;
        border-radius: (root.size - 5px) / 2;
        background: @linear-gradient(160deg, #3A3C42 0%, #121316 100%);
    }
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: #F4F5F7;
        stroke-width: 2px;
        MoveTo { x: 12 + 3 * Math.sin(root.a); y: 12 - 3 * Math.cos(root.a); }
        LineTo { x: 12 + 9.5 * Math.sin(root.a); y: 12 - 9.5 * Math.cos(root.a); }
    }
}

/// Classic enamel stompbox, top-down: a row of knobs (the block's main params, pointer shows the
/// real value), jewel LED, silkscreened name and subtype, metal footswitch (click = bypass).
/// The amp is drawn as a small head: brushed panel with its knobs, tolex, grille cloth.
/// Body click selects the block for the inspector, drag reorders it. Hover shows knob values.
export component PedalView inherits Rectangle {
    in property <Pedal> p;
    in property <bool> selected;
    in property <bool> ghost;
    in property <bool> lifted;
    out property <bool> hovered: body-ta.has-hover || sw-ta.has-hover || knob-ta.has-hover;
    /// what the pointer is over: 0 nothing, 1 body, 2 knobs, 3 footswitch (drives the help line)
    out property <int> zone: knob-ta.has-hover ? 2 : sw-ta.has-hover ? 3 : body-ta.has-hover ? 1 : 0;
    callback zone-changed(int);
    changed zone => { root.zone-changed(self.zone); }
    out property <bool> dragging;
    /// distance from the top of the box to the centre of its side jacks (cables run there)
    out property <length> jack-y: 62px;
    property <length> press-x;
    property <bool> bypassed: p.has-sw && !p.on;
    property <color> led-c: p.led == 2 ? T.led-red : p.led == 3 ? T.led-yellow : T.led-green;
    property <int> nk: p.knobs.length;
    property <length> ks: clamp((root.width - 14px) / 3 - 6px, 16px, 24px);
    // two knobs spread a little wider than three
    property <length> kpitch: (root.width - 10px) / (root.nk == 2 ? 2.4 : 3);
    property <length> kx0: (root.width - root.nk * root.kpitch) / 2;
    property <color> ink-2: p.ink.with-alpha(0.72);
    callback toggled;
    callback clicked;
    callback drag-start;
    callback drag-move(length);
    callback dropped;
    /// knob `k` dragged to `norm` (0..1) / wheel `dir` detents
    callback knob-set(int, float);
    callback knob-step(int, int);
    property <int> knob-i: -1;
    property <float> knob-start;
    property <length> knob-y0;

    width: 96px;
    height: 160px;

    body := Rectangle {
        y: lifted ? -8px : hovered && !ghost ? -2px : 0;
        width: parent.width;
        height: parent.height;
        opacity: ghost ? 0.15 : 1;
        animate y { duration: 110ms; easing: ease-out; }
        animate opacity { duration: 120ms; }

        if selected: Rectangle {
            x: -5px;
            y: -5px;
            width: parent.width + 10px;
            height: parent.height + 10px;
            border-radius: 15px;
            border-width: 2px;
            border-color: T.accent;
        }
        Jack { x: -5px; y: root.jack-y - 6px; }
        Jack { x: parent.width - 1px; y: root.jack-y - 6px; }

        // ------------------------------------------------ enclosure: die-cast box, powder coat
        Rectangle {
            border-radius: 7px;
            drop-shadow-blur: lifted ? 24px : 10px;
            drop-shadow-offset-y: lifted ? 16px : 6px;
            drop-shadow-color: lifted ? #000000d0 : #000000b8;
            background: p.is-amp
                ? @linear-gradient(180deg, #2C2E33 0%, #18191C 100%)
                : @linear-gradient(165deg, p.hue.brighter(0.28) 0%, p.hue 38%, p.hue.darker(0.3) 100%);
        }
        // powder-coat grain
        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("tex/felt.png");
            horizontal-tiling: repeat;
            vertical-tiling: repeat;
            opacity: 0.22;
        }
        // cast edges: lit top and left, shaded right and bottom
        Rectangle {
            border-radius: 7px;
            border-width: 1px;
            border-color: p.is-amp ? #3A3C42 : p.hue.darker(0.5);
        }
        Rectangle { x: 5px; y: 1px; width: parent.width - 10px; height: 1.5px; background: #ffffff55; }
        Rectangle { x: 1px; y: 6px; width: 1px; height: parent.height - 12px; background: #ffffff22; }
        Rectangle { x: parent.width - 2px; y: 6px; width: 1px; height: parent.height - 12px; background: #00000040; }
        Rectangle {
            x: 1px;
            y: parent.height - 7px;
            width: parent.width - 2px;
            height: 6px;
            border-radius: 6px;
            background: @linear-gradient(180deg, #00000000 0%, #00000055 100%);
        }

        // ------------------------------------------------ amp head panel (behind its knobs)
        if p.is-amp: Rectangle {
            x: 5px;
            y: 5px;
            width: parent.width - 10px;
            height: 68px;
            border-radius: 6px;
            background: @linear-gradient(180deg, T.accent-hi 0%, T.accent 50%, T.accent.darker(0.2) 100%);
            border-width: 1px;
            border-color: #00000050;
        }

        // ------------------------------------------------ knobs + labels / values
        for k[i] in p.knobs: Rectangle {
            x: root.kx0 + i * root.kpitch;
            y: p.is-amp ? 10px : 9px;
            width: root.kpitch;
            height: root.ks + 14px;
            FaceKnob {
                x: (parent.width - self.width) / 2;
                y: 0;
                size: root.ks;
                norm: k.norm;
            }
            Text {
                x: -4px;
                y: root.ks + 2px;
                width: parent.width + 8px;
                // narrow boxes (laptop widths): labels only make noise, hover still shows values
                visible: root.hovered || root.kpitch >= 27px || root.nk < 3;
                text: root.hovered ? k.text : k.label;
                horizontal-alignment: center;
                overflow: elide;
                color: p.is-amp ? T.accent-ink : root.ink-2;
                font-family: T.display;
                font-size: 10.5px;
                font-weight: 600;
            }
        }

        // ------------------------------------------------ stompbox face
        if !p.is-amp: Rectangle {
            Jewel {
                x: (parent.width - self.width) / 2;
                y: root.jack-y - 11px;
                c: root.led-c;
                lit: p.on;
            }
            // silk-screened frame around the name, as printed on real enclosures
            Rectangle {
                x: 7px;
                y: 73px;
                width: parent.width - 14px;
                height: 38px;
                border-radius: 4px;
                border-width: 1px;
                border-color: p.ink.with-alpha(0.32);
            }
            Text {
                x: 6px;
                y: 76px;
                width: parent.width - 12px;
                text: p.title;
                horizontal-alignment: center;
                overflow: elide;
                color: p.ink;
                font-family: T.display;
                font-size: 15.5px;
                font-weight: 700;
            }
            Text {
                x: 6px;
                y: 93px;
                width: parent.width - 12px;
                text: p.type-name;
                horizontal-alignment: center;
                overflow: elide;
                color: root.ink-2;
                font-family: T.display;
                font-size: 11.5px;
                font-weight: 500;
            }
            // footswitch: nut ring + domed metal cap
            Rectangle {
                y: parent.height - 47px;
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: #00000066;
                Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: 15px;
                    background: sw-ta.pressed
                        ? @linear-gradient(135deg, #8A8F98 0%, #D0D3D8 100%)
                        : @linear-gradient(135deg, #F3F4F6 0%, #B9BDC4 50%, #70757E 100%);
                    border-width: 1px;
                    border-color: #2E3036;
                    Rectangle {
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: @linear-gradient(135deg, #C9CCD2 0%, #9196A0 100%);
                    }
                }
            }
            Screw { x: 6px; y: parent.height - 11px; }
            Screw { x: parent.width - 11px; y: parent.height - 11px; }
        }
        // bypassed: the box sits in the dark, its lamp is off
        if bypassed && !lifted: Rectangle {
            border-radius: 7px;
            background: #00000066;
        }

        // ------------------------------------------------ amp head: name, model, grille
        if p.is-amp: Rectangle {
            Text {
                x: 6px;
                y: 52px;
                width: parent.width - 12px;
                text: p.title;
                horizontal-alignment: center;
                color: T.accent-ink;
                font-family: T.display;
                font-size: 14px;
                font-weight: 700;
                letter-spacing: 1.5px;
            }
            Text {
                x: 6px;
                y: 78px;
                width: parent.width - 12px;
                height: 28px;
                text: p.type-name;
                wrap: word-wrap;
                overflow: elide;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: #D8DBE0;
                font-family: T.display;
                font-size: 12px;
                font-weight: 600;
            }
            Rectangle {
                x: 5px;
                y: 110px;
                width: parent.width - 10px;
                height: parent.height - 115px;
                border-radius: 5px;
                background: #2E3036;
                border-width: 1px;
                border-color: #00000070;
                for g[i] in Math.floor((root.height - 121px) / 4px): Rectangle {
                    x: 3px;
                    y: 3px + i * 4px;
                    width: parent.width - 6px;
                    height: 1px;
                    background: #00000060;
                }
            }
        }

        body-ta := TouchArea {
            mouse-cursor: p.movable ? (root.dragging ? grabbing : grab) : pointer;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    root.press-x = self.mouse-x;
                    root.dragging = false;
                }
                if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                    if root.dragging {
                        root.dragging = false;
                        root.dropped();
                    } else {
                        root.clicked();
                    }
                }
            }
            moved => {
                if self.pressed {
                    if !root.dragging && p.movable && abs(self.mouse-x - root.press-x) > 8px {
                        root.dragging = true;
                        root.drag-start();
                    }
                    if root.dragging {
                        root.drag-move(self.mouse-x);
                    }
                }
            }
        }
        // knob row sits above the body's touch area: vertical drag or wheel turns the knob
        // under the pointer (150px = full sweep), a plain click still selects the block
        knob-ta := TouchArea {
            enabled: !root.ghost && !root.lifted && root.nk > 0;
            x: root.kx0;
            y: p.is-amp ? 6px : 5px;
            width: root.nk * root.kpitch;
            height: root.ks + 8px;
            mouse-cursor: ns-resize;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    root.knob-i = clamp(floor(self.mouse-x / root.kpitch), 0, root.nk - 1);
                    root.knob-start = p.knobs[root.knob-i].norm;
                    root.knob-y0 = self.mouse-y;
                }
                if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                    if abs(self.mouse-y - root.knob-y0) < 3px {
                        root.clicked();
                    }
                    root.knob-i = -1;
                }
            }
            moved => {
                if self.pressed && root.knob-i >= 0 && abs(self.mouse-y - root.knob-y0) >= 3px {
                    root.knob-set(root.knob-i, clamp(root.knob-start + (root.knob-y0 - self.mouse-y) / 150px, 0, 1));
                }
            }
            scroll-event(e) => {
                if e.delta-y == 0 {
                    return reject;
                }
                root.knob-step(clamp(floor(self.mouse-x / root.kpitch), 0, root.nk - 1), e.delta-y > 0 ? 1 : -1);
                accept
            }
        }
        // footswitch area sits above the body's touch area: stomp = bypass
        sw-ta := TouchArea {
            visible: p.has-sw;
            enabled: p.has-sw;
            y: root.height - 56px;
            height: 56px;
            mouse-cursor: pointer;
            clicked => { toggled(); }
        }
    }
}


// ---------------------------------------------------------------- signal chain

/// IN / OUT terminal of the chain.
/// IN / OUT terminal: a round badge on the cable line (guitar in, speaker cabinet out) with its
/// label underneath. The badge centre sits 20px below the top so the cable meets it in the middle.
export component ChainNode inherits Rectangle {
    in property <string> text;
    in property <bool> hot;
    in property <bool> out;
    width: 40px;
    height: 58px;
    Rectangle {
        y: 0;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: @radial-gradient(circle, T.panel-hi 0%, T.panel 100%);
        border-width: 1.5px;
        border-color: hot ? T.accent : T.line-hi;
        Path {
            width: 24px;
            height: 24px;
            viewbox-width: 24;
            viewbox-height: 24;
            stroke: hot ? T.accent-hi : T.text-2;
            stroke-width: 1.5px;
            fill: transparent;
            commands: out
                // speaker cabinet: box, cone, dust cap, logo strip
                ? "M5.5 3 L18.5 3 A2.5 2.5 0 0 1 21 5.5 L21 18.5 A2.5 2.5 0 0 1 18.5 21 L5.5 21 A2.5 2.5 0 0 1 3 18.5 L3 5.5 A2.5 2.5 0 0 1 5.5 3 Z M12 9 A4.75 4.75 0 1 0 12 18.5 A4.75 4.75 0 1 0 12 9 Z M12 12.3 A1.45 1.45 0 1 0 12 15.2 A1.45 1.45 0 1 0 12 12.3 Z M9 6 L15 6"
                // electric guitar: body, neck, headstock, pickups
                : "M13.2 10.8 L19.6 4.4 M18.2 2.6 L21.4 5.8 M11.4 9.2 C9.9 7.9 7.6 8.4 7 10.1 C6.6 11.2 5.4 11.4 4.4 12.1 C2.5 13.6 2.8 17.1 5 19.1 C7.1 21.2 10.4 21.5 11.9 19.6 C12.6 18.6 12.8 17.4 13.9 17 C15.6 16.4 16.1 14.1 14.8 12.6 Z M7.6 14.4 L9.6 16.4 M9.4 12.6 L11.4 14.6";
        }
    }
    Text {
        y: 43px;
        text: root.text;
        horizontal-alignment: center;
        color: hot ? T.accent-hi : T.text-3;
        font-family: T.mono;
        font-weight: 700;
        font-size: 9.5px;
        letter-spacing: 1px;
    }
}

/// Signal wire between blocks.
/// Patch cable between jacks.
export component Wire inherits Rectangle {
    in property <bool> hot;
    height: 3px;
    // rubber jacket, lit seam when the tone is playing on the amp
    Rectangle {
        y: -1.5px;
        height: 6px;
        border-radius: 3px;
        background: @linear-gradient(180deg, #4A4A4C 0%, #1A1A1B 55%, #0A0A0A 100%);
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: #000000a0;
    }
    if hot: Rectangle { y: 0; height: 1px; x: 4px; width: parent.width - 8px; background: T.accent.with-alpha(0.7); }
    // right-angle plug boots at both ends
    for e in 2: Rectangle {
        x: e == 0 ? 0 : parent.width - self.width;
        y: -4.5px;
        width: Math.min(7px, parent.width / 2);
        height: 12px;
        border-radius: 2px;
        background: @linear-gradient(180deg, #3C3C3E 0%, #121213 100%);
        border-width: 1px;
        border-color: #000000;
    }
}
