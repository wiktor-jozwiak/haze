// Upper deck: horizontal signal chain (IN → blocks → OUT) and the Amp Core panel.
// Studio chrome is flat fills and 1px hairlines; the stompboxes are pre-rendered bitmaps.
import { T } from "theme.slint";
import { Knob, Led } from "widgets.slint";

export struct MiniKnob {
    label: string,
    value: int,
    min: int,
    max: int,
    display: string,
}

export struct Pedal {
    title: string,
    type-name: string,
    on: bool,
    has-sw: bool,
    led: int,
    hue: color,
    ink: color,
    knobs: [MiniKnob],
    movable: bool,
    is-amp: bool,
}

export struct KnobVal {
    label: string,
    value: int,
    min: int,
    max: int,
    reset: int,
    display: string,
}

/// Status LED (kept under the old name; drawn, not a bitmap).
export component LedImg inherits Rectangle {
    in property <int> state; // 0 off, 1 green, 2 red, 3 yellow
    width: 10px;
    height: 10px;
    Led {
        x: (parent.width - 8px) / 2;
        y: (parent.height - 8px) / 2;
        size: 8px;
        state: root.state;
    }
}

// ---------------------------------------------------------------- amp core

/// Voicing button. `family` < 0: voicing exists only in the PC DSP engine.
component Voicing inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked;
    height: 28px;
    border-radius: T.r;
    background: active ? T.accent : ta.has-hover && enabled ? T.hover : T.well;
    border-width: 1px;
    border-color: active ? T.accent : T.line;
    opacity: enabled ? 1 : 0.4;
    Text {
        text: root.text;
        color: active ? T.accent-ink : T.text-2;
        font-family: T.mono;
        font-weight: 600;
        font-size: 10.5px;
        letter-spacing: 0.8px;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AmpCore inherits Rectangle {
    in property <[KnobVal]> knobs;
    in property <int> family;
    in property <bool> variation;
    in property <string> amp-name;
    in property <bool> live;
    in property <bool> connected;
    in property <bool> compact;
    /// PC-engine voicing picked that the Katana lacks (2 PUSHED, 6 MODERN), -1 none
    in property <int> dsp-voicing: -1;
    callback knob-changed(int, int);
    callback family-picked(int);
    callback variation-toggled(bool);
    callback dsp-voicing-picked(int);

    // label, Katana family index (-1 = not on the Katana MkII), PC engine voicing index
    property <[{n: string, f: int, d: int}]> voicings: [
        { n: "ACOUSTIC", f: 0, d: 0 }, { n: "CLEAN", f: 1, d: 1 }, { n: "PUSHED", f: -1, d: 2 }, { n: "CRUNCH", f: 2, d: 3 },
        { n: "LEAD", f: 3, d: 4 }, { n: "BROWN", f: 4, d: 5 }, { n: "MODERN", f: -1, d: 6 },
    ];

    height: compact ? 132px : 168px;
    border-radius: 6px;
    background: T.panel;
    border-width: 1px;
    border-color: T.line;

    HorizontalLayout {
        padding: 16px;
        padding-left: 20px;
        spacing: 20px;
        // voicing column
        VerticalLayout {
            width: 268px;
            spacing: 8px;
            alignment: start;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "AMP";
                    color: T.text;
                    font-family: T.mono;
                    font-weight: 700;
                    font-size: 13px;
                    letter-spacing: 2px;
                    vertical-alignment: center;
                }
                Text {
                    text: amp-name;
                    color: T.text-3;
                    font-family: T.mono;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            Rectangle {
                height: 2 * 28px + 6px;
                for v[i] in voicings: Voicing {
                    x: mod(i, 4) * (parent.width + 6px) / 4;
                    y: floor(i / 4) * 34px;
                    width: (parent.width - 18px) / 4;
                    text: v.n;
                    active: dsp-voicing >= 0 ? v.d == dsp-voicing : v.f >= 0 && v.f == family;
                    enabled: v.f >= 0 || !T.hw;
                    clicked => {
                        if v.f >= 0 { family-picked(v.f); } else { dsp-voicing-picked(v.d); }
                    }
                }
                // VARIATION in the 8th cell
                Rectangle {
                    x: 3 * (parent.width + 6px) / 4;
                    y: 34px;
                    width: (parent.width - 18px) / 4;
                    height: 28px;
                    border-radius: T.r;
                    background: vta.has-hover ? T.hover : T.well;
                    border-width: 1px;
                    border-color: variation ? T.accent-lo : T.line;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 5px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: variation ? T.accent : #2A2D35;
                            }
                        }
                        Text {
                            text: "VAR";
                            color: variation ? T.accent-hi : T.text-2;
                            font-family: T.mono;
                            font-weight: 600;
                            font-size: 10.5px;
                            letter-spacing: 0.8px;
                            vertical-alignment: center;
                        }
                    }
                    vta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { variation-toggled(!variation); }
                    }
                }
            }
            if !compact && T.hw: Text {
                text: "PUSHED / MODERN: tylko silnik PC DSP";
                color: T.text-3;
                font-size: 10.5px;
            }
        }
        Rectangle { width: 1px; background: T.line; }
        // encoders
        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: space-around;
            for k[i] in knobs: VerticalLayout {
                alignment: center;
                Knob {
                    dial: compact ? 48px : 58px;
                    label: k.label;
                    value: k.value;
                    min: k.min;
                    max: k.max;
                    reset: k.reset;
                    display: k.display;
                    changed(v) => { knob-changed(i, v); }
                }
            }
        }
        Rectangle { width: 1px; background: T.line; }
        // engine state
        VerticalLayout {
            width: 96px;
            alignment: center;
            spacing: 8px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: live ? T.accent : #2A2D35;
                    Rectangle {
                        visible: live;
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: T.accent.with-alpha(0.16);
                    }
                }
            }
            Text {
                text: live ? "LIVE" : connected ? "STANDBY" : "OFFLINE";
                horizontal-alignment: center;
                color: live ? T.accent-hi : T.text-2;
                font-family: T.mono;
                font-weight: 700;
                font-size: 11px;
                letter-spacing: 2px;
            }
        }
    }
}

// ---------------------------------------------------------------- stompboxes
// Realistic pedals: pre-rendered bitmaps from crates/katana-art (enclosure shading, knob
// sprite sheets, footswitch, LEDs). The CPU renderer only blits and clips them.

component Tip inherits Rectangle {
    in property <string> text;
    width: tt.preferred-width + 14px;
    height: 20px;
    border-radius: 4px;
    background: #0D0E11EE;
    border-width: 1px;
    border-color: #ffffff1a;
    tt := Text {
        text: root.text;
        color: #E8EAF0;
        font-family: T.display;
        font-weight: 700;
        font-size: 11px;
    }
}

component LedBmp inherits Image {
    in property <int> state; // 0 off, 1 green, 2 red, 3 yellow
    width: 22px;
    height: 22px;
    source: state == 1 ? @image-url("art/led-green.png") : state == 2 ? @image-url("art/led-red.png") : state == 3 ? @image-url("art/led-yellow.png") : @image-url("art/led-off.png");
}

component MiniDial inherits Rectangle {
    in property <MiniKnob> k;
    in property <bool> cream;
    in property <color> ink;
    callback changed(int);
    property <float> t: (k.value - k.min) / Math.max(1, k.max - k.min);
    property <int> start-v;
    property <length> start-y;
    width: 28px;
    height: 40px;
    Image {
        x: 1px;
        width: 26px;
        height: 26px;
        source: cream ? @image-url("art/knob-cream.png") : @image-url("art/knob-black.png");
        source-clip-y: round(root.t * 63) * 26;
        source-clip-width: 26;
        source-clip-height: 26;
    }
    Text {
        y: 29px;
        x: -3px;
        width: parent.width + 6px;
        text: k.label;
        horizontal-alignment: center;
        overflow: clip;
        color: ink.with-alpha(0.8);
        font-family: T.display;
        font-weight: 700;
        font-size: 7.5px;
        letter-spacing: 0.4px;
    }
    ta := TouchArea {
        height: 28px;
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.start-v = k.value;
                root.start-y = self.mouse-y;
            }
        }
        moved => {
            if self.pressed {
                root.changed(clamp(round(root.start-v + (root.start-y - self.mouse-y) / 140px * (k.max - k.min)), k.min, k.max));
            }
        }
        scroll-event(e) => {
            root.changed(clamp(k.value + (e.delta-y > 0 ? 1 : -1) * Math.max(1, round((k.max - k.min) / 100)), k.min, k.max));
            accept
        }
    }
    if ta.has-hover || ta.pressed: Tip {
        x: (parent.width - self.width) / 2;
        y: -22px;
        text: k.label + "  " + k.display;
    }
}

export component PedalView inherits Rectangle {
    in property <Pedal> p;
    in property <bool> selected;
    in property <bool> ghost;
    in property <bool> lifted;
    out property <bool> hovered: body-ta.has-hover;
    out property <bool> dragging;
    property <length> press-x;
    callback knob(int, int);
    callback toggled;
    callback clicked;
    callback drag-start;
    callback drag-move(length);
    callback dropped;

    width: 92px;
    height: 176px;

    // selection halo
    if selected: Rectangle {
        x: -4px;
        y: body.y - 4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-radius: 11px;
        border-width: 2px;
        border-color: T.accent-hi;
    }
    body := Rectangle {
        y: lifted ? -10px : (hovered && !ghost) || selected ? -3px : 0;
        width: parent.width;
        height: parent.height;
        opacity: ghost ? 0.18 : 1;
        animate y { duration: 110ms; easing: ease-out; }
        border-radius: 7px;
        background: p.is-amp ? #141210 : @linear-gradient(180deg, p.hue.brighter(0.12) 0%, p.hue 55%, p.hue.darker(0.12) 100%);
        drop-shadow-blur: lifted ? 22px : 10px;
        drop-shadow-offset-y: lifted ? 16px : 6px;
        drop-shadow-color: #000000c8;

        // AMP block: a miniature Katana head — tolex, brass control strip, grille with logo
        if p.is-amp: Rectangle {
            border-radius: 7px;
            clip: true;
            Image {
                width: parent.width;
                height: parent.height;
                source: @image-url("art/tolex.png");
                horizontal-tiling: repeat;
                vertical-tiling: repeat;
            }
            // brass control strip behind the three dials
            Rectangle {
                x: 5px;
                y: 20px;
                width: parent.width - 10px;
                height: 46px;
                border-radius: 3px;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: @image-url("art/brass.png");
                    horizontal-tiling: repeat;
                }
                Rectangle { background: @linear-gradient(180deg, #ffffff38 0%, #00000000 35%, #00000018 100%); }
            }
            // grille with gold piping, logo and amp type
            Rectangle {
                x: 5px;
                y: 72px;
                width: parent.width - 10px;
                height: parent.height - 78px;
                border-radius: 3px;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: @image-url("art/grille.png");
                    horizontal-tiling: repeat;
                    vertical-tiling: repeat;
                }
                Rectangle { background: @linear-gradient(180deg, #00000000 0%, #00000000 55%, #00000070 100%); }
                Rectangle {
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: #b8964f;
                }
                Text {
                    y: 22px;
                    width: parent.width;
                    horizontal-alignment: center;
                    text: "KATANA";
                    color: #e7cd8b;
                    font-family: T.display;
                    font-weight: 800;
                    font-italic: true;
                    font-size: 13px;
                    letter-spacing: 1.5px;
                }
                Rectangle {
                    x: 14px;
                    y: 42px;
                    width: parent.width - 28px;
                    height: 1px;
                    background: #b8964f80;
                }
                Text {
                    y: 50px;
                    x: 4px;
                    width: parent.width - 8px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    text: p.type-name;
                    color: #d8c08a;
                    font-family: T.display;
                    font-weight: 700;
                    font-size: 8.5px;
                    letter-spacing: 0.6px;
                }
            }
        }
        if !p.is-amp: Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("art/pedal.png");
        }

        LedBmp {
            x: (parent.width - 22px) / 2;
            y: 2px;
            state: p.on ? p.led : 0;
        }
        HorizontalLayout {
            y: 22px;
            height: 40px;
            alignment: center;
            spacing: 0px;
            for k[i] in p.knobs: MiniDial {
                k: k;
                cream: p.is-amp;
                ink: p.is-amp ? #1a1004 : p.ink;
                changed(v) => { knob(i, v); }
            }
        }
        if !p.is-amp: Text {
            y: 66px;
            width: parent.width;
            text: p.title;
            horizontal-alignment: center;
            color: p.ink;
            font-family: T.display;
            font-weight: 700;
            font-size: p.title.character-count > 8 ? 11px : 14px;
            letter-spacing: 1.2px;
        }
        if !p.is-amp && p.type-name != p.title: Text {
            y: 84px;
            width: parent.width - 8px;
            x: 4px;
            text: p.type-name;
            horizontal-alignment: center;
            overflow: elide;
            color: p.ink.with-alpha(0.72);
            font-family: T.display;
            font-weight: 700;
            font-size: 9px;
            letter-spacing: 0.6px;
        }

        body-ta := TouchArea {
            y: 64px;
            height: parent.height - 64px;
            mouse-cursor: p.movable ? (root.dragging ? grabbing : grab) : pointer;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    root.press-x = self.mouse-x;
                    root.dragging = false;
                }
                if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                    if root.dragging {
                        root.dragging = false;
                        root.dropped();
                    } else {
                        root.clicked();
                    }
                }
            }
            moved => {
                if self.pressed {
                    if !root.dragging && p.movable && abs(self.mouse-x - root.press-x) > 8px {
                        root.dragging = true;
                        root.drag-start();
                    }
                    if root.dragging {
                        root.drag-move(self.mouse-x);
                    }
                }
            }
        }
        if p.has-sw: Image {
            x: (parent.width - 40px) / 2;
            y: 120px;
            width: 40px;
            height: 40px;
            source: @image-url("art/footswitch.png");
            Rectangle {
                visible: fsa.pressed;
                x: 8px;
                y: 8px;
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: #00000050;
            }
            fsa := TouchArea {
                mouse-cursor: pointer;
                clicked => { toggled(); }
            }
        }
    }
}


// ---------------------------------------------------------------- signal chain

/// IN / OUT terminal of the chain.
export component ChainNode inherits Rectangle {
    in property <string> text;
    in property <bool> hot;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: T.well;
    border-width: 1px;
    border-color: hot ? T.accent-lo : T.line-hi;
    Text {
        text: root.text;
        color: hot ? T.accent-hi : T.text-2;
        font-family: T.mono;
        font-weight: 700;
        font-size: 10px;
        letter-spacing: 1px;
    }
}

/// Signal wire between blocks.
export component Wire inherits Rectangle {
    in property <bool> hot;
    height: 2px;
    background: hot ? T.accent-lo : T.line-hi;
}
