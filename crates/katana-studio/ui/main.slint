import "fonts/AdwaitaSans-Regular.ttf";
import "fonts/BarlowSemiCondensed-Medium.ttf";
import "fonts/BarlowSemiCondensed-SemiBold.ttf";
import "fonts/BarlowSemiCondensed-Bold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-SemiBold.ttf";
import "fonts/JetBrainsMono-Bold.ttf";
import { ListView } from "std-widgets.slint";
import { T } from "theme.slint";
import { Label, Btn, Led, Toggle, Icon, Icons } from "widgets.slint";
import { PedalView, ChainNode, Wire, Pedal, PedalKnob } from "rig.slint";
import { ToneRow, NavItem, Essential, TemplateRow, BlockChip } from "library.slint";
import { Inspector, ParamRow } from "inspector.slint";
import { PracticeDrawer } from "practice.slint";
import { PracticePage, MixCh, DrumRow } from "page-practice.slint";
import { Slot, Opt, ChainOpt } from "types.slint";
import { Silk } from "gear.slint";
import { Faceplate, Tolex, Felt, PanelScrew, Groove, Lamp, BatToggle, VuMeter, PanelKey, RoundKey, Inset, BrandPlate } from "gear.slint";
import { IconBtn, MenuItem, Menu, SlotChip, ModeBtn, Pick, Well, PillDivider, Meter, SettingsRow, PageTab } from "parts.slint";
import { LibraryPage } from "page-library.slint";
import { SetlistsPage } from "page-setlists.slint";
import { StartersPage } from "page-starters.slint";
import { TunerPage, TunerString } from "page-tuner.slint";
import { PcFxPage, PcCard, PcCtl } from "page-pcfx.slint";
import { Picker } from "picker.slint";
import { SlotPicker, ConfirmWrite, ImportDialog, AddToSetlist, TagsDialog, KeysDialog } from "dialogs.slint";
import { LiveView } from "live.slint";
import { EmptyState } from "art.slint";

export { T, Pedal, PedalKnob, ToneRow, NavItem, Essential, ParamRow, TemplateRow, BlockChip, Slot, Opt, ChainOpt, TunerString, PcCard, PcCtl, MixCh, DrumRow }

// ---------------------------------------------------------------- window

export component MainWindow inherits Window {
    title: "Haze Studio";
    icon: @image-url("art/icon.png");
    preferred-width: 1680px;
    preferred-height: 1000px;
    min-width: 1280px;
    // below ~1440px (the 1280px minimum, or 1920px at 150 %) the top bar tightens:
    // icon without wordmark, closer spacing, shorter labels, narrower engine pill
    // the PC engine has one tab more (PC FX), meters and the engine pill: measured, the full
    // bar needs ~1830px there (compact tabs, meters and device picks fit 1280px)
    property <bool> bar-compact: self.width < (T.hw ? 1440px : 1840px);
    min-height: 780px;
    background: T.chrome;
    default-font-family: "Adwaita Sans";
    default-font-size: 13px;

    // --- library
    in property <[NavItem]> nav;
    in property <string> nav-selected;
    /// number of user setlists (kind 2) in `nav`
    in property <int> set-count;
    in property <string> nav-title;
    in property <[ToneRow]> tones;
    in property <int> selected-index: -1;
    in property <bool> has-selection;
    in property <[Essential]> essentials;
    /// 0 Rig, 1 Library, 2 Setlists, 3 Starter rigs, 4 Tuner, 5 PC FX, 6 Practice
    in-out property <int> page;
    in property <[TemplateRow]> templates;
    in-out property <string> query;

    // --- engine mode + studio utilities (fed by the audio engine; idle values until it runs)
    in property <bool> hw-mode: true;
    in property <string> audio-host: "ALSA";
    in property <string> audio-device: "System default";
    in property <string> audio-input: "None (DI)";
    in property <int> audio-buffer: 128;
    in property <int> audio-rate: 48000;
    in property <bool> audio-running;
    in property <float> audio-latency;
    in property <bool> di-on: true;
    // practice suite (page 6)
    in property <int> loop-state;
    in property <float> loop-progress;
    in property <string> loop-time: "0.0 s";
    in property <bool> drum-on;
    in property <int> drum-pattern;
    in property <int> bpm: 100;
    in property <int> drum-step;
    in property <int> bar-len: 16;
    in property <int> time-sig;
    in property <bool> count-in: true;
    in property <bool> loop-sync: true;
    in property <int> loop-wait;
    in property <bool> trainer-on;
    in property <int> trainer-step: 5;
    in property <int> trainer-bars: 4;
    in property <int> trainer-target: 160;
    in property <[string]> groove-names;
    in property <[string]> groove-names-b;
    in property <int> user-slot;
    in property <int> user-len: 16;
    in property <int> beat-steps: 4;
    in property <int> bar-group: 16;
    in property <[DrumRow]> drum-rows;
    in property <[MixCh]> mix-bus;
    in property <[MixCh]> mix-kit;
    in property <int> kit-tune;
    in property <int> kit-decay: 100;
    in property <int> kit-swing;
    in property <int> kit-human: 30;
    in property <int> kit-fills: 2;
    in property <string> ir-name: "built-in (per amp)";
    in property <string> di-name: "built-in riff";
    in property <int> dsp-voicing: -1;
    in property <string> tuner-note: "—";
    in property <float> tuner-cents;
    in property <bool> tuner-active;
    // tuner page (page 4)
    in property <int> tuner-octave;
    in property <float> tuner-hz;
    /// needle cents: from the target string, or the nearest note in chromatic mode
    in property <float> tuner-needle;
    in property <string> tuner-target;
    in property <float> tuner-target-hz;
    in property <float> tuner-strobe;
    in property <[TunerString]> tuner-strings;
    in property <string> tuner-tuning-name: "Standard E";
    in property <int> tuner-reference: 440;
    in property <bool> tuner-mute;
    in property <bool> tuner-chromatic;
    callback tuner-tuning-request();
    callback tuner-reference-changed(int);
    callback tuner-mute-toggled(bool);
    callback tuner-mode-picked(bool);
    // PC FX page
    in property <[PcCard]> pcfx-cards;
    in property <int> pcfx-bpm: 100;
    callback pcfx-toggled(int);
    callback pcfx-set(int, int, float);
    in property <float> in-level;
    in property <float> out-level;
    in property <bool> in-clip;
    in property <bool> out-clip;
    in property <bool> limiter;
    in property <int> ab-slot;
    in property <bool> ab-has-b;
    in property <string> tag;
    in property <[string]> user-tags;
    in-out property <int> sort;
    in property <int> ui-scale: 100;

    // --- amp connection
    in property <bool> connected;
    in property <string> conn-text: "Offline";
    in property <[Slot]> slots;
    in property <string> busy-text;
    in property <float> busy-progress: -1;
    in property <string> toast;
    in property <bool> toast-error;

    // --- rig
    in property <string> ed-name;
    in property <string> ed-origin;
    in property <bool> ed-fav;
    /// user tags of the edited tone, comma separated
    in property <string> ed-tags;
    in property <bool> ed-dirty;
    in property <bool> ed-live;
    in property <string> ed-amp-name;
    in property <int> ed-amp-family: -1;
    in property <bool> ed-amp-var;
    in property <string> ed-chain-name;
    in property <[ChainOpt]> chain-presets;
    callback chain-preset(int);
    in property <int> ed-fx-on;
    in property <int> ed-fx-all;
    in property <[Pedal]> pedals;
    in property <int> pedal-selected: -1;
    in property <[bool]> drop-ok;
    in property <bool> can-undo;
    in property <bool> can-redo;

    // --- inspector (single source of truth for the selected block)
    in property <bool> insp-open;
    in property <bool> insp-is-amp;
    in property <int> insp-kind;
    in property <string> insp-title;
    in property <string> insp-subtitle;
    in property <color> insp-hue;
    in property <color> insp-ink;
    in property <bool> insp-has-sw;
    in property <bool> insp-on;
    in property <int> insp-variant: -1;
    in property <[Opt]> insp-types;
    in property <int> insp-type;
    in property <[string]> insp-sections;
    in property <int> insp-section;
    in property <[ParamRow]> insp-params;
    in property <float> insp-params-h;
    in property <float> insp-cols: 8;
    in property <bool> insp-head-row;
    in property <int> insp-extra;
    in property <string> insp-eq-curve;
    in property <string> insp-eq-fill;
    in property <int> insp-delay-ms;
    callback insp-delay-sync(int);

    in property <[Opt]> popup-options;
    in property <string> popup-title;
    in property <string> import-hint;

    // --- callbacks
    callback search(string);
    callback nav-clicked(string);
    callback tone-clicked(int);
    callback tone-activated(int);
    callback tone-fav(int);
    callback essential-clicked(string);
    callback amp-family(int);
    callback amp-variation(bool);
    callback pedal-clicked(int);
    callback pedal-toggled(int);
    callback pedal-drag-start(int);
    callback pedal-dropped(int, int);
    callback pedal-knob-set(int, int, float);
    callback pedal-knob-step(int, int, int);
    callback insp-toggle(bool);
    callback insp-variant-picked(int);
    callback insp-type-picked(int);
    callback insp-type-request();
    callback insp-section-picked(int);
    callback insp-param(int, int);
    callback insp-enum-request(int);
    callback popup-picked(int);
    callback rename(string);
    callback toggle-fav();
    callback audition();
    callback save();
    callback save-copy();
    callback revert();
    callback delete-tone();
    callback export-tone();
    callback export-list();
    callback write-slot(int);
    callback connect();
    callback select-slot(int);
    callback pull-slot(int);
    callback backup-amp();
    callback import-path(string);
    callback import-windows();
    callback mode-picked(bool);
    callback audio-buffer-picked(int);
    callback audio-device-request(bool);
    callback audio-rate-picked(int);
    callback limiter-toggled(bool);
    callback ab-picked(int);
    callback di-toggled(bool);
    callback transport();
    callback loop-action(int);
    callback drum-toggled(bool);
    callback drum-pattern-picked(int);
    callback bpm-changed(int);
    callback time-sig-picked(int);
    callback count-in-toggled(bool);
    callback loop-sync-toggled(bool);
    callback trainer-toggled(bool);
    callback trainer-set(int, int, int);
    callback user-slot-picked(int);
    callback user-len-picked(int);
    callback user-copy();
    callback user-clear();
    callback drum-cell(int, int, int);
    callback mix-set(int, float);
    callback mix-mute(int);
    callback mix-reset(int);
    callback kit-set(int, int);
    callback tap();
    callback load-ir(string);
    callback load-di(string);
    callback dsp-voicing-picked(int);
    callback tag-picked(string);
    callback page-picked(int);
    callback template-use(int);
    callback set-new();
    callback set-rename(string);
    callback set-add-current();
    callback song-move(int, int);
    callback song-remove(int);
    callback tone-add-to(int, string);
    callback tone-step(int);
    callback undo();
    callback sort-picked(int);
    callback ui-scale-picked(int);
    callback skin-picked(int);
    callback effect-names-picked(bool);
    callback hints-toggled(bool);
    callback set-tags(string);
    callback redo();

    public function open-popup() { enum-popup.show(); }

    property <int> confirm-slot: -1;
    property <bool> show-import;
    property <bool> show-tags;
    in-out property <bool> show-keys;
    in-out property <int> add-tone: -1;
    property <bool> show-slot-picker;
    in-out property <bool> show-picker;
    /// stage view over everything, window goes full screen
    in-out property <bool> live-open;
    full-screen: live-open;

    // pedalboard geometry: responsive pitch, the drop gap is pure arithmetic.
    // Boxes shrink (down to 72px) before the chain scrolls, so 11 blocks + IN/OUT fit a laptop.
    // The pitch keeps >= 14px between boxes: the side jacks and a stub of cable stay visible.
    property <length> board-w: 1000px;
    property <length> rail-w: 52px; // IN / OUT terminals and their lead cables
    property <int> n: Math.max(1, pedals.length);
    property <length> pw: clamp((board-w - 2 * rail-w - n * 16px) / n, 72px, 112px);
    property <length> ph: 160px;
    property <length> jack-y: 62px; // must match PedalView.jack-y
    property <length> ps: clamp((board-w - 2 * rail-w - n * pw) / n, 14px, 30px);
    property <length> pitch: pw + ps;
    property <length> left: (board-w - pedals.length * pitch) / 2;
    property <int> drag-from: -1;
    // help line above the chain: which pedal and which part of it is under the pointer
    property <int> hint-pedal: -1;
    property <int> hint-zone: 0;
    property <string> hint-text: !T.hints ? ""
        : hint-zone == 0 || hint-pedal < 0 || hint-pedal >= pedals.length
        ? "Click a block to edit it  ·  drag it to reorder"
        : pedals[hint-pedal].title + ":  " + (
            hint-zone == 2 ? "drag up / down or scroll to turn a knob"
            : hint-zone == 3 ? (pedals[hint-pedal].on ? "click the footswitch to bypass" : "click the footswitch to switch it on")
            : pedals[hint-pedal].movable ? "click to edit  ·  drag to move in the chain" : "click to edit");
    property <length> drag-x;
    property <int> gap: clamp(floor((drag-x - left + ps / 2) / pitch + 0.5), 0, pedals.length);

    Tolex {
        width: parent.width;
        height: parent.height;
        // the top bar floats over the page: soft shadow under it
        Rectangle {
            y: 64px;
            height: 16px;
            background: @linear-gradient(180deg, #00000070 0%, #00000000 100%);
        }
    }
    VerticalLayout {
        // ================================================= top bar: brand+mode | device | meters+actions
        Faceplate {
            height: 64px;
            z: 10; // its tooltips hang over the page below
            PanelScrew { x: 8px; y: (parent.height - self.height) / 2; }
            PanelScrew { x: parent.width - 18px; y: (parent.height - self.height) / 2; }
            HorizontalLayout {
                padding-left: root.bar-compact ? 18px : 28px;
                padding-right: root.bar-compact ? 18px : 28px;
                padding-top: 13px;
                padding-bottom: 13px;
                spacing: root.bar-compact ? 6px : 16px;
                // -------- zone 1: brand plate + pages
                BrandPlate { compact: root.bar-compact; }
                Groove { }
                HorizontalLayout {
                    spacing: 4px;
                    PanelKey {
                        pad: root.bar-compact ? 5px : 12px;
                        text: "RIG";
                        active: page == 0;
                        clicked => { page-picked(0); }
                    }
                    PanelKey {
                        pad: root.bar-compact ? 5px : 12px;
                        text: "LIBRARY";
                        badge: nav.length > 1 ? nav[1].count : "";
                        active: page == 1;
                        clicked => { page-picked(1); }
                    }
                    PanelKey {
                        pad: root.bar-compact ? 5px : 12px;
                        text: "SETLISTS";
                        active: page == 2;
                        clicked => { page-picked(2); }
                    }
                    PanelKey {
                        pad: root.bar-compact ? 5px : 12px;
                        text: root.bar-compact ? "STARTERS" : "STARTER RIGS";
                        active: page == 3;
                        clicked => { page-picked(3); }
                    }
                    PanelKey {
                        pad: root.bar-compact ? 5px : 12px;
                        text: "TUNER";
                        active: page == 4;
                        clicked => { page-picked(4); }
                    }
                    if !T.hw: PanelKey {
                        pad: root.bar-compact ? 5px : 12px;
                        text: "PC FX";
                        active: page == 5;
                        clicked => { page-picked(5); }
                    }
                    PanelKey {
                        pad: root.bar-compact ? 5px : 12px;
                        text: "PRACTICE";
                        active: page == 6;
                        clicked => { page-picked(6); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }

                // -------- zone 2: engine mode + its device / connection pill
                VerticalLayout {
                    alignment: center;
                    BatToggle {
                        left-text: "AMP";
                        right-text: "PC";
                        left-c: T.amber;
                        right-c: T.cyan;
                        left-tip: "Amp: edit the Katana over USB, every change plays on the amp";
                        right-tip: "PC engine: play through this computer with the built-in amp, cab and effects";
                        right: !hw-mode;
                        picked(r) => { mode-picked(!r); }
                    }
                }
                if hw-mode: Inset {
                    width: hw-row.preferred-width;
                    hw-row := HorizontalLayout {
                        padding-left: 14px;
                        padding-right: connected && busy-text == "" ? 16px : 4px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Lamp { size: 11px; c: T.led-red; lit: connected; }
                        }
                        // compact: the AMP / PC lever right beside it already names the engine
                        if !root.bar-compact: Text {
                            text: "KATANA MkII";
                            color: T.silk;
                            font-family: T.display;
                            font-size: 14px;
                            font-weight: 700;
                            letter-spacing: 1px;
                            vertical-alignment: center;
                        }
                        Text {
                            // offline in Amp mode: say where the edits go instead of a bare status
                            text: (root.bar-compact ? "" : "·  ") + (connected ? "Online"
                                : conn-text == "Offline" && !root.bar-compact ? "Offline, edits stay in Haze" : conn-text);
                            color: connected ? T.led-green : T.text-2;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        if busy-text != "": PillDivider { }
                        if busy-text != "": Text {
                            text: busy-text;
                            color: T.text-2;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        if busy-text != "" && busy-progress >= 0: VerticalLayout {
                            alignment: center;
                            padding-right: 12px;
                            Rectangle {
                                width: 72px;
                                height: 3px;
                                background: T.line-hi;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * root.busy-progress;
                                    background: T.accent;
                                }
                            }
                        }
                        if !connected: PillDivider { }
                        if !connected: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: ct.preferred-width + 24px;
                                height: 28px;
                                border-radius: 14px;
                                background: cta.pressed ? T.accent-lo : cta.has-hover ? T.accent-hi : T.accent;
                                ct := Text {
                                    text: "Connect";
                                    color: T.accent-ink;
                                    font-size: 12px;
                                    font-weight: 700;
                                }
                                cta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { connect(); }
                                }
                            }
                        }
                    }
                }
                if !hw-mode: Inset {
                    width: Math.min(pc-row.preferred-width, root.bar-compact ? 380px : 540px);
                    pc-row := HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 4px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Lamp { size: 11px; c: T.cyan; lit: audio-running; }
                        }
                        if !root.bar-compact: Text {
                            text: "PC ENGINE";
                            color: T.silk;
                            font-family: T.display;
                            font-size: 14px;
                            font-weight: 700;
                            letter-spacing: 1px;
                            vertical-alignment: center;
                        }
                        Text {
                            // engine estimate when running (buffers + ring + IR partition), else 2 buffers;
                            // converter latency of the interface comes on top
                            // compact: the lamp already says running / stopped
                            text: (root.bar-compact ? "" : "·  " + (audio-running ? "Running" : "Stopped") + " · ") + round((audio-running ? audio-latency : 2000 * audio-buffer / audio-rate) * 10) / 10 + " ms";
                            color: audio-running ? T.accent : T.text-2;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        PillDivider { }
                        VerticalLayout {
                            alignment: center;
                            Pick {
                                text: "In: " + audio-input;
                                max-width: root.bar-compact ? 74px : 130px;
                                clicked => { audio-device-request(true); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Pick {
                                text: "Out: " + audio-device;
                                max-width: root.bar-compact ? 74px : 130px;
                                clicked => { audio-device-request(false); }
                            }
                        }
                        PillDivider { }
                        VerticalLayout {
                            alignment: center;
                            Pick {
                                text: di-on ? "DI ▶" : "DI";
                                active: di-on;
                                clicked => { di-toggled(!di-on); }
                            }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }

                // -------- zone 3: meters + library / settings
                // levels come from the PC engine; in Amp mode they would sit empty
                if !hw-mode: HorizontalLayout {
                    spacing: 10px;
                    VuMeter { label: "IN"; level: in-level; clipped: in-clip; compact: root.bar-compact; }
                    VuMeter { label: "OUT"; level: out-level; clipped: out-clip; compact: root.bar-compact; }
                }
                VerticalLayout {
                    alignment: center;
                    RoundKey {
                        icon: Icons.help;
                        tip: "Keyboard shortcuts (F1)";
                        clicked => { show-keys = true; }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    RoundKey {
                        icon: Icons.gear;
                        tip: "Settings";
                        clicked => { settings.show(); }
                    }
                }
            }
            settings := PopupWindow {
                x: parent.width - 352px;
                y: 58px;
                width: 340px;
                height: 440px;
                close-policy: close-on-click-outside;
                Menu {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Text {
                            text: "APPEARANCE";
                            color: T.text-2;
                            font-family: T.mono;
                            font-size: 10px;
                            font-weight: 700;
                            letter-spacing: 1.2px;
                        }
                        SettingsRow {
                            label: "Look";
                            for k[i] in ["Studio", "Katana panel"]: Pick {
                                text: k;
                                active: i == T.skin;
                                clicked => { skin-picked(i); }
                            }
                        }
                        SettingsRow {
                            label: "Pedal names";
                            for k[i] in ["Effect", "Slot"]: Pick {
                                text: k;
                                active: (i == 0) == T.effect-names;
                                clicked => { effect-names-picked(i == 0); }
                            }
                        }
                        SettingsRow {
                            label: "Help hints";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    on: T.hints;
                                    toggled(v) => { hints-toggled(v); }
                                }
                            }
                        }
                        SettingsRow {
                            label: "Interface size";
                            for z in [100, 125, 150]: Pick {
                                text: z + "%";
                                active: z == ui-scale;
                                clicked => { ui-scale-picked(z); }
                            }
                        }
                        Rectangle { height: 6px; }
                        Text {
                            text: "PC ENGINE AUDIO";
                            color: T.text-2;
                            font-family: T.mono;
                            font-size: 10px;
                            font-weight: 700;
                            letter-spacing: 1.2px;
                        }
                        SettingsRow {
                            label: "Buffer";
                            for b in [64, 128, 256]: Pick {
                                text: b;
                                active: b == audio-buffer;
                                clicked => { audio-buffer-picked(b); }
                            }
                        }
                        SettingsRow {
                            label: "Sample rate";
                            for r in [48000, 96000]: Pick {
                                text: (r / 1000) + " kHz";
                                active: r == audio-rate;
                                clicked => { audio-rate-picked(r); }
                            }
                        }
                        SettingsRow {
                            label: "Limiter";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    on: limiter;
                                    toggled(v) => { limiter-toggled(v); }
                                }
                            }
                        }
                        SettingsRow {
                            label: "Host";
                            Text { text: audio-host; color: T.text; font-size: 12px; vertical-alignment: center; }
                        }
                        Text {
                            text: "Amp mode uses the Katana's own audio path.";
                            wrap: word-wrap;
                            color: T.text-3;
                            font-size: 11px;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            padding-top: 4px;
            padding-left: 12px;
            padding-right: 12px;
            padding-bottom: 4px;

            VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;
            // ============================================= page: Rig
            if page == 0: VerticalLayout {
            vertical-stretch: 1;
            // ============================================= stage: tone header + signal chain
            stage := Rectangle {
                property <length> deck-h: 346px;
                vertical-stretch: 0;
                min-height: deck-h;
                max-height: deck-h;

                if !has-selection: EmptyState {
                    art: 0;
                    compact: true;
                    title: "No preset loaded";
                    body: "Pick one of your presets, or start from a ready-made rig and shape it here.";
                    Btn {
                        primary: true;
                        text: "Browse presets  ·  Ctrl+K";
                        clicked => { show-picker = true; }
                    }
                    Btn {
                        text: "Start from a starter rig";
                        clicked => { page-picked(3); }
                    }
                }
                if has-selection: VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 16px;
                    padding-bottom: 18px;
                    spacing: 0px;

                    // ---------- tone header
                    HorizontalLayout {
                        height: 58px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 2px;
                                IconBtn {
                                    icon: Icons.chevron-left;
                                    tip: "Previous preset";
                                    clicked => { tone-step(-1); }
                                }
                                IconBtn {
                                    icon: Icons.chevron-right;
                                    tip: "Next preset";
                                    clicked => { tone-step(1); }
                                }
                            }
                        }
                        Rectangle { width: 2px; }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 10px;
                                TextInput {
                                    text: ed-name;
                                    color: T.silk;
                                    font-family: T.display;
                                    font-size: 28px;
                                    font-weight: 700;
                                    single-line: true;
                                    accepted => {
                                        rename(self.text);
                                        self.clear-focus();
                                    }
                                }
                                Rectangle {
                                    width: 24px;
                                    Icon {
                                        d: Icons.star;
                                        size: 18px;
                                        filled: ed-fav;
                                        tint: ed-fav ? T.accent : T.text-2;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { toggle-fav(); }
                                    }
                                }
                                // quick preset picker window
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: bt.preferred-width + 36px;
                                        height: 28px;
                                        border-radius: 6px;
                                        background: bta.has-hover ? #ffffff10 : #ffffff08;
                                        border-width: 1px;
                                        border-color: #ffffff12;
                                        bt := Text {
                                            x: 12px;
                                            text: "BROWSE";
                                            color: T.silk-2;
                                            font-family: T.display;
                                            font-size: 12.5px;
                                            font-weight: 700;
                                            letter-spacing: 1px;
                                        }
                                        Icon {
                                            x: parent.width - 22px;
                                            d: Icons.chevron-down;
                                            size: 14px;
                                            tint: T.text-2;
                                        }
                                        bta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { show-picker = true; }
                                        }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: ed-amp-name;
                                    color: T.text-2;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: "·   " + ed-fx-on + " of " + ed-fx-all + " effects on" + (ed-tags == "" ? "" : "   ·   #" + ed-tags);
                                    color: T.text-2;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if ed-dirty: VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 6px;
                                Btn {
                                    compact: true;
                                    text: "Revert";
                                    clicked => { revert(); }
                                }
                                Btn {
                                    compact: true;
                                    text: "Save";
                                    clicked => { save(); }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 2px;
                                IconBtn {
                                    icon: Icons.undo;
                                    enabled: can-undo;
                                    tip: "Undo (Ctrl+Z)";
                                    clicked => { undo(); }
                                }
                                IconBtn {
                                    icon: Icons.redo;
                                    enabled: can-redo;
                                    tip: "Redo (Ctrl+Y)";
                                    clicked => { redo(); }
                                }
                            }
                        }
                        // A/B snapshot compare lives with the preset it compares
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 32px;
                                width: ab.preferred-width + 6px;
                                border-radius: 8px;
                                background: #00000066;
                                ab := HorizontalLayout {
                                    x: 3px;
                                    y: 3px;
                                    height: 26px;
                                    spacing: 2px;
                                    Pick {
                                        text: "A";
                                        width: 36px;
                                        active: ab-slot == 0;
                                        clicked => { ab-picked(0); }
                                    }
                                    Pick {
                                        text: ab-has-b ? "B" : "+B";
                                        width: 36px;
                                        active: ab-slot == 1;
                                        clicked => { ab-picked(1); }
                                    }
                                }
                            }
                        }
                        if connected && hw-mode: VerticalLayout {
                            alignment: center;
                            Btn {
                                primary: true;
                                compact: true;
                                text: ed-live ? "Playing on amp" : "Play on amp";
                                clicked => { audition(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            more-btn := IconBtn {
                                icon: Icons.more;
                                filled: true;
                                tip: "Preset actions";
                                clicked => { more-menu.show(); }
                            }
                        }
                        more-menu := PopupWindow {
                            x: parent.width - 236px;
                            y: 54px;
                            width: 236px;
                            height: 6 * 36px + 12px;
                            Menu {
                                VerticalLayout {
                                    padding: 6px;
                                    MenuItem {
                                        text: "Write to amp channel…";
                                        enabled: connected;
                                        clicked => { show-slot-picker = true; more-menu.close(); }
                                    }
                                    MenuItem {
                                        text: "Edit tags…";
                                        clicked => { show-tags = true; more-menu.close(); }
                                    }
                                    MenuItem {
                                        text: "Duplicate";
                                        clicked => { save-copy(); more-menu.close(); }
                                    }
                                    MenuItem {
                                        text: "Export .tsl";
                                        clicked => { export-tone(); more-menu.close(); }
                                    }
                                    MenuItem {
                                        text: "Revert changes";
                                        enabled: ed-dirty;
                                        clicked => { revert(); more-menu.close(); }
                                    }
                                    MenuItem {
                                        text: "Delete (move to trash)";
                                        danger: true;
                                        clicked => { delete-tone(); more-menu.close(); }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { height: 12px; }

                    // ---------- signal chain caption
                    HorizontalLayout {
                        height: 22px;
                        spacing: 10px;
                        Silk {
                            text: "SIGNAL CHAIN";
                            vertical-alignment: center;
                        }
                        // current order (preset name when it matches one); opens the chain presets
                        Rectangle {
                            width: cn.preferred-width + 34px;
                            border-radius: 5px;
                            background: cna.has-hover ? T.hover : transparent;
                            border-width: 1px;
                            border-color: cna.has-hover ? T.line-hi : T.line;
                            HorizontalLayout {
                                padding-left: 9px;
                                padding-right: 7px;
                                spacing: 5px;
                                cn := Text {
                                    text: ed-chain-name;
                                    color: cna.has-hover ? T.text : T.text-2;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Icon { d: Icons.chevron-down; size: 12px; tint: T.text-2; }
                                }
                            }
                            cna := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { chain-menu.show(); }
                            }
                            chain-menu := PopupWindow {
                                x: 0;
                                y: parent.height + 6px;
                                width: 540px;
                                height: chain-presets.length * 58px + 44px;
                                Menu {
                                    VerticalLayout {
                                        padding: 6px;
                                        Text {
                                            height: 30px;
                                            x: 10px;
                                            text: "CHAIN PRESETS  ·  order only, sounds stay";
                                            color: T.text-3;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                        for c[i] in chain-presets: Rectangle {
                                            height: 58px;
                                            border-radius: 6px;
                                            background: ca.has-hover ? T.hover : c.current ? T.panel-hi : transparent;
                                            if c.current: Rectangle { x: 0; y: 10px; width: 3px; height: parent.height - 20px; border-radius: 1.5px; background: T.accent; }
                                            VerticalLayout {
                                                padding-left: 14px;
                                                padding-right: 12px;
                                                padding-top: 8px;
                                                padding-bottom: 8px;
                                                spacing: 2px;
                                                Text {
                                                    text: c.name;
                                                    color: c.current ? T.accent : T.text;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: c.blurb;
                                                    color: T.text-2;
                                                    font-size: 11.5px;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: c.flow;
                                                    color: T.text-3;
                                                    font-family: T.mono;
                                                    font-size: 10px;
                                                    overflow: elide;
                                                }
                                            }
                                            ca := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { chain-preset(i); chain-menu.close(); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            font-size: 12px;
                            text: drag-from >= 0 ? (drop-ok[gap] ? "Release to reorder" : "The Katana can't run blocks in this order") : hint-text;
                            color: drag-from >= 0 ? (drop-ok[gap] ? T.led-green : T.led-red) : hint-zone > 0 ? T.text : T.text-3;
                        }
                    }
                    Rectangle { height: 8px; }

                    // ---------- signal chain
                    deck := Rectangle {
                        height: ph + 50px;
                        border-radius: 14px;
                        clip: true;
                        background: T.bg;
                        drop-shadow-blur: 14px;
                        drop-shadow-offset-y: 6px;
                        drop-shadow-color: #00000070;
                        Felt {
                            width: parent.width;
                            height: parent.height;
                            // recessed tray: inner shadow along the top edge
                            Rectangle { y: 0; height: 14px; background: @linear-gradient(180deg, #00000080 0%, #00000000 100%); }
                        }
                        // hairline edge
                        Rectangle {
                            border-radius: 14px;
                            border-width: 1px;
                            border-color: #ffffff12;
                        }
                        Rectangle {
                            x: 3px;
                            y: 3px;
                            width: parent.width - 6px;
                            height: parent.height - 6px;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #00000080;
                        }
                        Rectangle { x: 10px; y: 0; width: parent.width - 20px; height: 1px; background: #ffffff26; }
                        Flickable {
                        // scroll only when even the narrowest boxes do not fit
                        content-width: Math.max(self.width, 2 * rail-w + pedals.length * (72px + 14px));
                        interactive: drag-from < 0;
                    board := Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.content-width;
                        height: parent.height;
                        init => { root.board-w = self.width; }
                        changed width => { root.board-w = self.width; }
                        property <length> py: (self.height - ph) / 2 + 2px;
                        // cables run between the side jacks
                        property <length> wy: py + jack-y;
                        ChainNode {
                            x: 4px;
                            y: board.wy - 20px;
                            text: "IN";
                            hot: ed-live;
                        }
                        ChainNode {
                            x: board.width - 44px;
                            y: board.wy - 20px;
                            text: "OUT";
                            out: true;
                            hot: ed-live;
                        }
                        if pedals.length > 0: Wire {
                            x: 44px;
                            y: board.wy - 1.5px;
                            width: left + ps / 2 - 44px;
                            hot: ed-live;
                        }
                        if pedals.length > 0: Wire {
                            x: left + ps / 2 + (pedals.length - 1) * pitch + pw;
                            y: board.wy - 1.5px;
                            width: board.width - 44px - self.x;
                            hot: ed-live;
                        }
                        for c[i] in Math.max(0, pedals.length - 1): Wire {
                            x: left + ps / 2 + i * pitch + pw;
                            y: board.wy - 1.5px;
                            width: ps;
                            hot: ed-live;
                        }
                        for p[i] in pedals: PedalView {
                            x: left + ps / 2 + i * pitch;
                            y: board.py;
                            width: pw;
                            height: ph;
                            p: p;
                            selected: i == pedal-selected && insp-open;
                            ghost: i == drag-from;
                            clicked => { pedal-clicked(i); }
                            toggled => { pedal-toggled(i); }
                            knob-set(k, x) => { pedal-knob-set(i, k, x); }
                            zone-changed(z) => {
                                if z > 0 {
                                    hint-pedal = i;
                                    hint-zone = z;
                                } else if hint-pedal == i {
                                    hint-zone = 0;
                                }
                            }
                            knob-step(k, d) => { pedal-knob-step(i, k, d); }
                            drag-start => {
                                drag-from = i;
                                drag-x = self.x + pw / 2;
                                pedal-drag-start(i);
                            }
                            drag-move(mx) => { drag-x = self.x + mx; }
                            dropped => {
                                pedal-dropped(drag-from, gap);
                                drag-from = -1;
                            }
                        }
                        if drag-from >= 0: Rectangle {
                            for ok[g] in drop-ok: Rectangle {
                                border-radius: 1px;
                                x: left + g * pitch - 1px;
                                y: board.py - 4px;
                                width: 2px;
                                height: ph + 8px;
                                background: ok ? (g == gap ? T.led-green : T.led-green.with-alpha(0.25)) : (g == gap ? T.led-red : transparent);
                            }
                        }
                        if drag-from >= 0: PedalView {
                            x: drag-x - pw / 2;
                            y: board.py;
                            width: pw;
                            height: ph;
                            p: pedals[drag-from];
                            lifted: true;
                        }
                    }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            // ---------- inspector: docked under the stage, always shows the selected block
            dock := Rectangle {
                vertical-stretch: 1;
                min-height: 280px;
                clip: true;
                if insp-open: Inspector {
                    x: 0;
                    y: 12px;
                    width: parent.width;
                    height: parent.height - 12px;
                    title: insp-title;
                    subtitle: insp-subtitle;
                    hue: insp-hue;
                    kind: insp-kind;
                    ink: insp-ink;
                    has-sw: insp-has-sw;
                    on: insp-on;
                    variant: insp-variant;
                    has-types: insp-types.length > 0;
                    sections: insp-sections;
                    section: insp-section;
                    params: insp-params;
                    params-h: insp-params-h;
                    cols: insp-cols;
                    head-row: insp-head-row;
                    is-amp: insp-is-amp;
                    amp-family: ed-amp-family;
                    amp-var: ed-amp-var;
                    dsp-voicing: dsp-voicing;
                    extra: insp-extra;
                    eq-curve: insp-eq-curve;
                    eq-fill: insp-eq-fill;
                    delay-ms: insp-delay-ms;
                    bpm: bpm;
                    delay-sync(ms) => { insp-delay-sync(ms); }
                    tap => { root.tap(); }
                    toggle(v) => { insp-toggle(v); }
                    variant-picked(i) => { insp-variant-picked(i); }
                    type-request => { insp-type-request(); }
                    section-picked(i) => { insp-section-picked(i); }
                    param(i, v) => { insp-param(i, v); }
                    enum-request(i) => { insp-enum-request(i); }
                    family-picked(f) => { amp-family(f); }
                    variation-toggled(v) => { amp-variation(v); }
                    dsp-voicing-picked(v) => { dsp-voicing-picked(v); }
                }
            }

            // ---------- amp channels, under the inspector (only when an amp is there)
            if connected: HorizontalLayout {
                height: 48px;
                padding-top: 8px;
                spacing: 4px;
                for sl[i] in slots: SlotChip {
                    horizontal-stretch: 1;
                    slot: sl;
                    clicked => { select-slot(i); }
                    pull => { pull-slot(i); }
                    push => { if has-selection { confirm-slot = i; } }
                }
            }

            }

            // ============================================= page: Library
            if page == 1: LibraryPage {
                vertical-stretch: 1;
                nav-selected: nav-selected;
                tones: tones;
                selected-index: selected-index;
                tag: tag;
                connected: connected;
                user-tags: user-tags;
                sort: sort;
                sort-picked(v) => { root.sort-picked(v); }
                query <=> root.query;
                nav-clicked(id) => { root.nav-clicked(id); }
                search(q) => { root.search(q); }
                tag-picked(t) => { root.tag-picked(t); }
                import-request => { show-import = true; }
                backup-amp => { root.backup-amp(); }
                export-list => { root.export-list(); }
                tone-clicked(i) => { root.tone-clicked(i); }
                tone-opened(i) => {
                    root.tone-clicked(i);
                    root.page-picked(0);
                }
                tone-fav(i) => { root.tone-fav(i); }
                tone-add(i) => { add-tone = i; }
            }

            // ============================================= page: Setlists (collections | numbered songs)
            if page == 2: SetlistsPage {
                vertical-stretch: 1;
                nav: nav;
                nav-selected: nav-selected;
                nav-title: nav-title;
                tones: tones;
                selected-index: selected-index;
                has-selection: has-selection;
                nav-clicked(id) => { root.nav-clicked(id); }
                set-new => { root.set-new(); }
                set-rename(n) => { root.set-rename(n); }
                set-add-current => { root.set-add-current(); }
                live => { live-open = true; }
                browse => { page-picked(1); }
                export-list => { root.export-list(); }
                tone-clicked(i) => { root.tone-clicked(i); }
                tone-opened(i) => {
                    root.tone-clicked(i);
                    root.page-picked(0);
                }
                song-move(i, d) => { root.song-move(i, d); }
                song-remove(i) => { root.song-remove(i); }
            }

            // ============================================= page: Starter rigs (ready-made chains)
            if page == 3: StartersPage {
                vertical-stretch: 1;
                templates: templates;
                used(i) => { template-use(i); }
            }

            // ============================================= page: PC FX
            if page == 5: PcFxPage {
                vertical-stretch: 1;
                engine: !T.hw && audio-running;
                cards: pcfx-cards;
                bpm: pcfx-bpm;
                toggled(c) => { pcfx-toggled(c); }
                set(c, i, v) => { pcfx-set(c, i, v); }
            }

            // ============================================= page: Tuner
            if page == 4: TunerPage {
                vertical-stretch: 1;
                engine: !T.hw && audio-running;
                active: tuner-active;
                note: tuner-note;
                octave: tuner-octave;
                cents: tuner-needle;
                hz: tuner-hz;
                target: tuner-target;
                target-hz: tuner-target-hz;
                strobe: tuner-strobe;
                strings: tuner-strings;
                tuning-name: tuner-tuning-name;
                reference: tuner-reference;
                mute: tuner-mute;
                chromatic: tuner-chromatic;
                tuning-request => { tuner-tuning-request(); }
                reference-changed(r) => { tuner-reference-changed(r); }
                mute-toggled(m) => { tuner-mute-toggled(m); }
                mode-picked(c) => { tuner-mode-picked(c); }
                engine-request => { mode-picked(false); }
            }


            // ============================================= page: Practice
            if page == 6: PracticePage {
                vertical-stretch: 1;
                engine: !T.hw && audio-running;
                loop-state: loop-state;
                loop-progress: loop-progress;
                loop-time: loop-time;
                loop-wait: loop-wait;
                drum-on: drum-on;
                drum-pattern: drum-pattern;
                groove-names: groove-names;
                groove-names-b: groove-names-b;
                user-slot: user-slot;
                user-len: user-len;
                bpm: bpm;
                drum-step: drum-step;
                bar-len: bar-len;
                beat-steps: beat-steps;
                bar-group: bar-group;
                time-sig: time-sig;
                count-in: count-in;
                loop-sync: loop-sync;
                trainer-on: trainer-on;
                trainer-step: trainer-step;
                trainer-bars: trainer-bars;
                trainer-target: trainer-target;
                drum-rows: drum-rows;
                mix-bus: mix-bus;
                mix-kit: mix-kit;
                kit-tune: kit-tune;
                kit-decay: kit-decay;
                kit-swing: kit-swing;
                kit-human: kit-human;
                kit-fills: kit-fills;
                ir-name: ir-name;
                di-name: di-name;
                loop-action(a) => { root.loop-action(a); }
                drum-toggled(o) => { root.drum-toggled(o); }
                drum-pattern-picked(i) => { root.drum-pattern-picked(i); }
                user-slot-picked(i) => { root.user-slot-picked(i); }
                user-len-picked(n) => { root.user-len-picked(n); }
                user-copy => { root.user-copy(); }
                user-clear => { root.user-clear(); }
                drum-cell(r, st, v) => { root.drum-cell(r, st, v); }
                bpm-changed(b) => { root.bpm-changed(b); }
                tap => { root.tap(); }
                time-sig-picked(i) => { root.time-sig-picked(i); }
                count-in-toggled(o) => { root.count-in-toggled(o); }
                loop-sync-toggled(o) => { root.loop-sync-toggled(o); }
                trainer-toggled(o) => { root.trainer-toggled(o); }
                trainer-set(a, b, c) => { root.trainer-set(a, b, c); }
                mix-set(c, v) => { root.mix-set(c, v); }
                mix-mute(c) => { root.mix-mute(c); }
                mix-reset(c) => { root.mix-reset(c); }
                kit-set(k, v) => { root.kit-set(k, v); }
                load-ir(f) => { root.load-ir(f); }
                load-di(f) => { root.load-di(f); }
                engine-request => { mode-picked(false); }
            }

            // ---------- status bar: Practice key, looper / drum state, tuner readout
            PracticeDrawer {
                open: page == 6;
                engine: !T.hw && audio-running;
                loop-state: loop-state;
                loop-time: loop-time;
                loop-wait: loop-wait;
                drum-on: drum-on;
                bpm: bpm;
                show-tuner: !hw-mode;
                tuner-note: tuner-active ? tuner-note + tuner-octave : tuner-note;
                tuner-cents: tuner-cents;
                tuner-active: tuner-active;
                toggled(o) => { page-picked(o ? 6 : 0); }
                engine-request => { mode-picked(false); }
            }
            }
        }

    }

    // Spacebar: DI player transport (standalone). Text fields keep their own spaces.
    keys := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        init => { self.focus(); }
        key-pressed(e) => {
            if e.modifiers.control && (e.text == "k" || e.text == "K") {
                show-picker = true;
                return accept;
            }
            if e.modifiers.control && (e.text == "1" || e.text == "2" || e.text == "3" || e.text == "4") {
                page-picked(e.text == "1" ? 0 : e.text == "2" ? 1 : e.text == "3" ? 2 : 3);
                return accept;
            }
            if e.modifiers.control && (e.text == "z" || e.text == "Z") {
                if e.modifiers.shift { redo(); } else { undo(); }
                return accept;
            }
            if e.modifiers.control && (e.text == "y" || e.text == "Y") {
                redo();
                return accept;
            }
            if e.text == Key.F1 || e.text == "?" {
                show-keys = true;
                return accept;
            }
            if e.modifiers.control && (e.text == "l" || e.text == "L") {
                live-open = true;
                return accept;
            }
            if e.text == " " {
                transport();
                return accept;
            }
            reject
        }
    }

    // ================================================= overlays
    enum-popup := PopupWindow {
        x: root.width - 410px;
        y: 200px;
        width: 360px;
        height: Math.min(root.height - 260px, 50px + popup-options.length * 32px);
        Menu {
            VerticalLayout {
                padding: 8px;
                spacing: 4px;
                Label {
                    text: popup-title;
                    color: T.accent;
                    height: 24px;
                }
                ListView {
                    for o in popup-options: Rectangle {
                        height: 32px;
                        border-radius: 6px;
                        background: ota.has-hover ? T.hover : transparent;
                        Text {
                            x: 10px;
                            text: o.label;
                            color: T.text;
                            vertical-alignment: center;
                        }
                        ota := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                popup-picked(o.value);
                                enum-popup.close();
                            }
                        }
                    }
                }
            }
        }
    }

    if show-picker: Picker {
        nav-selected: nav-selected;
        nav-title: nav-title;
        essentials: essentials;
        tones: tones;
        selected-index: selected-index;
        query <=> root.query;
        close => { show-picker = false; }
        search(q) => { root.search(q); }
        nav-clicked(id) => { root.nav-clicked(id); }
        essential-clicked(id) => {
            root.essential-clicked(id);
            show-picker = false;
        }
        tone-clicked(i) => {
            root.tone-clicked(i);
            show-picker = false;
        }
    }

    if show-slot-picker: SlotPicker {
        name: ed-name;
        slots: slots;
        dismissed => { show-slot-picker = false; }
        picked(i) => {
            show-slot-picker = false;
            confirm-slot = i;
        }
    }

    if confirm-slot >= 0: ConfirmWrite {
        slot: slots[confirm-slot];
        name: ed-name;
        dismissed => { confirm-slot = -1; }
        confirmed => {
            write-slot(confirm-slot);
            confirm-slot = -1;
        }
    }

    if add-tone >= 0 && add-tone < tones.length: AddToSetlist {
        name: tones[add-tone].name;
        nav: nav;
        n-sets: set-count;
        dismissed => { add-tone = -1; }
        picked(id) => {
            tone-add-to(add-tone, id);
            add-tone = -1;
        }
    }

    if show-keys: KeysDialog {
        dismissed => {
            show-keys = false;
            keys.focus();
        }
    }

    if show-tags: TagsDialog {
        name: ed-name;
        tags: ed-tags;
        dismissed => { show-tags = false; }
        saved(t) => {
            set-tags(t);
            show-tags = false;
        }
    }

    if show-import: ImportDialog {
        hint: import-hint;
        dismissed => { show-import = false; }
        import-windows => {
            root.import-windows();
            show-import = false;
        }
        import-path(p) => {
            root.import-path(p);
            show-import = false;
        }
    }


    if live-open: LiveView {
        tones: tones;
        selected-index: selected-index;
        list-name: nav-title;
        connected: connected;
        step(d) => { tone-step(d); }
        close => {
            live-open = false;
            keys.focus();
        }
    }

    if toast != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - (connected ? 96px : 50px);
        width: tt.preferred-width + 40px;
        height: 40px;
        border-radius: 20px;
        background: toast-error ? #3a1712 : #1f1c17;
        border-width: 1px;
        border-color: toast-error ? T.danger : #ffffff18;
        drop-shadow-blur: 20px;
        drop-shadow-color: #000000a0;
        tt := Text {
            text: toast;
            color: T.text;
        }
    }
}
