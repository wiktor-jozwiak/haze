import { ListView } from "std-widgets.slint";
import { T } from "theme.slint";
import { Label, Btn, Led, Toggle, SearchField, Icon, Icons, Seg } from "widgets.slint";
import { AmpCore, PedalView, ChainNode, Wire, Pedal, MiniKnob, KnobVal, LedImg } from "rig.slint";
import { LibrarySidebar, ToneRow, NavItem, Essential, SidebarMetrics } from "sidebar.slint";
import { Inspector, ParamRow } from "inspector.slint";

export { T, Pedal, MiniKnob, KnobVal, ToneRow, NavItem, Essential, ParamRow }

export struct Slot {
    label: string,
    name: string,
    current: bool,
}

export struct Opt {
    value: int,
    label: string,
}

// ---------------------------------------------------------------- small parts

component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <bool> filled;
    in property <bool> active;
    callback clicked;
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background: active ? T.hover : ta.has-hover ? T.panel-hi : transparent;
    Icon {
        d: icon;
        filled: root.filled;
        size: 20px;
        tint: ta.has-hover || active ? T.text : T.text-2;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked;
    height: 36px;
    border-radius: 6px;
    background: ta.has-hover && enabled ? T.hover : transparent;
    Text {
        x: 14px;
        text: root.text;
        color: !enabled ? T.text-3 : danger ? T.danger : T.text;
        vertical-alignment: center;
        height: parent.height;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Menu inherits Rectangle {
    background: T.panel-hi;
    border-radius: 6px;
    border-width: 1px;
    border-color: T.line-hi;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 10px;
    drop-shadow-color: #000000c0;
    @children
}

component SlotChip inherits Rectangle {
    in property <Slot> slot;
    callback clicked;
    callback pull;
    callback push;
    height: 40px;
    border-radius: T.r;
    background: slot.current ? T.panel-hi : ta.has-hover ? T.panel : transparent;
    border-width: slot.current ? 1px : 0;
    border-color: T.accent-lo;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        Text {
            text: slot.label;
            color: slot.current ? T.accent-hi : T.text-3;
            font-family: T.mono;
            font-weight: 700;
            font-size: 10.5px;
            letter-spacing: 1px;
            vertical-alignment: center;
        }
        Text {
            text: slot.name;
            color: slot.current ? T.text : T.text-2;
            font-family: T.display;
            font-weight: 700;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if ta.has-hover: Rectangle {
            width: 16px;
            Icon { d: Icons.pull; size: 16px; tint: pa.has-hover ? T.text : T.text-3; y: (parent.height - 16px) / 2; }
            pa := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.pull(); }
            }
        }
        if ta.has-hover && slot.label != "PANEL": Rectangle {
            width: 16px;
            Icon { d: Icons.push; size: 16px; tint: wa.has-hover ? T.text : T.text-3; y: (parent.height - 16px) / 2; }
            wa := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.push(); }
            }
        }
    }
}

// ---------------------------------------------------------------- top bar parts

/// One half of the HARDWARE / STANDALONE switch.
component ModeSeg inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <color> led;
    in property <bool> active;
    callback clicked;
    width: 150px;
    border-radius: T.r;
    background: active ? led.with-alpha(0.10) : ta.has-hover ? T.hover : transparent;
    border-width: 1px;
    border-color: active ? led.with-alpha(0.55) : transparent;
    HorizontalLayout {
        padding-left: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: active ? led : #2A2D35;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: title;
                color: active ? T.text : T.text-2;
                font-family: T.mono;
                font-weight: 700;
                font-size: 11px;
                letter-spacing: 1.2px;
            }
            Text {
                text: sub;
                color: active ? led : T.text-3;
                font-family: T.mono;
                font-size: 9px;
                letter-spacing: 0.6px;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Small segmented option (buffer size, sample rate, A/B).
component Pick inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked;
    width: t.preferred-width + 14px;
    height: 24px;
    border-radius: 3px;
    background: active ? T.accent : ta.has-hover && enabled ? T.hover : transparent;
    opacity: enabled ? 1 : 0.4;
    t := Text {
        text: root.text;
        color: active ? T.accent-ink : T.text-2;
        font-family: T.mono;
        font-weight: 600;
        font-size: 10.5px;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Recessed well grouping top-bar controls.
component Well inherits Rectangle {
    height: 36px;
    border-radius: T.r;
    background: T.well;
    border-width: 1px;
    border-color: T.line;
}

/// Peak meter with clip LED.
component Meter inherits Rectangle {
    in property <string> label;
    in property <float> level; // 0..1 peak
    in property <bool> clipped;
    width: 54px;
    height: 36px;
    Text {
        x: 0;
        y: 3px;
        text: root.label;
        color: T.text-3;
        font-family: T.mono;
        font-size: 8.5px;
        letter-spacing: 1px;
    }
    Rectangle {
        x: parent.width - 6px;
        y: 4px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: clipped ? T.led-red : #2A2D35;
    }
    Rectangle {
        x: 0;
        y: 20px;
        width: parent.width;
        height: 6px;
        border-radius: 1px;
        background: T.well;
        border-width: 1px;
        border-color: T.line;
        Rectangle {
            x: 1px;
            y: 1px;
            height: 4px;
            width: (parent.width - 2px) * clamp(root.level, 0, 1);
            background: root.level > 0.89 ? T.led-red : root.level > 0.7 ? T.led-yellow : T.accent;
        }
    }
}

// ---------------------------------------------------------------- window

export component MainWindow inherits Window {
    title: "Haze";
    icon: @image-url("art/icon.png");
    preferred-width: 1680px;
    preferred-height: 1000px;
    min-width: 1280px;
    min-height: 780px;
    background: T.chrome;
    default-font-family: "Adwaita Sans";
    default-font-size: 13px;

    // --- library
    in property <[NavItem]> nav;
    in property <string> nav-selected;
    in property <string> nav-title;
    in property <[ToneRow]> tones;
    in property <int> selected-index: -1;
    in property <bool> has-selection;
    in property <[Essential]> essentials;
    in-out property <bool> sidebar-pinned: true;

    // --- engine mode + studio utilities (fed by the audio engine; idle values until it runs)
    in property <bool> hw-mode: true;
    in property <string> audio-host: "ALSA";
    in property <string> audio-device: "default";
    in property <int> audio-buffer: 128;
    in property <int> audio-rate: 48000;
    in property <bool> audio-running;
    in property <float> audio-latency;
    in property <bool> di-on: true;
    in property <int> dsp-voicing: -1;
    in property <string> tuner-note: "—";
    in property <float> tuner-cents;
    in property <bool> tuner-active;
    in property <float> in-level;
    in property <float> out-level;
    in property <bool> in-clip;
    in property <bool> out-clip;
    in property <bool> limiter;
    in property <int> ab-slot;
    in property <bool> ab-has-b;
    in property <string> tag;

    // --- amp connection
    in property <bool> connected;
    in property <string> conn-text: "szukam…";
    in property <[Slot]> slots;
    in property <string> busy-text;
    in property <float> busy-progress: -1;
    in property <string> toast;
    in property <bool> toast-error;

    // --- rig
    in property <string> ed-name;
    in property <string> ed-origin;
    in property <bool> ed-fav;
    in property <bool> ed-dirty;
    in property <bool> ed-live;
    in property <string> ed-amp-name;
    in property <int> ed-amp-family: -1;
    in property <bool> ed-amp-var;
    in property <string> ed-chain-name;
    in property <int> ed-fx-on;
    in property <int> ed-fx-all;
    in property <[KnobVal]> knobs;
    in property <[Pedal]> pedals;
    in property <int> pedal-selected: -1;
    in property <[bool]> drop-ok;

    // --- inspector
    in property <bool> insp-open;
    in property <string> insp-title;
    in property <string> insp-subtitle;
    in property <color> insp-hue;
    in property <color> insp-ink;
    in property <bool> insp-has-sw;
    in property <bool> insp-on;
    in property <int> insp-variant: -1;
    in property <[Opt]> insp-types;
    in property <int> insp-type;
    in property <[string]> insp-sections;
    in property <int> insp-section;
    in property <[ParamRow]> insp-params;
    in property <float> insp-params-h;

    in property <[Opt]> popup-options;
    in property <string> popup-title;
    in property <string> import-hint;

    // --- callbacks
    callback search(string);
    callback nav-clicked(string);
    callback tone-clicked(int);
    callback tone-activated(int);
    callback tone-fav(int);
    callback essential-clicked(string);
    callback knob-changed(int, int);
    callback amp-family(int);
    callback amp-variation(bool);
    callback pedal-clicked(int);
    callback pedal-toggled(int);
    callback pedal-knob(int, int, int);
    callback pedal-drag-start(int);
    callback pedal-dropped(int, int);
    callback insp-close();
    callback insp-toggle(bool);
    callback insp-variant-picked(int);
    callback insp-type-picked(int);
    callback insp-type-request();
    callback insp-section-picked(int);
    callback insp-param(int, int);
    callback insp-enum-request(int);
    callback popup-picked(int);
    callback rename(string);
    callback toggle-fav();
    callback audition();
    callback save();
    callback save-copy();
    callback revert();
    callback delete-tone();
    callback export-tone();
    callback export-list();
    callback write-slot(int);
    callback connect();
    callback select-slot(int);
    callback pull-slot(int);
    callback backup-amp();
    callback import-path(string);
    callback import-windows();
    callback mode-picked(bool);
    callback audio-buffer-picked(int);
    callback audio-rate-picked(int);
    callback limiter-toggled(bool);
    callback ab-picked(int);
    callback di-toggled(bool);
    callback transport();
    callback dsp-voicing-picked(int);
    callback tag-picked(string);

    public function open-popup() { enum-popup.show(); }

    property <int> confirm-slot: -1;
    property <bool> show-import;
    property <bool> show-slot-picker;

    // pedalboard geometry: fixed pitch, the drop gap is pure arithmetic
    property <length> board-w: 1000px;
    property <length> inner: board-w - 2 * 64px;
    // stompboxes are fixed-size bitmaps: a narrow window scrolls the chain instead of squeezing it
    property <length> pw: 92px;
    property <length> ph: 176px;
    property <length> ps: clamp((inner - pedals.length * pw) / Math.max(1, pedals.length), 8px, 26px);
    property <length> pitch: pw + ps;
    property <length> left: (board-w - pedals.length * pitch) / 2;
    property <int> drag-from: -1;
    property <length> drag-x;
    property <int> gap: clamp(floor((drag-x - left + ps / 2) / pitch + 0.5), 0, pedals.length);

    VerticalLayout {
        // ================================================= top utility bar
        Rectangle {
            height: 52px;
            Rectangle { y: parent.height - 1px; height: 1px; background: T.line; }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 10px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 10px;
                // wordmark
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "HAZE";
                        color: T.text;
                        font-family: T.mono;
                        font-size: 15px;
                        font-weight: 800;
                        letter-spacing: 3px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "STUDIO";
                        color: T.text-3;
                        font-family: T.mono;
                        font-size: 9px;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }
                // dual-mode switch
                Well {
                    width: 2 * 150px + 8px;
                    HorizontalLayout {
                        padding: 3px;
                        spacing: 2px;
                        ModeSeg {
                            title: "HARDWARE";
                            sub: "KATANA USB-MIDI";
                            led: T.amber;
                            active: hw-mode;
                            clicked => { mode-picked(true); }
                        }
                        ModeSeg {
                            title: "STANDALONE";
                            sub: "PC DSP ENGINE";
                            led: T.cyan;
                            active: !hw-mode;
                            clicked => { mode-picked(false); }
                        }
                    }
                }
                // hardware: Katana link
                if hw-mode: Well {
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: connected ? 12px : 3px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Led { size: 7px; state: connected ? 1 : 0; }
                        }
                        Text {
                            text: "KATANA MKII";
                            color: connected ? T.text : T.text-2;
                            font-family: T.mono;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Text {
                            text: conn-text;
                            color: T.text-3;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        if !connected: VerticalLayout {
                            alignment: center;
                            Pick {
                                text: "POŁĄCZ";
                                active: true;
                                clicked => { connect(); }
                            }
                        }
                    }
                }
                // standalone: audio device + latency
                if !hw-mode: Well {
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 4px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Led { size: 7px; state: audio-running ? 1 : 0; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Pick {
                                text: di-on ? "DI ▶" : "DI";
                                active: di-on;
                                clicked => { di-toggled(!di-on); }
                            }
                        }
                        Text {
                            text: audio-host + " · " + audio-device;
                            color: T.text;
                            font-family: T.mono;
                            font-size: 10.5px;
                            vertical-alignment: center;
                            overflow: elide;
                            max-width: 140px;
                        }
                        Rectangle { width: 1px; background: T.line; }
                        HorizontalLayout {
                            alignment: center;
                            padding-top: 3px;
                            padding-bottom: 3px;
                            for b in [64, 128, 256]: Pick {
                                text: b;
                                active: b == audio-buffer;
                                clicked => { audio-buffer-picked(b); }
                            }
                        }
                        Rectangle { width: 1px; background: T.line; }
                        HorizontalLayout {
                            padding-top: 3px;
                            padding-bottom: 3px;
                            for r in [48000, 96000]: Pick {
                                text: (r / 1000) + "k";
                                active: r == audio-rate;
                                clicked => { audio-rate-picked(r); }
                            }
                        }
                        Rectangle { width: 1px; background: T.line; }
                        // engine estimate when running (buffers + ring + IR partition), else 2 buffers;
                        // converter latency of the interface comes on top
                        Text {
                            text: "RT " + round((audio-running ? audio-latency : 2000 * audio-buffer / audio-rate) * 10) / 10 + " ms";
                            color: T.accent;
                            font-family: T.mono;
                            font-size: 10.5px;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if busy-text != "": Text {
                    text: busy-text;
                    color: T.text-2;
                    vertical-alignment: center;
                    font-size: 11px;
                }
                if busy-text != "" && busy-progress >= 0: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 90px;
                        height: 2px;
                        background: T.line;
                        Rectangle {
                            x: 0;
                            width: parent.width * root.busy-progress;
                            background: T.accent;
                        }
                    }
                }
                // chromatic tuner strip
                Well {
                    width: 128px;
                    opacity: tuner-active ? 1 : 0.55;
                    Text {
                        x: 8px;
                        width: 30px;
                        text: tuner-note;
                        color: tuner-active && abs(tuner-cents) < 3 ? T.led-green : T.text;
                        font-family: T.mono;
                        font-weight: 700;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        x: 42px;
                        y: (parent.height - 14px) / 2;
                        width: parent.width - 52px;
                        height: 14px;
                        for i in 9: Rectangle {
                            x: i * (parent.width - 2px) / 8;
                            y: i == 4 ? 0 : 4px;
                            width: 2px;
                            height: i == 4 ? 14px : 6px;
                            background: i == 4 ? T.line-hi : T.line;
                        }
                        if tuner-active: Rectangle {
                            x: (parent.width - 4px) * (clamp(tuner-cents, -50, 50) + 50) / 100;
                            width: 4px;
                            border-radius: 1px;
                            background: abs(tuner-cents) < 3 ? T.led-green : T.accent;
                        }
                    }
                }
                Meter { label: "IN"; level: in-level; clipped: in-clip; }
                Meter { label: "OUT"; level: out-level; clipped: out-clip; }
                // master limiter (PC engine only)
                Well {
                    width: 46px;
                    background: limiter && !hw-mode ? T.accent.with-alpha(0.14) : lta.has-hover && !hw-mode ? T.hover : T.well;
                    border-color: limiter && !hw-mode ? T.accent-lo : T.line;
                    opacity: hw-mode ? 0.4 : 1;
                    Text {
                        text: "LIM";
                        color: limiter && !hw-mode ? T.accent-hi : T.text-2;
                        font-family: T.mono;
                        font-weight: 700;
                        font-size: 10.5px;
                        letter-spacing: 1px;
                    }
                    lta := TouchArea {
                        enabled: !hw-mode;
                        mouse-cursor: pointer;
                        clicked => { limiter-toggled(!limiter); }
                    }
                }
                // A/B snapshot compare
                Well {
                    width: 62px;
                    HorizontalLayout {
                        padding: 3px;
                        spacing: 2px;
                        Pick {
                            text: "A";
                            width: 26px;
                            active: ab-slot == 0;
                            enabled: has-selection;
                            clicked => { ab-picked(0); }
                        }
                        Pick {
                            text: ab-has-b ? "B" : "+B";
                            width: 26px;
                            active: ab-slot == 1;
                            enabled: has-selection;
                            clicked => { ab-picked(1); }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    app-menu-btn := IconBtn {
                        icon: Icons.menu;
                        clicked => { app-menu.show(); }
                    }
                }
            }
            app-menu := PopupWindow {
                x: parent.width - 250px;
                y: 46px;
                width: 236px;
                height: 3 * 36px + 12px;
                Menu {
                    VerticalLayout {
                        padding: 6px;
                        MenuItem {
                            text: "Importuj brzmienia…";
                            clicked => { show-import = true; app-menu.close(); }
                        }
                        MenuItem {
                            text: "Kopia wszystkich kanałów";
                            enabled: connected;
                            clicked => { backup-amp(); app-menu.close(); }
                        }
                        MenuItem {
                            text: "Eksportuj kolekcję (.tsl)";
                            clicked => { export-list(); app-menu.close(); }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            padding-top: 8px;
            padding-right: 8px;
            padding-bottom: 8px;
            spacing: 8px;
            // ============================================= library rail placeholder (sidebar overlays the stage)
            Rectangle {
                width: side.pinned ? SidebarMetrics.open : SidebarMetrics.rail;
            }

            VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;
            // ============================================= stage
            stage := Rectangle {
                // content height of the upper deck: tone header, chain, compact amp core
                property <length> deck-h: 488px;
                vertical-stretch: insp-open ? 0 : 1;
                min-height: deck-h;
                max-height: insp-open ? deck-h : 100000px;
                border-radius: 6px;
                background: T.bg;
                border-width: 1px;
                border-color: T.line;
                clip: true;

                if !has-selection: Text {
                    text: "Wybierz brzmienie z biblioteki";
                    color: T.text-3;
                    font-family: T.mono;
                    font-size: 13px;
                    letter-spacing: 1px;
                }
                if has-selection: VerticalLayout {
                    padding-left: 22px;
                    padding-right: 22px;
                    padding-top: 14px;
                    padding-bottom: 16px;
                    spacing: 0px;

                    // ---------- tone header
                    HorizontalLayout {
                        height: 64px;
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 10px;
                                TextInput {
                                    text: ed-name;
                                    color: T.text;
                                    font-family: T.display;
                                    font-size: 26px;
                                    font-weight: 700;
                                    single-line: true;
                                    accepted => {
                                        rename(self.text);
                                        self.clear-focus();
                                    }
                                }
                                Rectangle {
                                    width: 24px;
                                    Icon {
                                        d: Icons.star;
                                        size: 18px;
                                        filled: ed-fav;
                                        tint: ed-fav ? T.accent : T.text-3;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { toggle-fav(); }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 14px;
                                Text {
                                    text: ed-amp-name;
                                    color: T.text-2;
                                    font-family: T.mono;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "FX " + ed-fx-on + "/" + ed-fx-all;
                                    color: T.text-3;
                                    font-family: T.mono;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: ed-origin;
                                    color: T.text-3;
                                    font-size: 11px;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if ed-dirty: VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 6px;
                                Btn {
                                    compact: true;
                                    text: "Cofnij";
                                    clicked => { revert(); }
                                }
                                Btn {
                                    compact: true;
                                    text: "Zapisz";
                                    clicked => { save(); }
                                }
                            }
                        }
                        if connected && hw-mode: VerticalLayout {
                            alignment: center;
                            Btn {
                                primary: true;
                                compact: true;
                                text: ed-live ? "Gra na wzmacniaczu" : "Zagraj na wzmacniaczu";
                                clicked => { audition(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            more-btn := IconBtn {
                                icon: Icons.more;
                                filled: true;
                                clicked => { more-menu.show(); }
                            }
                        }
                        more-menu := PopupWindow {
                            x: parent.width - 236px;
                            y: 54px;
                            width: 236px;
                            height: 5 * 36px + 12px;
                            Menu {
                                VerticalLayout {
                                    padding: 6px;
                                    MenuItem {
                                        text: "Zapisz do kanału wzmacniacza…";
                                        enabled: connected;
                                        clicked => { show-slot-picker = true; more-menu.close(); }
                                    }
                                    MenuItem {
                                        text: "Duplikuj";
                                        clicked => { save-copy(); more-menu.close(); }
                                    }
                                    MenuItem {
                                        text: "Eksportuj .tsl";
                                        clicked => { export-tone(); more-menu.close(); }
                                    }
                                    MenuItem {
                                        text: "Cofnij zmiany";
                                        enabled: ed-dirty;
                                        clicked => { revert(); more-menu.close(); }
                                    }
                                    MenuItem {
                                        text: "Usuń (do kosza)";
                                        danger: true;
                                        clicked => { delete-tone(); more-menu.close(); }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { height: 12px; }

                    // ---------- signal chain caption
                    HorizontalLayout {
                        height: 22px;
                        spacing: 10px;
                        Text {
                            text: "SIGNAL CHAIN";
                            color: T.text-2;
                            font-family: T.mono;
                            font-weight: 700;
                            font-size: 10.5px;
                            letter-spacing: 1.5px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: ed-chain-name;
                            color: T.text-3;
                            font-family: T.mono;
                            font-size: 10.5px;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            font-size: 11px;
                            text: drag-from >= 0 ? (drop-ok[gap] ? "puść, aby przestawić" : "tej kolejności Katana nie obsługuje") : "przeciągnij blok, aby zmienić kolejność";
                            color: drag-from < 0 ? T.text-3 : drop-ok[gap] ? T.led-green : T.led-red;
                        }
                    }
                    Rectangle { height: 6px; }

                    // ---------- signal chain
                    deck := Rectangle {
                        height: ph + 32px;
                        border-radius: 6px;
                        background: T.well;
                        border-width: 1px;
                        border-color: T.line;
                        clip: true;
                        Flickable {
                        content-width: Math.max(self.width, 128px + pedals.length * (pw + 10px));
                        interactive: drag-from < 0;
                    board := Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.content-width;
                        height: parent.height;
                        init => { root.board-w = self.width; }
                        changed width => { root.board-w = self.width; }
                        property <length> py: (self.height - ph) / 2 + 4px;
                        // cables run at the pedals' jack height
                        property <length> wy: py + 33px;
                        ChainNode {
                            x: 12px;
                            y: board.wy - 19px;
                            text: "IN";
                            hot: ed-live;
                        }
                        ChainNode {
                            x: board.width - 52px;
                            y: board.wy - 19px;
                            text: "OUT";
                            hot: ed-live;
                        }
                        if pedals.length > 0: Wire {
                            x: 52px;
                            y: board.wy;
                            width: left + ps / 2 - 52px;
                            hot: ed-live;
                        }
                        if pedals.length > 0: Wire {
                            x: left + ps / 2 + (pedals.length - 1) * pitch + pw;
                            y: board.wy;
                            width: board.width - 52px - self.x;
                            hot: ed-live;
                        }
                        for c[i] in Math.max(0, pedals.length - 1): Wire {
                            x: left + ps / 2 + i * pitch + pw;
                            y: board.wy;
                            width: ps;
                            hot: ed-live;
                        }
                        for p[i] in pedals: PedalView {
                            x: left + ps / 2 + i * pitch;
                            y: board.py;
                            width: pw;
                            p: p;
                            selected: i == pedal-selected && insp-open;
                            ghost: i == drag-from;
                            clicked => { pedal-clicked(i); }
                            toggled => { pedal-toggled(i); }
                            knob(k, v) => { pedal-knob(i, k, v); }
                            drag-start => {
                                drag-from = i;
                                drag-x = self.x + pw / 2;
                                pedal-drag-start(i);
                            }
                            drag-move(mx) => { drag-x = self.x + mx; }
                            dropped => {
                                pedal-dropped(drag-from, gap);
                                drag-from = -1;
                            }
                        }
                        if drag-from >= 0: Rectangle {
                            for ok[g] in drop-ok: Rectangle {
                                x: left + g * pitch - 1px;
                                y: board.py - 4px;
                                width: 2px;
                                height: ph + 8px;
                                background: ok ? (g == gap ? T.led-green : T.led-green.with-alpha(0.25)) : (g == gap ? T.led-red : transparent);
                            }
                        }
                        if drag-from >= 0: PedalView {
                            x: drag-x - pw / 2;
                            y: board.py;
                            width: pw;
                            p: pedals[drag-from];
                            lifted: true;
                        }
                    }
                        }
                    }

                    Rectangle { height: 12px; }

                    // ---------- amp core
                    AmpCore {
                        knobs: knobs;
                        dsp-voicing: dsp-voicing;
                        dsp-voicing-picked(v) => { dsp-voicing-picked(v); }
                        family: ed-amp-family;
                        variation: ed-amp-var;
                        amp-name: ed-amp-name;
                        live: ed-live;
                        connected: connected;
                        compact: insp-open;
                        knob-changed(i, v) => { knob-changed(i, v); }
                        family-picked(f) => { amp-family(f); }
                        variation-toggled(v) => { amp-variation(v); }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            // ---------- effect editor: docked under the stage, nothing gets covered
            dock := Rectangle {
                vertical-stretch: insp-open ? 1 : 0;
                min-height: insp-open ? 316px : 0px;
                max-height: insp-open ? 100000px : 0px;
                clip: true;
                Inspector {
                    x: 0;
                    y: 8px;
                    width: parent.width;
                    height: parent.height - 8px;
                    title: insp-title;
                    subtitle: insp-subtitle;
                    hue: insp-hue;
                    ink: insp-ink;
                    has-sw: insp-has-sw;
                    on: insp-on;
                    variant: insp-variant;
                    has-types: insp-types.length > 0;
                    sections: insp-sections;
                    section: insp-section;
                    params: insp-params;
                    params-h: insp-params-h;
                    close => { insp-close(); }
                    toggle(v) => { insp-toggle(v); }
                    variant-picked(i) => { insp-variant-picked(i); }
                    type-request => { insp-type-request(); }
                    section-picked(i) => { insp-section-picked(i); }
                    param(i, v) => { insp-param(i, v); }
                    enum-request(i) => { insp-enum-request(i); }
                }
            }

            // ---------- amp channels, under the stage (only when an amp is there)
            if connected: HorizontalLayout {
                height: 48px;
                padding-top: 8px;
                spacing: 4px;
                for sl[i] in slots: SlotChip {
                    horizontal-stretch: 1;
                    slot: sl;
                    clicked => { select-slot(i); }
                    pull => { pull-slot(i); }
                    push => { if has-selection { confirm-slot = i; } }
                }
            }
            }
        }

    }

    // Spacebar: DI player transport (standalone). Text fields keep their own spaces.
    keys := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == " " {
                transport();
                return accept;
            }
            reject
        }
    }

    // ================================================= library sidebar (over the stage, under dialogs)
    side := LibrarySidebar {
        x: 0;
        y: 53px;
        height: root.height - 53px;
        nav: nav;
        nav-selected: nav-selected;
        nav-title: nav-title;
        tones: tones;
        selected-index: selected-index;
        essentials: essentials;
        connected: connected;
        tag: tag;
        tag-picked(t) => { tag-picked(t); }
        pinned <=> root.sidebar-pinned;
        search(q) => { search(q); }
        nav-clicked(id) => { nav-clicked(id); }
        tone-clicked(i) => { tone-clicked(i); }
        tone-activated(i) => { tone-activated(i); }
        tone-fav(i) => { tone-fav(i); }
        essential-clicked(id) => { essential-clicked(id); }
    }

    // ================================================= overlays
    enum-popup := PopupWindow {
        x: root.width - 410px;
        y: 200px;
        width: 360px;
        height: Math.min(root.height - 260px, 50px + popup-options.length * 32px);
        Menu {
            VerticalLayout {
                padding: 8px;
                spacing: 4px;
                Label {
                    text: popup-title;
                    color: T.accent;
                    height: 24px;
                }
                ListView {
                    for o in popup-options: Rectangle {
                        height: 32px;
                        border-radius: 6px;
                        background: ota.has-hover ? T.hover : transparent;
                        Text {
                            x: 10px;
                            text: o.label;
                            color: T.text;
                            vertical-alignment: center;
                        }
                        ota := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                popup-picked(o.value);
                                enum-popup.close();
                            }
                        }
                    }
                }
            }
        }
    }

    if show-slot-picker: Rectangle {
        background: #000000b0;
        TouchArea {
            clicked => { show-slot-picker = false; }
        }
        Menu {
            width: 572px;
            height: 236px;
            TouchArea { }
            Text {
                x: 24px;
                y: 22px;
                text: "Zapisz „" + ed-name + "” do kanału";
                font-family: T.display;
                font-size: 22px;
                font-weight: 700;
                color: T.text;
            }
            for sl[i] in slots: Rectangle {
                visible: i > 0;
                x: 24px + mod(i - 1, 4) * 132px;
                y: 72px + floor((i - 1) / 4) * 66px;
                width: 124px;
                height: 56px;
                border-radius: 8px;
                background: pta.has-hover ? T.hover : #ffffff08;
                border-width: 1px;
                border-color: pta.has-hover ? T.accent : transparent;
                VerticalLayout {
                    padding: 9px;
                    padding-left: 12px;
                    Text { text: sl.label; color: T.accent; font-family: T.display; font-weight: 700; font-size: 11px; }
                    Text { text: sl.name; color: T.text-2; font-size: 12px; overflow: elide; }
                }
                pta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        show-slot-picker = false;
                        confirm-slot = i;
                    }
                }
            }
        }
    }

    if confirm-slot >= 0: Rectangle {
        background: #000000b0;
        TouchArea {
            clicked => { confirm-slot = -1; }
        }
        Menu {
            width: 480px;
            height: 210px;
            TouchArea { }
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: "Nadpisać kanał " + slots[confirm-slot].label + "?";
                    font-family: T.display;
                    font-size: 24px;
                    font-weight: 700;
                    color: T.text;
                }
                Text {
                    text: "„" + slots[confirm-slot].name + "” zostanie zastąpione przez „" + ed-name + "”. Obecna zawartość kanału trafi najpierw do biblioteki (Kopie wzmacniacza).";
                    wrap: word-wrap;
                    color: T.text-2;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Btn {
                        text: "Anuluj";
                        clicked => { confirm-slot = -1; }
                    }
                    Btn {
                        primary: true;
                        text: "Zapisz do " + slots[confirm-slot].label;
                        clicked => {
                            write-slot(confirm-slot);
                            confirm-slot = -1;
                        }
                    }
                }
            }
        }
    }

    if show-import: Rectangle {
        background: #000000b0;
        TouchArea {
            clicked => { show-import = false; }
        }
        Menu {
            width: 620px;
            height: 290px;
            TouchArea { }
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: "Import brzmień";
                    font-family: T.display;
                    font-size: 24px;
                    font-weight: 700;
                    color: T.text;
                }
                Text {
                    text: import-hint;
                    wrap: word-wrap;
                    color: T.text-2;
                }
                Btn {
                    primary: true;
                    text: "Importuj z BOSS Tone Studio (Windows)";
                    clicked => {
                        import-windows();
                        show-import = false;
                    }
                }
                Label { text: "albo plik lub folder .tsl"; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        border-radius: T.r;
                        background: T.bg;
                        border-width: 1px;
                        border-color: path-in.has-focus ? T.accent-lo : T.line;
                        path-in := TextInput {
                            x: 10px;
                            width: parent.width - 20px;
                            color: T.text;
                            single-line: true;
                            vertical-alignment: center;
                            accepted => {
                                import-path(self.text);
                                show-import = false;
                            }
                        }
                    }
                    Btn {
                        text: "Importuj";
                        clicked => {
                            import-path(path-in.text);
                            show-import = false;
                        }
                    }
                }
            }
        }
    }

    if toast != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - (connected ? 76px : 22px);
        width: tt.preferred-width + 40px;
        height: 40px;
        border-radius: 20px;
        background: toast-error ? #3a1712 : #1f1c17;
        border-width: 1px;
        border-color: toast-error ? T.danger : #ffffff18;
        drop-shadow-blur: 20px;
        drop-shadow-color: #000000a0;
        tt := Text {
            text: toast;
            color: T.text;
        }
    }
}
