import { T } from "theme.slint";

/// Stroke icon paths on a 24×24 grid (drawn, not font glyphs).
export global Icons {
    out property <string> menu: "M4 7 L20 7 M4 12 L20 12 M4 17 L20 17";
    out property <string> close: "M6.5 6.5 L17.5 17.5 M17.5 6.5 L6.5 17.5";
    out property <string> search: "M10.5 4.5 A6 6 0 1 0 10.5 16.5 A6 6 0 1 0 10.5 4.5 Z M15 15 L19.5 19.5";
    out property <string> star: "M12 3.8 L14.5 9 L20.2 9.7 L16 13.6 L17.1 19.3 L12 16.5 L6.9 19.3 L8 13.6 L3.8 9.7 L9.5 9 Z";
    out property <string> library: "M5 4.5 L5 19.5 M9.5 4.5 L9.5 19.5 M14 5.2 L18.6 19";
    out property <string> setlist: "M9 7 L20 7 M9 12 L20 12 M9 17 L16 17 M4 6.2 L5.6 7.8 M4 11.2 L5.6 12.8 M4 16.2 L5.6 17.8";
    out property <string> backup: "M4.5 12 A7.5 7.5 0 1 0 7 6.4 M4 3.5 L4 8 L8.5 8";
    out property <string> panel: "M4 5 L20 5 L20 19 L4 19 Z M9.5 5 L9.5 19";
    out property <string> chevron-down: "M7 10 L12 15 L17 10";
    out property <string> chevron-up: "M7 14 L12 9 L17 14";
    out property <string> more: "M7 12 A1.6 1.6 0 1 1 3.8 12 A1.6 1.6 0 1 1 7 12 Z M13.6 12 A1.6 1.6 0 1 1 10.4 12 A1.6 1.6 0 1 1 13.6 12 Z M20.2 12 A1.6 1.6 0 1 1 17 12 A1.6 1.6 0 1 1 20.2 12 Z";
    out property <string> pull: "M12 4 L12 15 M7.5 10.5 L12 15 L16.5 10.5 M5 19.5 L19 19.5";
    out property <string> push: "M12 15.5 L12 4.5 M7.5 9 L12 4.5 L16.5 9 M5 19.5 L19 19.5";
}

/// Path icon. `d` is one of `Icons.*`; `filled` fills the shape instead of stroking it.
export component Icon inherits Path {
    in property <string> d;
    in property <color> tint: T.text-2;
    in property <bool> filled;
    in property <length> size: 18px;
    width: size;
    height: size;
    commands: d;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: tint;
    stroke-width: 1.6px;
    fill: filled ? tint : transparent;
}

export component Label inherits Text {
    color: T.text-2;
    font-size: 12px;
    font-weight: 600;
}

export component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    callback clicked;
    height: compact ? 28px : 36px;
    min-width: lbl.preferred-width + (compact ? 20px : 32px);
    border-radius: T.r;
    background: !enabled ? transparent
        : primary ? (ta.pressed ? T.accent-lo : ta.has-hover ? T.accent-hi : T.accent)
        : (ta.pressed ? T.line : ta.has-hover ? T.hover : T.panel-hi);
    border-width: primary ? 0 : 1px;
    border-color: !enabled ? T.line : danger && ta.has-hover ? T.danger : T.line-hi;
    animate background { duration: 90ms; }
    lbl := Text {
        text: root.text;
        font-weight: 600;
        font-size: compact ? 12px : 13px;
        color: !enabled ? T.text-3 : primary ? T.accent-ink : danger && ta.has-hover ? T.danger : T.text;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component Led inherits Rectangle {
    in property <int> state;
    in property <length> size: 8px;
    width: size;
    height: size;
    border-radius: size / 2;
    background: T.led(state);
    // halo when lit
    Rectangle {
        visible: root.state != 0;
        width: root.size * 2.2;
        height: root.size * 2.2;
        border-radius: self.width / 2;
        background: T.led(root.state).with-alpha(0.16);
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> on;
    in property <int> led: 1;
    callback toggled(bool);
    width: 38px;
    height: 20px;
    border-radius: 10px;
    background: on ? T.led(led).with-alpha(0.25) : T.bg;
    border-width: 1px;
    border-color: on ? T.led(led) : T.line-hi;
    animate background, border-color { duration: 120ms; }
    knob := Rectangle {
        width: 14px;
        height: 14px;
        y: 3px;
        x: root.on ? root.width - 17px : 3px;
        border-radius: 7px;
        background: root.on ? T.led(root.led) : T.text-3;
        animate x { duration: 120ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.on = !root.on; root.toggled(root.on); }
    }
}

/// Precision rotary encoder: LED dot ring, drag (Shift = fine x4), wheel, double-click reset.
export component Knob inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <int> min: 0;
    in property <int> max: 100;
    in property <int> reset: 50;
    in property <string> display: value;
    in property <length> dial: 62px;
    in property <bool> enabled: true;
    callback changed(int);

    property <float> t: (value - min) / Math.max(1, max - min);
    property <int> drag-start-value;
    property <length> drag-start-y;
    property <bool> fine;
    property <length> cx: dial / 2;
    property <length> ring: dial / 2 - 3px;
    property <int> dots: 25;

    min-width: dial + 20px;
    height: dial + 40px;
    opacity: enabled ? 1 : 0.4;

    VerticalLayout {
        spacing: 6px;
        alignment: start;
        HorizontalLayout {
        alignment: center;
        Rectangle {
            width: root.dial;
            height: root.dial;

            for i in root.dots: Rectangle {
                property <angle> a: (135 + i * 270 / (root.dots - 1)) * 1deg;
                property <bool> lit: i / (root.dots - 1) <= root.t + 0.001 && !(root.t <= 0.001 && i == 0 && root.min < 0);
                width: lit ? 4px : 3px;
                height: self.width;
                border-radius: self.width / 2;
                x: root.cx + root.ring * cos(a) - self.width / 2;
                y: root.cx + root.ring * sin(a) - self.width / 2;
                background: lit ? T.accent : #2A2D35;
            }
            // machined cap
            cap := Rectangle {
                width: root.dial - 18px;
                height: self.width;
                x: 9px;
                y: 9px;
                border-radius: self.width / 2;
                background: ta.pressed ? #1A1C22 : #20232A;
                border-width: 1px;
                border-color: ta.has-hover || ta.pressed ? T.accent-lo : T.line-hi;
                // indicator line
                Rectangle {
                    property <angle> a: (135 + root.t * 270) * 1deg;
                    property <length> pr: cap.width / 2 - 7px;
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    x: cap.width / 2 + self.pr * cos(a) - 2px;
                    y: cap.width / 2 + self.pr * sin(a) - 2px;
                    background: ta.pressed ? T.accent-hi : T.text;
                }
            }
            ta := TouchArea {
                enabled: root.enabled;
                mouse-cursor: ns-resize;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        root.drag-start-value = root.value;
                        root.drag-start-y = self.mouse-y;
                        root.fine = e.modifiers.shift;
                    }
                }
                moved => {
                    if self.pressed {
                        root.changed(clamp(round(root.drag-start-value + (root.drag-start-y - self.mouse-y) / (root.fine ? 640px : 160px) * (root.max - root.min)), root.min, root.max));
                    }
                }
                double-clicked => { root.changed(root.reset); }
                scroll-event(e) => {
                    root.changed(clamp(root.value + (e.delta-y > 0 ? 1 : -1) * (e.modifiers.shift ? 1 : Math.max(1, round((root.max - root.min) / 100))), root.min, root.max));
                    accept
                }
            }
        }
        }
        Text {
            text: root.display;
            horizontal-alignment: center;
            color: ta.pressed ? T.accent-hi : T.text;
            font-family: T.mono;
            font-size: 13px;
            font-weight: 600;
        }
        Text {
            text: root.label;
            horizontal-alignment: center;
            color: T.text-2;
            font-family: T.mono;
            font-size: 9.5px;
            font-weight: 600;
            letter-spacing: 1.2px;
        }
    }
}

export component Seg inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 30px;
    border-radius: 4px;
    background: active ? T.accent : ta.has-hover ? T.hover : transparent;
    animate background { duration: 100ms; }
    Text {
        text: root.text;
        font-family: T.mono;
        font-weight: 600;
        font-size: 11px;
        letter-spacing: 0.8px;
        color: root.active ? T.accent-ink : T.text-2;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text;
    out property <bool> focused: input.has-focus;
    callback edited(string);
    public function focus-input() { input.focus(); }
    height: 34px;
    border-radius: T.r;
    background: T.bg;
    border-width: 1px;
    border-color: input.has-focus ? T.accent-lo : T.line;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon { d: Icons.search; tint: T.text-3; size: 16px; }
        }
        input := TextInput {
            text <=> root.text;
            color: T.text;
            font-size: 13px;
            vertical-alignment: center;
            single-line: true;
            edited => { root.edited(self.text); }
        }
    }
    Text {
        x: 32px;
        width: root.width - 40px;
        overflow: elide;
        visible: root.text == "" && !input.has-focus;
        text: "Szukaj brzmień";
        color: T.text-3;
        font-size: 13px;
        vertical-alignment: center;
    }
}
