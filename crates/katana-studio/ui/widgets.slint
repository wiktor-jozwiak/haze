import { T } from "theme.slint";

/// Stroke icon paths on a 24×24 grid (drawn, not font glyphs).
export global Icons {
    out property <string> menu: "M4 7 L20 7 M4 12 L20 12 M4 17 L20 17";
    out property <string> close: "M6.5 6.5 L17.5 17.5 M17.5 6.5 L6.5 17.5";
    out property <string> search: "M10.5 4.5 A6 6 0 1 0 10.5 16.5 A6 6 0 1 0 10.5 4.5 Z M15 15 L19.5 19.5";
    out property <string> star: "M12 3.8 L14.5 9 L20.2 9.7 L16 13.6 L17.1 19.3 L12 16.5 L6.9 19.3 L8 13.6 L3.8 9.7 L9.5 9 Z";
    out property <string> library: "M5 4.5 L5 19.5 M9.5 4.5 L9.5 19.5 M14 5.2 L18.6 19";
    out property <string> setlist: "M9 7 L20 7 M9 12 L20 12 M9 17 L16 17 M4 6.2 L5.6 7.8 M4 11.2 L5.6 12.8 M4 16.2 L5.6 17.8";
    out property <string> backup: "M4.5 12 A7.5 7.5 0 1 0 7 6.4 M4 3.5 L4 8 L8.5 8";
    out property <string> panel: "M4 5 L20 5 L20 19 L4 19 Z M9.5 5 L9.5 19";
    out property <string> chevron-down: "M7 10 L12 15 L17 10";
    out property <string> chevron-up: "M7 14 L12 9 L17 14";
    out property <string> chevron-left: "M14.5 6.5 L9 12 L14.5 17.5";
    out property <string> chevron-right: "M9.5 6.5 L15 12 L9.5 17.5";
    out property <string> help: "M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M9.6 9.4 A2.5 2.5 0 1 1 12.9 11.8 C12.3 12.2 12 12.7 12 13.6 M12 16.6 L12 17.2";
    out property <string> plus: "M12 5 L12 19 M5 12 L19 12";
    out property <string> undo: "M9 6.5 L4.5 11 L9 15.5 M4.5 11 L14.5 11 A5 5 0 0 1 14.5 21 L11 21";
    out property <string> redo: "M15 6.5 L19.5 11 L15 15.5 M19.5 11 L9.5 11 A5 5 0 0 0 9.5 21 L13 21";
    out property <string> export: "M12 14 L12 4 M8 8 L12 4 L16 8 M5 15 L5 19.5 L19 19.5 L19 15";
    out property <string> more: "M7 12 A1.6 1.6 0 1 1 3.8 12 A1.6 1.6 0 1 1 7 12 Z M13.6 12 A1.6 1.6 0 1 1 10.4 12 A1.6 1.6 0 1 1 13.6 12 Z M20.2 12 A1.6 1.6 0 1 1 17 12 A1.6 1.6 0 1 1 20.2 12 Z";
    out property <string> pull: "M12 4 L12 15 M7.5 10.5 L12 15 L16.5 10.5 M5 19.5 L19 19.5";
    out property <string> push: "M12 15.5 L12 4.5 M7.5 9 L12 4.5 L16.5 9 M5 19.5 L19 19.5";
    out property <string> gear: "M12 9 A3 3 0 1 0 12 15 A3 3 0 1 0 12 9 Z M12 3 L12 5.5 M12 18.5 L12 21 M3 12 L5.5 12 M18.5 12 L21 12 M5.6 5.6 L7.4 7.4 M16.6 16.6 L18.4 18.4 M5.6 18.4 L7.4 16.6 M16.6 7.4 L18.4 5.6";
    out property <string> power: "M12 4 L12 11.5 M7.6 7.2 A6.6 6.6 0 1 0 16.4 7.2";
    out property <string> import: "M12 4 L12 14 M8 10 L12 14 L16 10 M5 15 L5 19.5 L19 19.5 L19 15";
}

/// Block emblems (24×24 stroke paths), indexed like `Panel.nodes`: Gate, Pedal FX, Booster,
/// Mod, EQ, Amp, FX Loop, FX, Delay, Delay 2, Reverb.
export global Glyphs {
    public pure function path(kind: int) -> string {
        if kind == 0 { return "M2.5 17 L7 17 L7 7 L17 7 L17 17 L21.5 17"; }
        if kind == 1 { return "M3 19 L21 19 M4.5 19 L18.5 8.5 L21 19 M15 11 L16.5 13"; }
        if kind == 2 { return "M13.5 2.5 L5.5 13.5 L11 13.5 L10 21.5 L18.5 10 L13 10 Z"; }
        if kind == 3 { return "M2 12 C4.5 4.5 7.5 4.5 10 12 C12.5 19.5 15.5 19.5 18 12 C19.2 8.4 20.6 6.8 22 6.6"; }
        if kind == 4 { return "M6 3.5 L6 20.5 M12 3.5 L12 20.5 M18 3.5 L18 20.5 M3.5 15 L8.5 15 M9.5 8 L14.5 8 M15.5 12.5 L20.5 12.5"; }
        if kind == 5 { return "M12 5 A7 7 0 1 0 12 19 A7 7 0 1 0 12 5 Z M12 9.5 A2.5 2.5 0 1 0 12 14.5 A2.5 2.5 0 1 0 12 9.5 Z"; }
        if kind == 6 { return "M8 7 L17 7 A5 5 0 0 1 17 17 L7 17 A5 5 0 0 1 4.6 7.6 M8 4 L8 10 L3.5 7"; }
        if kind == 7 { return "M12 2.5 L13.9 10.1 L21.5 12 L13.9 13.9 L12 21.5 L10.1 13.9 L2.5 12 L10.1 10.1 Z M19 3.5 L19 6.5 M17.5 5 L20.5 5"; }
        if kind == 8 || kind == 9 { return "M3 5 L3 19 M8.5 7 L8.5 17 M13.5 9 L13.5 15 M18 10.5 L18 13.5 M21.5 11.5 L21.5 12.5"; }
        return "M3 19 A9 9 0 0 1 21 19 M6.5 19 A5.5 5.5 0 0 1 17.5 19 M10 19 A2 2 0 0 1 14 19";
    }
}

/// Hover tooltip chip (place it next to the control; Slint has no native tooltips).
export component Tip inherits Rectangle {
    in property <string> text;
    width: tt.preferred-width + 16px;
    height: 24px;
    border-radius: 4px;
    background: #0D0E11F2;
    border-width: 1px;
    border-color: #ffffff22;
    tt := Text {
        text: root.text;
        color: #E8EAF0;
        font-size: 11.5px;
        font-weight: 600;
    }
}

/// Path icon. `d` is one of `Icons.*`; `filled` fills the shape instead of stroking it.
export component Icon inherits Path {
    in property <string> d;
    in property <color> tint: T.text-2;
    in property <bool> filled;
    in property <length> size: 18px;
    width: size;
    height: size;
    commands: d;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: tint;
    stroke-width: 1.6px;
    fill: filled ? tint : transparent;
}

export component Label inherits Text {
    color: T.text-2;
    font-size: 12px;
    font-weight: 600;
}

export component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    callback clicked;
    height: compact ? 30px : 36px;
    min-width: lbl.preferred-width + (compact ? 24px : 34px);
    // rubber keys; the primary one is the lit amber key
    border-radius: 6px;
    background: !enabled ? transparent
        : primary ? (ta.pressed ? @linear-gradient(180deg, T.accent.darker(0.25) 0%, T.accent 100%)
            : ta.has-hover ? @linear-gradient(180deg, T.accent-hi.brighter(0.1) 0%, T.accent 100%)
            : @linear-gradient(180deg, T.accent-hi 0%, T.accent.darker(0.1) 100%))
        : (ta.pressed ? @linear-gradient(180deg, #141312 0%, #22201E 100%)
            : ta.has-hover ? @linear-gradient(180deg, #3A3734 0%, #201E1C 100%)
            : @linear-gradient(180deg, #33302D 0%, #1C1A19 100%));
    border-width: 1px;
    border-color: !enabled ? T.line : danger && ta.has-hover ? T.danger : #000000c0;
    drop-shadow-blur: enabled && !ta.pressed ? 3px : 0;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: #00000080;
    if enabled && !ta.pressed: Rectangle { x: 5px; y: 1px; width: parent.width - 10px; height: 1px; background: root.primary ? #ffffff60 : #ffffff1c; }
    lbl := Text {
        text: root.text;
        font-family: T.display;
        font-weight: 700;
        font-size: compact ? 13px : 14px;
        letter-spacing: 0.4px;
        color: !enabled ? T.text-3 : primary ? T.accent-ink : danger && ta.has-hover ? T.danger : T.silk;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component Led inherits Rectangle {
    in property <int> state;
    in property <length> size: 8px;
    width: size;
    height: size;
    border-radius: size / 2;
    background: T.led(state);
    // halo when lit
    Rectangle {
        visible: root.state != 0;
        width: root.size * 2.2;
        height: root.size * 2.2;
        border-radius: self.width / 2;
        background: T.led(root.state).with-alpha(0.16);
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> on;
    in property <int> led: 1;
    callback toggled(bool);
    width: 38px;
    height: 20px;
    border-radius: self.height / 2;
    background: on ? T.led(led).with-alpha(0.25) : T.bg;
    border-width: 1px;
    border-color: on ? T.led(led) : T.line-hi;
    animate background, border-color { duration: 120ms; }
    knob := Rectangle {
        width: root.height - 6px;
        height: self.width;
        y: 3px;
        x: root.on ? root.width - self.width - 3px : 3px;
        border-radius: self.width / 2;
        background: root.on ? T.led(root.led) : T.text-3;
        animate x { duration: 120ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.on = !root.on; root.toggled(root.on); }
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text;
    out property <bool> focused: input.has-focus;
    callback edited(string);
    public function focus-input() { input.focus(); }
    height: 34px;
    border-radius: 6px;
    background: @linear-gradient(180deg, #070707 0%, #121110 100%);
    border-width: 1px;
    border-color: input.has-focus ? T.accent-lo : #000000a0;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon { d: Icons.search; tint: T.text-3; size: 16px; }
        }
        input := TextInput {
            text <=> root.text;
            color: T.text;
            font-size: 13px;
            vertical-alignment: center;
            single-line: true;
            edited => { root.edited(self.text); }
        }
    }
    Text {
        x: 32px;
        width: root.width - 40px;
        overflow: elide;
        visible: root.text == "" && !input.has-focus;
        text: "Search presets…";
        color: T.text-3;
        font-size: 13px;
        vertical-alignment: center;
    }
}
