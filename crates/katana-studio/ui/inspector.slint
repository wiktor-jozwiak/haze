// Deep parameter inspector: rack module for the block selected in the signal chain.
// Left: module header (category stripe, type selector, colour memory, bypass). Right: the
// parameters on a grid of encoders. Cell positions come precomputed from Rust (col / py).
import { T } from "theme.slint";
import { Toggle, Icon, Icons } from "widgets.slint";
import { Led } from "widgets.slint";

export struct ParamRow {
    group: string,
    show-group: bool,
    name: string,
    value: int,
    min: int,
    max: int,
    display: string,
    is-enum: bool,
    is-switch: bool,
    col: int,   // grid column of the cell's left edge
    span: int,  // columns the cell covers (lists take two)
    py: float,  // top of the cell in px
}

/// Big knob: sprite + value arc in the enclosure colour, label above, value below.
component BigKnob inherits Rectangle {
    in property <ParamRow> p;
    in property <color> accent;
    callback changed(int);
    property <float> t: (p.value - p.min) / Math.max(1, p.max - p.min);
    property <int> start-v;
    property <length> start-y;
    property <bool> fine;
    property <bool> active: ta.pressed || ta.has-hover;
    // arc geometry on a 64×64 grid, 0° = 12 o'clock, clockwise, -135°..+135°
    // bipolar params (e.g. -20..+20 dB) grow the arc from the centre detent
    property <float> zero-t: p.min < 0 && p.max > 0 ? (0 - p.min) / (p.max - p.min) : 0;
    property <float> lo-t: Math.min(zero-t, t);
    property <float> hi-t: Math.max(zero-t, t);
    property <float> a0: -135;
    property <float> s0: -135 + lo-t * 270;
    property <float> s1: -135 + hi-t * 270;
    property <float> r: 29;
    height: 112px;

    Text {
        y: 0;
        width: parent.width - 8px;
        x: 4px;
        text: p.name;
        horizontal-alignment: center;
        overflow: elide;
        color: active ? T.text : T.text-2;
        font-size: 12px;
    }
    Rectangle {
        x: (parent.width - 64px) / 2;
        y: 20px;
        width: 64px;
        height: 64px;
        Path {
            width: 64px;
            height: 64px;
            viewbox-width: 64;
            viewbox-height: 64;
            stroke: #2A2D35;
            stroke-width: 3px;
            commands: "M " + (32 + r * Math.sin(a0 * 1deg)) + " " + (32 - r * Math.cos(a0 * 1deg))
                + " A " + r + " " + r + " 0 1 1 " + (32 + r * Math.sin(135deg)) + " " + (32 - r * Math.cos(135deg));
        }
        if hi-t - lo-t > 0.004: Path {
            width: 64px;
            height: 64px;
            viewbox-width: 64;
            viewbox-height: 64;
            stroke: root.accent;
            stroke-width: 3px;
            commands: "M " + (32 + r * Math.sin(s0 * 1deg)) + " " + (32 - r * Math.cos(s0 * 1deg))
                + " A " + r + " " + r + " 0 " + ((hi-t - lo-t) * 270 > 180 ? 1 : 0) + " 1 " + (32 + r * Math.sin(s1 * 1deg)) + " " + (32 - r * Math.cos(s1 * 1deg));
        }
        cap := Rectangle {
            x: 12px;
            y: 12px;
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: ta.pressed ? #1A1C22 : #20232A;
            border-width: 1px;
            border-color: root.active ? T.line-hi : T.line;
            Rectangle {
                property <angle> a: (-135 + root.t * 270) * 1deg;
                x: 20px + 13px * sin(a) - 2px;
                y: 20px - 13px * cos(a) - 2px;
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: ta.pressed ? root.accent : T.text;
            }
        }
    }
    Text {
        y: 88px;
        width: parent.width;
        text: p.display;
        horizontal-alignment: center;
        color: ta.pressed ? root.accent : T.text;
        font-family: T.mono;
        font-size: 12px;
        font-weight: 600;
    }
    ta := TouchArea {
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.start-v = p.value;
                root.start-y = self.mouse-y;
                root.fine = e.modifiers.shift;
            }
        }
        moved => {
            if self.pressed {
                root.changed(clamp(round(root.start-v + (root.start-y - self.mouse-y) / (root.fine ? 720px : 180px) * (p.max - p.min)), p.min, p.max));
            }
        }
        scroll-event(e) => {
            root.changed(clamp(p.value + (e.delta-y > 0 ? 1 : -1) * Math.max(1, round((p.max - p.min) / 100)), p.min, p.max));
            accept
        }
    }
}

/// Grid cell for an on/off switch or a list choice: label on top like a knob, control below.
component RowCell inherits Rectangle {
    in property <ParamRow> p;
    callback changed(int);
    callback enum-request;
    height: 112px;
    Text {
        y: 0;
        x: 4px;
        width: parent.width - 8px;
        text: p.name;
        color: T.text-2;
        font-size: 12px;
        horizontal-alignment: center;
        overflow: elide;
    }
    HorizontalLayout {
        y: 34px;
        height: 36px;
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        if p.is-switch: VerticalLayout {
            alignment: center;
            Toggle {
                on: p.value != 0;
                led: 1;
                toggled(v) => { changed(v ? 1 : 0); }
            }
        }
        if !p.is-switch: VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Rectangle {
                height: 34px;
                border-radius: T.r;
                background: eta.has-hover ? T.hover : T.well;
                border-width: 1px;
                border-color: eta.has-hover ? T.line-hi : T.line;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 10px;
                    Text {
                        text: p.display;
                        color: T.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    VerticalLayout {
                        alignment: center;
                        Icon { d: Icons.chevron-down; size: 14px; tint: T.text-3; }
                    }
                }
                eta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { enum-request(); }
                }
            }
        }
    }
}

/// Bottom dock: the pedal's face on the left (enclosure colour, silkscreen, type window,
/// colour-memory LEDs, footswitch), its parameters on a wide grid to the right.
export component Inspector inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <color> hue;
    in property <color> ink;
    in property <bool> has-sw;
    in property <bool> on;
    in property <int> variant: -1;
    in property <bool> has-types;
    in property <[string]> sections;
    in property <int> section;
    in property <[ParamRow]> params;
    in property <float> params-h;
    in property <int> cols: 6;
    callback close();
    callback toggle(bool);
    callback variant-picked(int);
    callback type-request();
    callback section-picked(int);
    callback param(int, int);
    callback enum-request(int);

    property <color> accent: hue.brighter(0.35);
    property <length> face-w: 260px;
    property <length> cw: (self.width - face-w - 48px) / cols;

    border-radius: 6px;
    background: T.bg;
    border-width: 1px;
    border-color: T.line;
    clip: true;
    TouchArea { }

    // ------------------------------------------------ module header
    face := Rectangle {
        x: 0;
        y: 0;
        width: face-w;
        height: parent.height;
        background: T.panel;
        // category stripe
        Rectangle { x: 0; width: 3px; background: root.hue; }
        Rectangle { x: parent.width - 1px; width: 1px; background: T.line; }

        Text {
            x: 22px;
            y: 18px;
            width: parent.width - 44px;
            text: root.title;
            color: T.text;
            font-family: T.mono;
            font-weight: 700;
            font-size: 20px;
            letter-spacing: 1.5px;
            overflow: elide;
        }
        HorizontalLayout {
            x: 22px;
            y: 50px;
            height: 14px;
            spacing: 6px;
            VerticalLayout { alignment: center; Led { size: 7px; state: !has-sw || on ? 1 : 0; } }
            Text {
                text: !has-sw ? "ALWAYS ON" : on ? "ACTIVE" : "BYPASS";
                color: T.text-3;
                font-family: T.mono;
                font-size: 10px;
                letter-spacing: 1px;
                vertical-alignment: center;
            }
        }

        // type selector
        if has-types: Rectangle {
            x: 22px;
            y: 80px;
            width: parent.width - 44px;
            height: 36px;
            border-radius: T.r;
            background: tya.has-hover ? T.hover : T.well;
            border-width: 1px;
            border-color: tya.has-hover ? T.line-hi : T.line;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                spacing: 8px;
                Text {
                    text: root.subtitle;
                    color: T.text;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                VerticalLayout {
                    alignment: center;
                    Icon { d: Icons.chevron-down; size: 16px; tint: T.text-3; }
                }
            }
            tya := TouchArea {
                mouse-cursor: pointer;
                clicked => { type-request(); }
            }
        }

        // colour memory: the three LED colours the amp panel can recall
        if variant >= 0: HorizontalLayout {
            x: 22px;
            y: has-types ? 128px : 80px;
            width: parent.width - 44px;
            height: 30px;
            spacing: 4px;
            for c[i] in ["GRN", "RED", "YEL"]: Rectangle {
                horizontal-stretch: 1;
                border-radius: T.r;
                background: i == variant ? T.panel-hi : vca.has-hover ? T.hover : transparent;
                border-width: 1px;
                border-color: i == variant ? T.line-hi : T.line;
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    VerticalLayout { alignment: center; Led { size: 7px; state: i == variant || vca.has-hover ? i + 1 : 0; } }
                    Text {
                        text: c;
                        color: i == variant ? T.text : T.text-3;
                        font-family: T.mono;
                        font-size: 10px;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                }
                vca := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { variant-picked(i); }
                }
            }
        }

        // bypass switch
        if has-sw: Rectangle {
            x: 22px;
            y: parent.height - 58px;
            width: parent.width - 44px;
            height: 36px;
            border-radius: T.r;
            background: fsa.pressed ? T.well : on ? T.accent.with-alpha(0.12) : fsa.has-hover ? T.hover : T.panel-hi;
            border-width: 1px;
            border-color: on ? T.accent-lo : T.line-hi;
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: on ? T.accent : #2A2D35;
                    }
                }
                Text {
                    text: on ? "ON" : "BYPASS";
                    color: on ? T.accent-hi : T.text-2;
                    font-family: T.mono;
                    font-weight: 600;
                    font-size: 11px;
                    letter-spacing: 1.5px;
                    vertical-alignment: center;
                }
            }
            fsa := TouchArea {
                mouse-cursor: pointer;
                clicked => { toggle(!on); }
            }
        }
    }

    // ------------------------------------------------ section tabs
    tabs := Rectangle {
        x: face-w;
        y: 0;
        width: parent.width - face-w;
        height: 46px;
        if sections.length > 1: HorizontalLayout {
            padding-left: 24px;
            padding-right: 60px;
            spacing: 22px;
            alignment: start;
            for sct[i] in sections: Rectangle {
                width: stt.preferred-width;
                stt := Text {
                    text: sct;
                    color: i == section ? T.text : sta.has-hover ? T.text-2 : T.text-3;
                    font-family: T.mono;
                    font-size: 11px;
                    letter-spacing: 1px;
                    font-weight: i == section ? 600 : 400;
                }
                Rectangle {
                    y: parent.height - 2px;
                    height: 2px;
                    background: i == section ? root.accent : transparent;
                }
                sta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { section-picked(i); }
                }
            }
        }
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: T.line;
        }
    }

    // close
    Rectangle {
        x: parent.width - 44px;
        y: 7px;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: xa.has-hover ? T.hover : transparent;
        Icon { d: Icons.close; size: 18px; tint: xa.has-hover ? T.text : T.text-3; }
        xa := TouchArea {
            mouse-cursor: pointer;
            clicked => { close(); }
        }
    }

    // ------------------------------------------------ parameter grid
    Flickable {
        x: face-w;
        y: 46px;
        width: parent.width - face-w;
        height: parent.height - 46px;
        content-height: params-h * 1px + 40px;
        for p[i] in params: Rectangle {
            x: 24px + p.col * root.cw;
            y: 20px + p.py * 1px;
            width: p.span * root.cw;
            height: 112px;
            if p.show-group: Text {
                x: 4px;
                y: -26px;
                text: p.group;
                color: T.text-3;
                font-family: T.mono;
                font-size: 10px;
                letter-spacing: 1px;
                font-weight: 600;
            }
            if !p.is-enum && !p.is-switch: BigKnob {
                width: parent.width;
                p: p;
                accent: root.accent;
                changed(v) => { param(i, v); }
            }
            if p.is-enum || p.is-switch: RowCell {
                width: parent.width;
                p: p;
                changed(v) => { param(i, v); }
                enum-request => { enum-request(i); }
            }
        }
    }
}
