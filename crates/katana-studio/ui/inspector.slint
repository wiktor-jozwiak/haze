// Parameter inspector for the block selected in the signal chain: the single place where
// parameters are edited. One header row (identity, type, colour memory, tabs, power), then
// the parameters on a grid of encoders. Cell positions come precomputed from Rust (col / py).
import { T } from "theme.slint";
import { Faceplate, Lamp, LatchKey, Silk } from "gear.slint";
import { Toggle, Icon, Icons, Tip, Led, Glyphs } from "widgets.slint";

export struct ParamRow {
    group: string,
    show-group: bool,
    name: string,
    value: int,
    min: int,
    max: int,
    display: string,
    is-enum: bool,
    is-switch: bool,
    col: int,   // grid column of the cell's left edge
    span: int,  // columns the cell covers (lists take two)
    py: float,  // top of the cell in px
}

/// Encoder: value arc in the block colour, value inside the ring, label underneath.
/// Drag (Shift = fine), wheel.
component BigKnob inherits Rectangle {
    in property <ParamRow> p;
    in property <color> accent;
    callback changed(int);
    property <float> t: (p.value - p.min) / Math.max(1, p.max - p.min);
    property <int> start-v;
    property <length> start-y;
    property <bool> fine;
    property <bool> active: ta.pressed || ta.has-hover;
    // arc on a 64×64 grid, 0° = 12 o'clock, clockwise, -135°..+135°;
    // bipolar params (e.g. -20..+20 dB) grow the arc from the centre detent
    property <float> zero-t: p.min < 0 && p.max > 0 ? (0 - p.min) / (p.max - p.min) : 0;
    property <float> lo-t: Math.min(zero-t, t);
    property <float> hi-t: Math.max(zero-t, t);
    property <float> a0: -135;
    property <float> s0: -135 + lo-t * 270;
    property <float> s1: -135 + hi-t * 270;
    property <float> r: 28;
    height: 92px;

    Rectangle {
        x: (parent.width - 64px) / 2;
        y: 0;
        width: 64px;
        height: 64px;
        // LED ring: 21 segments, bipolar params light from the centre detent
        for d[i] in 21: Rectangle {
            property <angle> da: (-135 + i * 13.5) * 1deg;
            property <float> f: i / 20;
            property <bool> lit: f >= root.lo-t - 0.026 && f <= root.hi-t + 0.026;
            x: 32px + 29px * Math.sin(da) - 2px;
            y: 32px - 29px * Math.cos(da) - 2px;
            width: 4px;
            height: 4px;
            border-radius: 2px;
            background: lit ? root.accent : #2F2C29;
        }
        // skirt
        Rectangle {
            x: 10px;
            y: 10px;
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: @linear-gradient(160deg, #D9DBDF 0%, #9A9EA6 45%, #4E5259 100%);
            drop-shadow-blur: 6px;
            drop-shadow-offset-y: 3px;
            drop-shadow-color: #000000b0;
        }
        // knurled cap
        Rectangle {
            x: 14px;
            y: 14px;
            width: 36px;
            height: 36px;
            border-radius: 18px;
            background: @linear-gradient(160deg, #46484D 0%, #1B1C1F 55%, #0B0B0C 100%);
            border-width: 1px;
            border-color: #000000;
            Rectangle {
                x: 7px;
                y: 3px;
                width: 22px;
                height: 9px;
                border-radius: 5px;
                background: @linear-gradient(180deg, #ffffff26 0%, #ffffff00 100%);
            }
        }
        Path {
            width: 64px;
            height: 64px;
            viewbox-width: 64;
            viewbox-height: 64;
            stroke: ta.pressed ? root.accent : #F4F1EA;
            stroke-width: 2.6px;
            MoveTo { x: 32 + 6 * Math.sin((-135 + 270 * root.t) * 1deg); y: 32 - 6 * Math.cos((-135 + 270 * root.t) * 1deg); }
            LineTo { x: 32 + 16 * Math.sin((-135 + 270 * root.t) * 1deg); y: 32 - 16 * Math.cos((-135 + 270 * root.t) * 1deg); }
        }
    }
    Text {
        y: 64px;
        width: parent.width - 8px;
        x: 4px;
        text: p.name.to-uppercase();
        horizontal-alignment: center;
        overflow: elide;
        color: active ? T.silk : T.silk-2;
        font-family: T.display;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
    }
    Text {
        y: 78px;
        width: parent.width - 8px;
        x: 4px;
        text: p.display;
        horizontal-alignment: center;
        overflow: elide;
        color: ta.pressed || active ? root.accent : T.text-2;
        font-family: T.mono;
        font-size: 11px;
        font-weight: 600;
    }
    ta := TouchArea {
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.start-v = p.value;
                root.start-y = self.mouse-y;
                root.fine = e.modifiers.shift;
            }
        }
        moved => {
            if self.pressed {
                root.changed(clamp(round(root.start-v + (root.start-y - self.mouse-y) / (root.fine ? 720px : 180px) * (p.max - p.min)), p.min, p.max));
            }
        }
        scroll-event(e) => {
            root.changed(clamp(p.value + (e.delta-y > 0 ? 1 : -1) * Math.max(1, round((p.max - p.min) / 100)), p.min, p.max));
            accept
        }
    }
}

/// Switch or list choice, on the same rhythm as `BigKnob`: control centred on the dial
/// (y 32), label on the label baseline (y 70).
component RowCell inherits Rectangle {
    in property <ParamRow> p;
    callback changed(int);
    callback enum-request;
    height: 92px;
    if p.is-switch: LatchKey {
        x: (parent.width - self.width) / 2;
        y: 32px - self.height / 2;
        text: p.value != 0 ? "ON" : "OFF";
        on: p.value != 0;
        c: T.led-red;
        clicked => { changed(p.value != 0 ? 0 : 1); }
    }
    if !p.is-switch: Rectangle {
        x: 8px;
        y: 32px - self.height / 2;
        width: parent.width - 16px;
        height: 36px;
        border-radius: 6px;
        background: @linear-gradient(180deg, #070707 0%, #121110 100%);
        border-width: 1px;
        border-color: eta.has-hover ? T.line-hi : #000000a0;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 10px;
            Text {
                text: p.display;
                color: T.silk;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                Icon { d: Icons.chevron-down; size: 14px; tint: T.text-2; }
            }
        }
        eta := TouchArea {
            mouse-cursor: pointer;
            clicked => { enum-request(); }
        }
    }
    Text {
        y: 70px;
        x: 4px;
        width: parent.width - 8px;
        text: p.name.to-uppercase();
        color: T.silk-2;
        font-family: T.display;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        horizontal-alignment: center;
        overflow: elide;
    }
}

component Caption inherits Silk { }

/// Segment of a pill-shaped segmented control. Disabled segments explain themselves on hover.
component SegBtn inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <string> hint;
    in property <color> accent: T.accent;
    in property <bool> stretch: true;
    /// drive bars (0..5) left of the label, -1 none
    in property <int> bars: -1;
    callback clicked;
    min-width: t.preferred-width + 28px + (bars >= 0 ? 26px : 0) + (active ? 16px : 0);
    horizontal-stretch: stretch ? 1 : 0;
    height: 32px;
    border-radius: 6px;
    background: active
        ? @linear-gradient(180deg, #121110 0%, #1F1D1B 100%)
        : ta.has-hover && enabled ? @linear-gradient(180deg, #3A3734 0%, #201E1C 100%) : @linear-gradient(180deg, #2E2B28 0%, #1A1917 100%);
    border-width: 1px;
    border-color: #000000b0;
    if !active: Rectangle { x: 5px; y: 1px; width: parent.width - 10px; height: 1px; background: #ffffff16; }
    HorizontalLayout {
        alignment: center;
        spacing: 7px;
        if root.bars >= 0: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 19px;
                height: 12px;
                for i in 5: Rectangle {
                    x: i * 4px;
                    y: parent.height - self.height;
                    width: 3px;
                    height: 4px + i * 2px;
                    border-radius: 1px;
                    background: i < root.bars
                        ? (root.enabled ? T.drive(root.bars) : T.text-off)
                        : #3A3632;
                }
            }
        }
        if root.active: VerticalLayout {
            alignment: center;
            Lamp { size: 8px; c: root.accent; lit: true; }
        }
        t := Text {
            text: root.text.to-uppercase();
            vertical-alignment: center;
            color: active ? T.silk : enabled ? (ta.has-hover ? T.silk : T.silk-2) : T.text-off;
            font-family: T.display;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1px;
        }
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : not-allowed;
        clicked => { if root.enabled { root.clicked(); } }
    }
    if ta.has-hover && !enabled && hint != "": Tip {
        x: (parent.width - self.width) / 2;
        y: -30px;
        text: root.hint;
    }
}

component SegGroup inherits Rectangle {
    height: 32px;
    HorizontalLayout {
        spacing: 5px;
        @children
    }
}

/// Amp tab header: mutually exclusive amp types, then modifiers that apply on top of a type.
component AmpTypeBand inherits Rectangle {
    in property <int> family;
    in property <bool> variation;
    /// PC-engine voicing picked that the Katana lacks (2 PUSHED, 6 MODERN), -1 none
    in property <int> dsp-voicing: -1;
    in property <color> accent;
    callback family-picked(int);
    callback variation-toggled(bool);
    callback dsp-voicing-picked(int);

    // label, Katana family index (-1 = PC DSP engine only), PC engine voicing index
    property <[{n: string, f: int, d: int, g: int}]> types: [
        { n: "Acoustic", f: 0, d: 0, g: 0 }, { n: "Clean", f: 1, d: 1, g: 1 }, { n: "Pushed", f: -1, d: 2, g: 2 }, { n: "Crunch", f: 2, d: 3, g: 3 },
        { n: "Lead", f: 3, d: 4, g: 4 }, { n: "Brown", f: 4, d: 5, g: 5 }, { n: "Modern", f: -1, d: 6, g: 5 },
    ];

    HorizontalLayout {
        spacing: 24px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            Caption { text: "AMP TYPE"; }
            SegGroup {
                for v in types: SegBtn {
                    text: v.n;
                    bars: v.g;
                    accent: root.accent;
                    active: dsp-voicing >= 0 ? v.d == dsp-voicing : v.f >= 0 && v.f == family;
                    enabled: v.f >= 0 || !T.hw;
                    hint: "Standalone engine only";
                    clicked => {
                        if v.f >= 0 { family-picked(v.f); } else { dsp-voicing-picked(v.d); }
                    }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 0;
            spacing: 8px;
            Caption { text: "MODIFIERS"; }
            LatchKey {
                text: "VARIATION";
                on: variation;
                c: root.accent;
                clicked => { variation-toggled(!variation); }
            }
        }
    }
}

export component Inspector inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <color> hue;
    in property <int> kind;
    in property <color> ink;
    in property <bool> has-sw;
    in property <bool> on;
    in property <int> variant: -1;
    in property <bool> has-types;
    in property <[string]> sections;
    in property <int> section;
    in property <[ParamRow]> params;
    in property <float> params-h;
    in property <int> cols: 8;
    // amp block: type band on the Amp tab
    in property <bool> is-amp;
    in property <int> amp-family: -1;
    in property <bool> amp-var;
    in property <int> dsp-voicing: -1;
    // band above the knobs: 1 EQ response, 2 delay tempo sync
    in property <int> extra;
    in property <string> eq-curve;
    in property <string> eq-fill;
    in property <int> delay-ms;
    in property <int> bpm: 100;
    callback delay-sync(int);
    callback tap();
    callback toggle(bool);
    callback variant-picked(int);
    callback type-request();
    callback section-picked(int);
    callback param(int, int);
    callback enum-request(int);
    callback family-picked(int);
    callback variation-toggled(bool);
    callback dsp-voicing-picked(int);

    property <color> accent: hue.brighter(0.35);
    property <length> head-h: 68px;
    property <length> pad: 24px;
    property <length> cw: (self.width - 2 * pad) / cols;
    property <bool> band: is-amp && section == 0;
    property <length> band-h: band ? 96px : extra == 1 ? 168px : extra == 2 ? 74px : 0px;

    border-radius: T.r-card;
    clip: true;
    TouchArea { }
    Faceplate {
        width: parent.width;
        height: parent.height;
        border-radius: T.r-card;
    }

    // ------------------------------------------------ header row
    HorizontalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: head-h;
        padding-left: pad;
        padding-right: pad;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            // enamel badge in the block's colour, like a miniature of its enclosure
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 7px;
                background: @linear-gradient(165deg, root.hue.brighter(0.28) 0%, root.hue 40%, root.hue.darker(0.3) 100%);
                border-width: 1px;
                border-color: root.hue.darker(0.5);
                drop-shadow-blur: 4px;
                drop-shadow-offset-y: 2px;
                drop-shadow-color: #00000090;
                Rectangle { x: 4px; y: 1px; width: parent.width - 8px; height: 1px; background: #ffffff50; }
                Path {
                    width: 20px;
                    height: 20px;
                    commands: Glyphs.path(root.kind);
                    viewbox-width: 24;
                    viewbox-height: 24;
                    stroke: root.ink;
                    stroke-width: 1.9px;
                    fill: transparent;
                }
            }
        }
        Text {
            text: root.title.to-uppercase();
            color: T.silk;
            font-family: T.display;
            font-size: 22px;
            font-weight: 700;
            letter-spacing: 1.5px;
            vertical-alignment: center;
        }
        // type / model picker
        if has-types: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 230px;
                height: 34px;
                border-radius: 6px;
                background: @linear-gradient(180deg, #070707 0%, #121110 100%);
                border-width: 1px;
                border-color: tya.has-hover ? T.line-hi : #000000a0;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 10px;
                    spacing: 8px;
                    if is-amp: Silk {
                        text: "MODEL";
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.subtitle;
                        color: T.accent;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    VerticalLayout {
                        alignment: center;
                        Icon { d: Icons.chevron-down; size: 16px; tint: T.text-2; }
                    }
                }
                tya := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { type-request(); }
                }
            }
        }
        // colour memory: the three panel colours the amp can recall for this block
        if variant >= 0: VerticalLayout {
            alignment: center;
            SegGroup {
                width: 3 * 34px + 10px;
                for c[i] in ["Green", "Red", "Yellow"]: Rectangle {
                    width: 34px;
                    border-radius: 6px;
                    background: i == variant ? T.panel-hi : vca.has-hover ? T.hover : transparent;
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: i == variant || vca.has-hover ? T.led(i + 1) : T.led(i + 1).with-alpha(0.35);
                    }
                    vca := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { variant-picked(i); }
                    }
                    if vca.has-hover: Tip {
                        x: (parent.width - self.width) / 2;
                        y: parent.height + 6px;
                        text: c + " memory";
                    }
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        // section tabs as a segmented control
        if sections.length > 1: VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            SegGroup {
                for sct[i] in sections: SegBtn {
                    stretch: false;
                    text: sct;
                    accent: T.text;
                    active: i == section;
                    clicked => { section-picked(i); }
                }
            }
        }
        // power
        if has-sw: VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            LatchKey {
                text: on ? "ON" : "BYPASS";
                on: root.on;
                c: T.led-green;
                clicked => { toggle(!root.on); }
            }
        }
        if !has-sw: HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 8px;
            VerticalLayout { alignment: center; Lamp { size: 9px; c: T.led-green; lit: true; } }
            Silk {
                text: "ALWAYS ON";
                vertical-alignment: center;
            }
        }
    }
    Rectangle {
        x: pad;
        y: head-h - 2px;
        width: parent.width - 2 * pad;
        height: 2px;
        Rectangle { y: 0; height: 1px; background: #00000099; }
        Rectangle { y: 1px; height: 1px; background: #ffffff10; }
    }

    // ------------------------------------------------ parameters
    Flickable {
        x: 0;
        y: head-h;
        width: parent.width;
        height: parent.height - head-h;
        content-height: band-h + params-h * 1px + 48px;
        if band: AmpTypeBand {
            x: pad;
            y: 20px;
            width: parent.width - 2 * pad;
            height: 66px;
            family: amp-family;
            variation: amp-var;
            dsp-voicing: dsp-voicing;
            accent: root.accent;
            family-picked(f) => { root.family-picked(f); }
            variation-toggled(v) => { root.variation-toggled(v); }
            dsp-voicing-picked(v) => { root.dsp-voicing-picked(v); }
        }
        if extra == 1: Rectangle {
            x: pad;
            y: 20px;
            width: parent.width - 2 * pad;
            height: 136px;
            border-radius: 8px;
            background: @linear-gradient(180deg, #070707 0%, #100F0E 100%);
            border-width: 1px;
            border-color: #000000;
            clip: true;
            // octave grid (100 Hz, 1 kHz, 10 kHz) and the 0 dB line
            for gx in [0.233, 0.566, 0.9]: Rectangle {
                x: parent.width * gx;
                width: 1px;
                height: parent.height;
                background: T.line;
            }
            Rectangle {
                y: parent.height / 2;
                width: parent.width;
                height: 1px;
                background: T.line-hi;
            }
            Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 1000;
                viewbox-height: 200;
                fit: fill;
                commands: root.eq-fill;
                fill: root.accent.with-alpha(0.14);
            }
            Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 1000;
                viewbox-height: 200;
                fit: fill;
                commands: root.eq-curve;
                stroke: root.accent;
                stroke-width: 2px;
                fill: transparent;
            }
            for l in [{ x: 0.0, t: "20 Hz" }, { x: 0.233, t: "100" }, { x: 0.566, t: "1k" }, { x: 0.9, t: "10k" }]: Text {
                x: parent.width * l.x + 6px;
                y: parent.height - 18px;
                text: l.t;
                color: T.text-3;
                font-size: 10.5px;
            }
            Text { x: 8px; y: 6px; text: "+24 dB"; color: T.text-3; font-size: 10.5px; }
            Text { x: 8px; y: parent.height / 2 - 16px; text: "0"; color: T.text-3; font-size: 10.5px; }
        }
        if extra == 2: HorizontalLayout {
            x: pad;
            y: 20px;
            width: parent.width - 2 * pad;
            height: 40px;
            spacing: 10px;
            Text {
                text: "Sync to tempo";
                color: T.text-2;
                font-size: 12.5px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: bpm + " BPM";
                color: T.text;
                font-family: T.mono;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                LatchKey {
                    text: "TAP";
                    lamp: false;
                    clicked => { root.tap(); }
                }
            }
            Rectangle { width: 6px; }
            SegGroup {
                for n in [{ t: "1/4", f: 1.0 }, { t: "1/8.", f: 0.75 }, { t: "1/4T", f: 0.6667 }, { t: "1/8", f: 0.5 }, { t: "1/8T", f: 0.3333 }, { t: "1/16", f: 0.25 }]: SegBtn {
                    stretch: false;
                    text: n.t;
                    accent: T.text;
                    active: abs(round(60000 / Math.max(bpm, 1) * n.f) - delay-ms) <= 1;
                    clicked => { root.delay-sync(round(60000 / Math.max(bpm, 1) * n.f)); }
                }
            }
            Text {
                horizontal-stretch: 1;
                text: delay-ms + " ms";
                color: T.text-3;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
        for p[i] in params: Rectangle {
            x: pad + p.col * root.cw;
            y: 24px + band-h + p.py * 1px;
            width: p.span * root.cw;
            height: 92px;
            if p.show-group: Text {
                x: 4px;
                y: -28px;
                text: p.group;
                color: T.text-2;
                font-size: 12px;
                font-weight: 600;
            }
            if !p.is-enum && !p.is-switch: BigKnob {
                width: parent.width;
                p: p;
                accent: root.accent;
                changed(v) => { param(i, v); }
            }
            if p.is-enum || p.is-switch: RowCell {
                width: parent.width;
                p: p;
                changed(v) => { param(i, v); }
                enum-request => { enum-request(i); }
            }
        }
    }
}
