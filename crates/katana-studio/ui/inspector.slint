// Effect inspector: a close-up of the selected pedal. The top is the pedal's face (enclosure
// colour, silkscreen, type window, colour-memory LEDs, footswitch); below it the parameters
// sit on a grid of real knobs. Cell positions come precomputed from Rust (col / py).
import { T } from "theme.slint";
import { Toggle, Icon, Icons } from "widgets.slint";
import { LedImg } from "rig.slint";

export struct ParamRow {
    group: string,
    show-group: bool,
    name: string,
    value: int,
    min: int,
    max: int,
    display: string,
    is-enum: bool,
    is-switch: bool,
    col: int,   // grid column of the cell's left edge
    span: int,  // columns the cell covers (lists take two)
    py: float,  // top of the cell in px
}

/// Big knob: sprite + value arc in the enclosure colour, label above, value below.
component BigKnob inherits Rectangle {
    in property <ParamRow> p;
    in property <color> accent;
    callback changed(int);
    property <float> t: (p.value - p.min) / Math.max(1, p.max - p.min);
    property <int> start-v;
    property <length> start-y;
    property <bool> active: ta.pressed || ta.has-hover;
    // arc geometry on a 64×64 grid, 0° = 12 o'clock, clockwise, -135°..+135°
    // bipolar params (e.g. -20..+20 dB) grow the arc from the centre detent
    property <float> zero-t: p.min < 0 && p.max > 0 ? (0 - p.min) / (p.max - p.min) : 0;
    property <float> lo-t: Math.min(zero-t, t);
    property <float> hi-t: Math.max(zero-t, t);
    property <float> a0: -135;
    property <float> s0: -135 + lo-t * 270;
    property <float> s1: -135 + hi-t * 270;
    property <float> r: 29;
    height: 112px;

    Text {
        y: 0;
        width: parent.width - 8px;
        x: 4px;
        text: p.name;
        horizontal-alignment: center;
        overflow: elide;
        color: active ? T.text : T.text-2;
        font-size: 12px;
    }
    Rectangle {
        x: (parent.width - 64px) / 2;
        y: 20px;
        width: 64px;
        height: 64px;
        Path {
            width: 64px;
            height: 64px;
            viewbox-width: 64;
            viewbox-height: 64;
            stroke: #ffffff12;
            stroke-width: 3px;
            commands: "M " + (32 + r * Math.sin(a0 * 1deg)) + " " + (32 - r * Math.cos(a0 * 1deg))
                + " A " + r + " " + r + " 0 1 1 " + (32 + r * Math.sin(135deg)) + " " + (32 - r * Math.cos(135deg));
        }
        if hi-t - lo-t > 0.004: Path {
            width: 64px;
            height: 64px;
            viewbox-width: 64;
            viewbox-height: 64;
            stroke: root.accent;
            stroke-width: 3px;
            commands: "M " + (32 + r * Math.sin(s0 * 1deg)) + " " + (32 - r * Math.cos(s0 * 1deg))
                + " A " + r + " " + r + " 0 " + ((hi-t - lo-t) * 270 > 180 ? 1 : 0) + " 1 " + (32 + r * Math.sin(s1 * 1deg)) + " " + (32 - r * Math.cos(s1 * 1deg));
        }
        Image {
            x: 8px;
            y: 8px;
            width: 48px;
            height: 48px;
            source: @image-url("art/knob-insp.png");
            source-clip-y: round(root.t * 63) * 48;
            source-clip-width: 48;
            source-clip-height: 48;
        }
    }
    Text {
        y: 88px;
        width: parent.width;
        text: p.display;
        horizontal-alignment: center;
        color: ta.pressed ? root.accent : T.text;
        font-size: 13px;
        font-weight: 600;
    }
    ta := TouchArea {
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.start-v = p.value;
                root.start-y = self.mouse-y;
            }
        }
        moved => {
            if self.pressed {
                root.changed(clamp(round(root.start-v + (root.start-y - self.mouse-y) / 180px * (p.max - p.min)), p.min, p.max));
            }
        }
        scroll-event(e) => {
            root.changed(clamp(p.value + (e.delta-y > 0 ? 1 : -1) * Math.max(1, round((p.max - p.min) / 100)), p.min, p.max));
            accept
        }
    }
}

/// Grid cell for an on/off switch or a list choice: label on top like a knob, control below.
component RowCell inherits Rectangle {
    in property <ParamRow> p;
    callback changed(int);
    callback enum-request;
    height: 112px;
    Text {
        y: 0;
        x: 4px;
        width: parent.width - 8px;
        text: p.name;
        color: T.text-2;
        font-size: 12px;
        horizontal-alignment: center;
        overflow: elide;
    }
    HorizontalLayout {
        y: 34px;
        height: 36px;
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        if p.is-switch: VerticalLayout {
            alignment: center;
            Toggle {
                on: p.value != 0;
                led: 1;
                toggled(v) => { changed(v ? 1 : 0); }
            }
        }
        if !p.is-switch: VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Rectangle {
                height: 34px;
                border-radius: 6px;
                background: eta.has-hover ? #24211c : #1c1a16;
                border-width: 1px;
                border-color: eta.has-hover ? #ffffff1c : #ffffff10;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 10px;
                    Text {
                        text: p.display;
                        color: T.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    VerticalLayout {
                        alignment: center;
                        Icon { d: Icons.chevron-down; size: 14px; tint: T.text-3; }
                    }
                }
                eta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { enum-request(); }
                }
            }
        }
    }
}

/// Bottom dock: the pedal's face on the left (enclosure colour, silkscreen, type window,
/// colour-memory LEDs, footswitch), its parameters on a wide grid to the right.
export component Inspector inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <color> hue;
    in property <color> ink;
    in property <bool> has-sw;
    in property <bool> on;
    in property <int> variant: -1;
    in property <bool> has-types;
    in property <[string]> sections;
    in property <int> section;
    in property <[ParamRow]> params;
    in property <float> params-h;
    in property <int> cols: 6;
    callback close();
    callback toggle(bool);
    callback variant-picked(int);
    callback type-request();
    callback section-picked(int);
    callback param(int, int);
    callback enum-request(int);

    property <color> accent: hue.brighter(0.35);
    property <length> face-w: 300px;
    property <length> cw: (self.width - face-w - 48px) / cols;

    border-radius: 12px;
    background: #141210;
    clip: true;
    TouchArea { }

    // ------------------------------------------------ pedal face
    face := Rectangle {
        x: 0;
        y: 0;
        width: face-w;
        height: parent.height;
        background: @linear-gradient(180deg, hue.brighter(0.10) 0%, hue 60%, hue.darker(0.18) 100%);
        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("art/grain.png");
            horizontal-tiling: repeat;
            vertical-tiling: repeat;
        }
        Rectangle { background: @linear-gradient(90deg, #ffffff18 0%, #ffffff00 20%, #00000000 85%, #00000040 100%); }
        Rectangle {
            x: parent.width - 1px;
            width: 1px;
            background: #00000090;
        }

        // silkscreen title + state
        Text {
            x: 22px;
            y: 18px;
            width: parent.width - 44px;
            text: root.title;
            color: root.ink;
            font-family: T.display;
            font-weight: 700;
            font-size: 26px;
            letter-spacing: 0.5px;
            overflow: elide;
        }
        Text {
            x: 22px;
            y: 52px;
            text: !has-sw ? "zawsze aktywny" : on ? "włączony" : "wyłączony";
            color: root.ink.with-alpha(0.65);
            font-size: 12px;
        }

        // type window, recessed into the face
        if has-types: Rectangle {
            x: 22px;
            y: 80px;
            width: parent.width - 44px;
            height: 40px;
            border-radius: 6px;
            background: tya.has-hover ? #0c0b0a : #12100eE6;
            border-width: 1px;
            border-color: #00000080;
            Rectangle {
                y: parent.height - 1px;
                x: 4px;
                width: parent.width - 8px;
                height: 1px;
                background: #ffffff1c;
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                spacing: 8px;
                Text {
                    text: root.subtitle;
                    color: #f3ead7;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                VerticalLayout {
                    alignment: center;
                    Icon { d: Icons.chevron-down; size: 16px; tint: #f3ead7a0; }
                }
            }
            tya := TouchArea {
                mouse-cursor: pointer;
                clicked => { type-request(); }
            }
        }

        // colour memory: the three LED colours the amp panel can recall
        if variant >= 0: HorizontalLayout {
            x: 16px;
            y: has-types ? 132px : 80px;
            height: 34px;
            spacing: 2px;
            for c[i] in ["Zielony", "Czerwony", "Żółty"]: Rectangle {
                width: cl.preferred-width + 36px;
                border-radius: 6px;
                background: i == variant ? #00000050 : vca.has-hover ? #00000028 : transparent;
                LedImg {
                    x: 5px;
                    y: (parent.height - 22px) / 2;
                    state: i == variant || vca.has-hover ? i + 1 : 0;
                }
                cl := Text {
                    x: 29px;
                    text: c;
                    color: i == variant ? #f3ead7 : root.ink.with-alpha(0.75);
                    font-size: 12px;
                    font-weight: i == variant ? 600 : 400;
                    vertical-alignment: center;
                    height: parent.height;
                }
                vca := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { variant-picked(i); }
                }
            }
        }

        // LED + footswitch at the foot of the enclosure
        if has-sw: LedImg {
            x: (parent.width - 22px) / 2;
            y: parent.height - 96px;
            state: on ? Math.max(1, variant + 1) : 0;
        }
        if has-sw: Image {
            x: (parent.width - 48px) / 2;
            y: parent.height - 66px;
            width: 48px;
            height: 48px;
            source: @image-url("art/footswitch.png");
            Rectangle {
                visible: fsa.pressed;
                x: 10px;
                y: 10px;
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: #00000050;
            }
            fsa := TouchArea {
                mouse-cursor: pointer;
                clicked => { toggle(!on); }
            }
        }
    }

    // ------------------------------------------------ section tabs
    tabs := Rectangle {
        x: face-w;
        y: 0;
        width: parent.width - face-w;
        height: 46px;
        if sections.length > 1: HorizontalLayout {
            padding-left: 24px;
            padding-right: 60px;
            spacing: 22px;
            alignment: start;
            for sct[i] in sections: Rectangle {
                width: stt.preferred-width;
                stt := Text {
                    text: sct;
                    color: i == section ? T.text : sta.has-hover ? T.text-2 : T.text-3;
                    font-size: 13px;
                    font-weight: i == section ? 600 : 400;
                }
                Rectangle {
                    y: parent.height - 2px;
                    height: 2px;
                    background: i == section ? root.accent : transparent;
                }
                sta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { section-picked(i); }
                }
            }
        }
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: #ffffff0c;
        }
    }

    // close
    Rectangle {
        x: parent.width - 44px;
        y: 7px;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: xa.has-hover ? #ffffff14 : transparent;
        Icon { d: Icons.close; size: 18px; tint: xa.has-hover ? T.text : T.text-3; }
        xa := TouchArea {
            mouse-cursor: pointer;
            clicked => { close(); }
        }
    }

    // ------------------------------------------------ parameter grid
    Flickable {
        x: face-w;
        y: 46px;
        width: parent.width - face-w;
        height: parent.height - 46px;
        content-height: params-h * 1px + 40px;
        for p[i] in params: Rectangle {
            x: 24px + p.col * root.cw;
            y: 20px + p.py * 1px;
            width: p.span * root.cw;
            height: 112px;
            if p.show-group: Text {
                x: 4px;
                y: -26px;
                text: p.group;
                color: T.text-3;
                font-size: 12px;
                font-weight: 600;
            }
            if !p.is-enum && !p.is-switch: BigKnob {
                width: parent.width;
                p: p;
                accent: root.accent;
                changed(v) => { param(i, v); }
            }
            if p.is-enum || p.is-switch: RowCell {
                width: parent.width;
                p: p;
                changed(v) => { param(i, v); }
                enum-request => { enum-request(i); }
            }
        }
    }
}
