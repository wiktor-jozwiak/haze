// Surfaces and controls of the "modern hybrid" look: flat dark panels with a hairline edge
// and soft depth, quiet ghost keys, accent-tinted active states. Pedals and knobs stay
// physical (rig.slint, inspector.slint); everything around them is calm and flat.
// Flat fills and gradients only: the software renderer repaints just what changes.
// Component names are kept from the hardware look so call sites stay the same.
import { T } from "theme.slint";
import { Icon, Tip } from "widgets.slint";

/// Panel surface: flat, a faint top-lit gradient, hairline edge.
export component Faceplate inherits Rectangle {
    background: @linear-gradient(180deg, T.face-top 0%, T.face-bot 100%);
    Rectangle { y: 0; height: 1px; background: #ffffff12; }
    Rectangle { y: parent.height - 1px; height: 1px; background: #00000080; }
    @children
}

/// App background: deep graphite, a touch lighter at the top.
export component Tolex inherits Rectangle {
    clip: true;
    background: @linear-gradient(180deg, T.app-top 0%, T.app-bot 100%);
    @children
}

/// Pedalboard: a recessed tray with a fine dot grid.
export component Felt inherits Rectangle {
    clip: true;
    background: T.bg;
    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("tex/dots.png");
        horizontal-tiling: repeat;
        vertical-tiling: repeat;
    }
    @children
}

/// (hardware look) screw head: not drawn in the modern look.
export component PanelScrew inherits Rectangle {
    in property <length> size: 10px;
    width: 0;
    height: 0;
    visible: false;
}

/// Vertical divider between bar sections.
export component Groove inherits Rectangle {
    width: 1px;
    Rectangle { y: 6px; height: parent.height - 12px; background: #ffffff14; }
}

/// Status dot: solid with a soft halo when lit, a dim ring when off.
export component Lamp inherits Rectangle {
    in property <color> c: T.accent;
    in property <bool> lit;
    in property <length> size: 12px;
    width: size;
    height: size;
    if lit: Rectangle {
        width: root.size * 2.2;
        height: root.size * 2.2;
        border-radius: self.width / 2;
        background: @radial-gradient(circle, root.c.with-alpha(0.32) 0%, root.c.with-alpha(0) 70%);
    }
    Rectangle {
        width: root.size * 0.72;
        height: root.size * 0.72;
        border-radius: self.width / 2;
        background: lit ? root.c : #ffffff1f;
    }
}

/// Two-way segmented switch (engine mode). `right` = right segment selected.
export component BatToggle inherits Rectangle {
    in property <bool> right;
    in property <string> left-text;
    in property <string> right-text;
    in property <string> left-tip;
    in property <string> right-tip;
    in property <color> left-c: T.accent;
    in property <color> right-c: T.accent;
    callback picked(bool);
    width: 112px;
    height: 32px;
    border-radius: 8px;
    background: T.well;
    border-width: 1px;
    border-color: #ffffff12;
    // sliding thumb, tinted with the selected engine colour
    Rectangle {
        x: root.right ? parent.width / 2 : 3px;
        y: 3px;
        width: parent.width / 2 - 3px;
        height: parent.height - 6px;
        border-radius: 6px;
        background: (root.right ? root.right-c : root.left-c).with-alpha(0.16);
        border-width: 1px;
        border-color: (root.right ? root.right-c : root.left-c).with-alpha(0.5);
        animate x { duration: 140ms; easing: ease-out; }
    }
    Text {
        x: 0;
        width: parent.width / 2;
        height: parent.height;
        text: root.left-text;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: !right ? root.left-c : lta.has-hover ? T.text : T.text-3;
        font-family: T.display;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.8px;
    }
    Text {
        x: parent.width / 2;
        width: parent.width / 2;
        height: parent.height;
        text: root.right-text;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: right ? root.right-c : rta.has-hover ? T.text : T.text-3;
        font-family: T.display;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.8px;
    }
    lta := TouchArea {
        x: 0;
        width: parent.width / 2;
        mouse-cursor: pointer;
        clicked => { root.picked(false); }
    }
    rta := TouchArea {
        x: parent.width / 2;
        width: parent.width / 2;
        mouse-cursor: pointer;
        clicked => { root.picked(true); }
    }
    if lta.has-hover && left-tip != "": Tip {
        x: 0;
        y: parent.height + 8px;
        text: root.left-tip;
    }
    if rta.has-hover && right-tip != "": Tip {
        x: 0;
        y: parent.height + 8px;
        text: root.right-tip;
    }
}

/// Level meter: label and a 16-segment bar (green, amber over -12 dB, red at the top),
/// clip dot on the right.
export component VuMeter inherits Rectangle {
    in property <string> label;
    in property <float> level; // 0..1 peak
    in property <bool> clipped;
    /// narrow top bar: tighter segments
    in property <bool> compact;
    property <int> segs: compact ? 12 : 16;
    width: compact ? 78px : 96px;
    height: 32px;
    border-radius: 8px;
    background: T.well;
    border-width: 1px;
    border-color: #ffffff12;
    Text {
        x: root.compact ? 6px : 9px;
        width: 26px;
        height: parent.height;
        text: root.label;
        color: T.text-3;
        font-family: T.display;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.6px;
        vertical-alignment: center;
    }
    for i in root.segs: Rectangle {
        x: (root.compact ? 28px : 36px) + i * 3px;
        y: (parent.height - 12px) / 2;
        width: 2px;
        height: 12px;
        border-radius: 1px;
        background: (i + 0.5) / root.segs <= root.level
            ? (i * 16 >= 14 * root.segs ? T.led-red : i * 16 >= 11 * root.segs ? T.led-yellow : T.led-green)
            : #ffffff14;
    }
    Rectangle {
        x: parent.width - 12px;
        y: (parent.height - 5px) / 2;
        width: 5px;
        height: 5px;
        border-radius: 2.5px;
        background: root.clipped ? T.led-red : #ffffff1a;
    }
}

/// Page tab: quiet text, a soft filled pill when active, optional count badge.
export component PanelKey inherits Rectangle {
    in property <string> text;
    in property <string> badge;
    in property <bool> active;
    /// side padding (narrow top bar: less)
    in property <length> pad: 12px;
    callback clicked;
    width: row.preferred-width + 2 * pad;
    height: 34px;
    border-radius: 8px;
    background: active ? #ffffff12 : ta.has-hover ? #ffffff09 : transparent;
    // active marker under the label
    if active: Rectangle {
        x: root.pad;
        y: parent.height - 2px;
        width: parent.width - 2 * root.pad;
        height: 2px;
        border-radius: 1px;
        background: T.accent;
    }
    row := HorizontalLayout {
        x: root.pad;
        width: parent.width - 2 * root.pad;
        alignment: start;
        spacing: 7px;
        Text {
            text: root.text;
            vertical-alignment: center;
            color: root.active ? T.text : ta.has-hover ? T.text : T.text-2;
            font-family: T.display;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.4px;
        }
        if root.badge != "": VerticalLayout {
            alignment: center;
            Rectangle {
                width: bt.preferred-width + 10px;
                height: 17px;
                border-radius: 8.5px;
                background: root.active ? T.accent.with-alpha(0.18) : #ffffff0d;
                bt := Text {
                    text: root.badge;
                    color: root.active ? T.accent-hi : T.text-3;
                    font-size: 10.5px;
                    font-weight: 700;
                }
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Ghost icon button (help, settings).
export component RoundKey inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    callback clicked;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: ta.pressed ? #ffffff16 : ta.has-hover ? #ffffff0d : transparent;
    Icon {
        d: root.icon;
        size: 18px;
        tint: ta.has-hover ? T.text : T.text-2;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if ta.has-hover && tip != "": Tip {
        x: parent.width - self.width;
        y: parent.height + 8px;
        text: root.tip;
    }
}

/// Status well in the top bar (device / engine).
export component Inset inherits Rectangle {
    height: 36px;
    border-radius: 10px;
    background: T.well;
    border-width: 1px;
    border-color: #ffffff12;
    @children
}

/// Brand: app icon and wordmark.
export component BrandPlate inherits Rectangle {
    // app icon (the same tile as the desktop entry) + wordmark, no plate: the brand is
    // not a button. Compact: icon only.
    in property <bool> compact;
    width: row.preferred-width;
    height: 38px;
    row := HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Image {
                width: 34px;
                height: 34px;
                source: @image-url("art/icon-64.png");
            }
        }
        if !root.compact: VerticalLayout {
            alignment: center;
            spacing: -3px;
            Text {
                text: "Haze";
                color: T.silk;
                font-family: T.display;
                font-size: 22px;
                font-weight: 700;
                letter-spacing: 0.4px;
            }
            Text {
                text: "STUDIO";
                color: T.silk-2;
                font-family: T.display;
                font-size: 9.5px;
                font-weight: 700;
                letter-spacing: 2.6px;
            }
        }
    }
}

/// Latching key with a status dot (bypass, bright, variation, tap). On: accent-tinted.
export component LatchKey inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <bool> lamp: true;
    in property <color> c: T.accent;
    /// cap for narrow cells: the label elides past it
    in property <length> max-w: 10000px;
    callback clicked;
    width: Math.min(row.preferred-width + 24px, max-w);
    height: 32px;
    border-radius: 8px;
    background: on ? root.c.with-alpha(ta.has-hover ? 0.22 : 0.15)
        : ta.pressed ? #ffffff18 : ta.has-hover ? #ffffff10 : #ffffff08;
    border-width: 1px;
    border-color: on ? root.c.with-alpha(0.5) : #ffffff12;
    row := HorizontalLayout {
        x: 12px;
        width: parent.width - 24px;
        alignment: center;
        spacing: 7px;
        if root.lamp: VerticalLayout {
            alignment: center;
            Lamp { size: 9px; c: root.c; lit: root.on; }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            color: root.on ? T.text : ta.has-hover ? T.text : T.text-2;
            font-family: T.display;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.6px;
            overflow: elide;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Section caption: small uppercase, tracked, secondary.
export component Silk inherits Text {
    color: T.text-3;
    font-family: T.display;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

/// Setlist sheet: the one large card of its page, a hair lighter than the panels so the
/// running order reads first.
export component Paper inherits Rectangle {
    background: @linear-gradient(180deg, #1D1F24 0%, #18191D 100%);
    border-radius: 14px;
    border-width: 1px;
    border-color: #ffffff12;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000080;
    @children
}

/// Card surface: cards, menus, side panels.
export component Plate inherits Rectangle {
    border-radius: 12px;
    background: @linear-gradient(180deg, #1C1D22 0%, #17181C 100%);
    border-width: 1px;
    border-color: #ffffff10;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #00000080;
    @children
}
