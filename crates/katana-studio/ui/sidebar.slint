// Library sidebar in the style of a compact browser sidebar: a narrow rail with shortcut tiles
// (favourite tones) and collection icons that expands over the stage while hovered, or stays
// open when pinned.
import { ListView } from "std-widgets.slint";
import { T } from "theme.slint";
import { SearchField, Icon, Icons } from "widgets.slint";
import { LedImg } from "rig.slint";

export struct ToneRow {
    id: string,
    name: string,
    amp: string,
    fx: string,
    fav: bool,
    live: bool,
    leds: [int],
}

export struct NavItem {
    id: string,
    name: string,
    count: int,
    kind: int, // 0 library, 1 favourites, 2 setlist, 3 amp backup, 4 header
}

/// Shortcut tile: a favourite tone.
export struct Essential {
    id: string,
    name: string,
    abbr: string,
    color: color,
    live: bool,
    selected: bool,
}

export global SidebarMetrics {
    out property <length> rail: 64px;
    out property <length> open: 260px;
}

component Tile inherits Rectangle {
    in property <Essential> e;
    in property <length> size: 40px;
    in property <bool> show-name;
    callback clicked;
    width: size;
    height: show-name ? size + 22px : size;
    // shortcut tile: aluminium chip, amp-family stripe, mono initials
    sq := Rectangle {
        y: 0;
        width: root.size;
        height: root.size;
        border-radius: 6px;
        clip: true;
        background: T.panel;
        Rectangle {
            y: 0;
            height: 3px;
            background: e.color;
        }
        Text {
            y: (parent.height + 3px - self.height) / 2;
            text: e.abbr;
            color: ta.has-hover || e.selected ? T.text : T.text-2;
            font-family: T.mono;
            font-weight: 700;
            font-size: root.size * 0.34;
        }
        if e.live: LedImg {
            x: parent.width - 15px;
            y: -1px;
            width: 16px;
            height: 16px;
            state: 2;
        }
    }
    Rectangle {
        y: 0;
        width: root.size;
        height: root.size;
        border-radius: 6px;
        border-width: 1px;
        border-color: e.selected ? T.accent : ta.has-hover ? T.line-hi : T.line;
    }
    if show-name: Text {
        y: root.size + 6px;
        width: root.width + 10px;
        x: -5px;
        text: e.name;
        horizontal-alignment: center;
        overflow: elide;
        color: e.selected ? T.text : T.text-2;
        font-size: 10.5px;
    }
    ta := TouchArea {
        y: 0;
        height: root.size;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component RailIcon inherits Rectangle {
    in property <string> icon;
    in property <bool> active;
    callback clicked;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: active ? T.line : ta.has-hover ? T.panel : transparent;
    Icon {
        d: icon;
        size: 20px;
        tint: active ? T.text : ta.has-hover ? T.text : T.text-3;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component NavRow inherits Rectangle {
    in property <NavItem> item;
    in property <bool> selected;
    callback clicked;
    height: item.kind < 2 ? 0px : item.kind == 4 ? 34px : 36px;
    visible: item.kind >= 2;
    border-radius: 8px;
    background: item.kind == 4 ? transparent : selected ? T.line : ta.has-hover ? T.panel : transparent;
    if item.kind == 4: Text {
        x: 12px;
        text: item.name;
        color: T.text-3;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: bottom;
        height: parent.height - 7px;
    }
    if item.kind != 4: HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                d: item.kind == 3 ? Icons.backup : Icons.setlist;
                size: 16px;
                tint: root.selected ? T.text : T.text-3;
            }
        }
        Text {
            text: item.name;
            color: T.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: item.count;
            color: T.text-3;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: item.kind >= 2 && item.kind != 4;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ToneItem inherits Rectangle {
    in property <ToneRow> tone;
    in property <bool> selected;
    callback clicked;
    callback activated;
    callback fav;
    height: 50px;
    border-radius: T.r;
    background: selected ? T.panel-hi : ta.has-hover ? T.panel : transparent;
    if selected: Rectangle { x: 0; y: 8px; width: 2px; height: parent.height - 16px; background: T.accent; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.activated(); }
    }
    VerticalLayout {
        padding-left: 10px;
        padding-right: 32px;
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: tone.name;
                color: root.selected ? T.text : #C9CDD6;
                font-size: 13px;
                font-weight: root.selected ? 600 : 500;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if tone.live: VerticalLayout {
                alignment: center;
                LedImg {
                    width: 14px;
                    height: 14px;
                    state: 2;
                }
            }
        }
        HorizontalLayout {
            spacing: 0px;
            Text {
                text: tone.amp;
                color: T.text-2;
                font-family: T.mono;
                font-size: 10.5px;
                horizontal-stretch: 0;
                vertical-alignment: center;
            }
            Text {
                text: tone.fx != "" ? "  ·  " + tone.fx : "";
                color: T.text-3;
                font-size: 11px;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
        }
    }
    if tone.fav || ta.has-hover: Rectangle {
        x: parent.width - 30px;
        width: 24px;
        Icon {
            d: Icons.star;
            size: 15px;
            filled: tone.fav;
            tint: tone.fav ? T.accent : fta.has-hover ? T.text-2 : T.text-3;
        }
        fta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.fav(); }
        }
    }
}

/// Text tab with an underline, same language as the inspector's section tabs.
component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <string> chevron;
    callback clicked;
    width: row.preferred-width;
    row := HorizontalLayout {
        spacing: 4px;
        Text {
            text: root.text;
            color: active ? T.text : ta.has-hover ? T.text-2 : T.text-3;
            font-size: 13px;
            font-weight: active ? 600 : 400;
            vertical-alignment: center;
        }
        if chevron != "": VerticalLayout {
            alignment: center;
            Icon { d: chevron; size: 13px; tint: active ? T.text-2 : T.text-3; }
        }
    }
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: active ? T.accent : transparent;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component LibrarySidebar inherits Rectangle {
    in property <[NavItem]> nav;
    in property <string> nav-selected;
    in property <string> nav-title;
    in property <[ToneRow]> tones;
    in property <int> selected-index: -1;
    in property <[Essential]> essentials;
    in property <bool> connected;
    in property <string> tag;
    in-out property <bool> pinned;
    callback tag-picked(string);
    callback search(string);
    callback nav-clicked(string);
    callback tone-clicked(int);
    callback tone-activated(int);
    callback tone-fav(int);
    callback essential-clicked(string);

    property <bool> show-sets;
    property <bool> in-set: nav-selected != "all" && nav-selected != "fav";
    // open while hovered, pinned, or while the search field holds focus (typing with the mouse away)
    out property <bool> expanded: pinned || hover.has-hover || sf.focused;

    width: expanded ? SidebarMetrics.open : SidebarMetrics.rail;
    animate width { duration: 170ms; easing: ease-out; }
    background: T.chrome;
    border-width: 0;
    drop-shadow-blur: expanded && !pinned ? 36px : 0;
    drop-shadow-offset-x: 8px;
    drop-shadow-color: #000000b0;
    clip: true;

    // right hairline only while floating over the stage
    if expanded && !pinned: Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: T.line;
    }

    hover := TouchArea {
        // ---------------------------------------------------- rail (collapsed)
        if !expanded: VerticalLayout {
            width: SidebarMetrics.rail;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 8px;
            alignment: start;
            for e in essentials: HorizontalLayout {
                alignment: center;
                Tile {
                    e: e;
                    clicked => { essential-clicked(e.id); }
                }
            }
            HorizontalLayout {
                alignment: center;
                padding-top: 4px;
                padding-bottom: 4px;
                Rectangle {
                    width: 28px;
                    height: 1px;
                    background: T.line;
                }
            }
            HorizontalLayout {
                alignment: center;
                RailIcon {
                    icon: Icons.library;
                    active: nav-selected == "all";
                    clicked => { nav-clicked("all"); }
                }
            }
            HorizontalLayout {
                alignment: center;
                RailIcon {
                    icon: Icons.star;
                    active: nav-selected == "fav";
                    clicked => { nav-clicked("fav"); }
                }
            }
            HorizontalLayout {
                alignment: center;
                RailIcon {
                    icon: Icons.setlist;
                    active: in-set;
                    clicked => { show-sets = true; }
                }
            }
            HorizontalLayout {
                alignment: center;
                RailIcon {
                    icon: Icons.search;
                    clicked => { sf.focus-input(); }
                }
            }
        }

        // ---------------------------------------------------- panel (expanded)
        VerticalLayout {
            x: 0;
            width: SidebarMetrics.open;
            opacity: expanded ? 1 : 0;
            visible: root.width > SidebarMetrics.rail + 40px;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 4px;
            padding-bottom: 10px;
            spacing: 10px;
            // search + pin
            HorizontalLayout {
                height: 36px;
                spacing: 6px;
                sf := SearchField {
                    horizontal-stretch: 1;
                    height: 36px;
                    edited(q) => {
                        show-sets = false;
                        search(q);
                    }
                }
                Rectangle {
                    width: 36px;
                    border-radius: 8px;
                    background: pin.has-hover ? T.line : transparent;
                    Icon {
                        d: Icons.panel;
                        size: 18px;
                        tint: root.pinned ? T.accent : pin.has-hover ? T.text-2 : T.text-3;
                    }
                    pin := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.pinned = !root.pinned; }
                    }
                }
            }
            // collections
            Rectangle {
                height: 34px;
                HorizontalLayout {
                    padding-left: 4px;
                    spacing: 18px;
                    alignment: start;
                    Tab {
                        text: "Wszystkie";
                        active: nav-selected == "all" && !show-sets;
                        clicked => {
                            show-sets = false;
                            nav-clicked("all");
                        }
                    }
                    Tab {
                        text: "Ulubione";
                        active: nav-selected == "fav" && !show-sets;
                        clicked => {
                            show-sets = false;
                            nav-clicked("fav");
                        }
                    }
                    Tab {
                        text: in-set && !show-sets ? nav-title : "Setlisty";
                        chevron: show-sets ? Icons.chevron-up : Icons.chevron-down;
                        active: in-set || show-sets;
                        clicked => { show-sets = !show-sets; }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: T.line;
                }
            }
            // tone tags
            if !show-sets: Rectangle {
                height: 2 * 24px + 4px;
                for t[i] in [{ id: "", n: "ALL" }, { id: "clean", n: "CLEAN" }, { id: "crunch", n: "CRUNCH" },
                             { id: "hi-gain", n: "HI-GAIN" }, { id: "ambient", n: "AMBIENT" }, { id: "lead", n: "LEAD" }]: Rectangle {
                    x: mod(i, 3) * (parent.width + 4px) / 3;
                    y: floor(i / 3) * 28px;
                    width: (parent.width - 8px) / 3;
                    height: 24px;
                    border-radius: 3px;
                    background: t.id == tag ? T.accent.with-alpha(0.12) : tga.has-hover ? T.hover : T.well;
                    border-width: 1px;
                    border-color: t.id == tag ? T.accent-lo : T.line;
                    Text {
                        text: t.n;
                        color: t.id == tag ? T.accent-hi : T.text-2;
                        font-family: T.mono;
                        font-size: 10px;
                        font-weight: 600;
                        letter-spacing: 0.8px;
                    }
                    tga := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { tag-picked(t.id); }
                    }
                }
            }
            // shortcuts
            if essentials.length > 0 && !show-sets: VerticalLayout {
                vertical-stretch: 0;
                alignment: start;
                spacing: 8px;
                Text {
                    text: "SKRÓTY";
                    color: T.text-3;
                    font-family: T.mono;
                    letter-spacing: 1px;
                    font-size: 10px;
                    font-weight: 600;
                }
                Rectangle {
                    height: ceil(essentials.length / 4) * 72px;
                    for e[i] in essentials: Tile {
                        x: mod(i, 4) * 59px + 2px;
                        y: floor(i / 4) * 78px;
                        size: 46px;
                        show-name: true;
                        e: e;
                        clicked => { essential-clicked(e.id); }
                    }
                }
            }
            // setlists folder (inline, so the panel never loses hover to a popup)
            if show-sets: Rectangle {
                vertical-stretch: 1;
                ListView {
                    for item in nav: NavRow {
                        item: item;
                        selected: item.id == nav-selected;
                        clicked => {
                            nav-clicked(item.id);
                            show-sets = false;
                        }
                    }
                }
            }
            if !show-sets: Rectangle {
                vertical-stretch: 1;
                ListView {
                    for tone[i] in tones: ToneItem {
                        tone: tone;
                        selected: i == selected-index;
                        clicked => { tone-clicked(i); }
                        activated => { tone-activated(i); }
                        fav => { tone-fav(i); }
                    }
                }
                if tones.length == 0: Text {
                    width: parent.width - 24px;
                    text: nav-selected == "fav" ? "Nie masz jeszcze ulubionych. Oznacz brzmienie gwiazdką." : "Brak brzmień. Zaimportuj je z menu w prawym górnym rogu.";
                    wrap: word-wrap;
                    color: T.text-3;
                    horizontal-alignment: center;
                }
            }
            if !show-sets: Text {
                text: "  " + (tones.length == 1 ? "1 brzmienie" : tones.length + " brzmień");
                color: T.text-3;
                font-size: 12px;
            }
        }
    }
}
