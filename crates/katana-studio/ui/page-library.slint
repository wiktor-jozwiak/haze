import { T } from "theme.slint";
import { SearchField, Icons } from "widgets.slint";
import { ToneRow, Chip, LibraryGrid } from "library.slint";
import { ModeBtn, Well, ToolBtn, Menu, MenuItem } from "parts.slint";
import { EmptyState } from "art.slint";
import { Btn } from "widgets.slint";

/// Library page: All/Favorites, search, style chips, toolbar and the preset card grid.
export component LibraryPage inherits VerticalLayout {
    in property <string> nav-selected;
    in property <[ToneRow]> tones;
    in property <int> selected-index;
    in property <string> tag;
    in property <bool> connected;
    in property <[string]> user-tags;
    /// 0 name, 1 recently edited, 2 amp
    in property <int> sort;
    callback sort-picked(int);
    in-out property <string> query;
    callback nav-clicked(string);
    callback search(string);
    callback tag-picked(string);
    callback import-request();
    callback backup-amp();
    callback export-list();
    callback tone-clicked(int);
    callback tone-opened(int);
    callback tone-fav(int);
    callback tone-add(int);

    padding-top: 6px;
    spacing: 12px;
    // row 1: scope, search, then the few page actions (rare ones behind "…")
    bar := HorizontalLayout {
        height: 36px;
        spacing: 10px;
        Well {
            width: lib-seg.preferred-width + 6px;
            lib-seg := HorizontalLayout {
                x: 3px;
                y: 3px;
                height: 30px;
                spacing: 2px;
                ModeBtn {
                    text: "All";
                    led: T.accent;
                    active: nav-selected == "all";
                    clicked => { nav-clicked("all"); }
                }
                ModeBtn {
                    text: "Favorites";
                    led: T.accent;
                    active: nav-selected == "fav";
                    clicked => { nav-clicked("fav"); }
                }
            }
        }
        SearchField {
            width: 320px;
            height: 36px;
            text <=> root.query;
            edited(q) => { search(q); }
        }
        Rectangle { horizontal-stretch: 1; }
        sort-btn := ToolBtn {
            text: ["Sort: Name", "Sort: Recent", "Sort: Amp"][sort];
            icon: Icons.chevron-down;
            enabled: nav-selected == "all" || nav-selected == "fav";
            clicked => { sort-menu.show(); }
        }
        ToolBtn {
            text: "Import";
            icon: Icons.import;
            clicked => { import-request(); }
        }
        more-btn := ToolBtn {
            icon: Icons.more;
            tip: "Back up amp, export list";
            clicked => { more-menu.show(); }
        }
    }
    // row 2: style chips, the user's #tags, result count
    HorizontalLayout {
        height: 28px;
        spacing: 12px;
        Flickable {
            horizontal-stretch: 1;
            content-width: chips.preferred-width;
            interactive: chips.preferred-width > self.width;
            chips := HorizontalLayout {
                spacing: 6px;
                for t in [{ id: "", n: "All tones" }, { id: "clean", n: "Clean" }, { id: "crunch", n: "Crunch" },
                          { id: "lead", n: "Lead" }, { id: "hi-gain", n: "Hi-Gain" }, { id: "ambient", n: "Ambient" }]: Chip {
                    text: t.n;
                    active: t.id == tag;
                    clicked => { tag-picked(t.id); }
                }
                if user-tags.length > 0: Rectangle {
                    width: 13px;
                    Rectangle { x: 6px; y: 6px; width: 1px; height: parent.height - 12px; background: #ffffff14; }
                }
                for u in user-tags: Chip {
                    text: "#" + u;
                    active: "#" + u == tag;
                    clicked => { tag-picked("#" + u); }
                }
            }
        }
        Text {
            text: tones.length == 1 ? "1 preset" : tones.length + " presets";
            color: T.text-3;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }
    sort-menu := PopupWindow {
        x: sort-btn.x;
        y: 44px;
        width: 210px;
        height: 3 * 36px + 12px;
        Menu {
            VerticalLayout {
                padding: 6px;
                for o[i] in ["Name", "Recently edited", "Amp type"]: MenuItem {
                    text: (i == sort ? "✓  " : "     ") + o;
                    clicked => { sort-picked(i); }
                }
            }
        }
    }
    more-menu := PopupWindow {
        x: more-btn.x + more-btn.width - 220px;
        y: 44px;
        width: 220px;
        height: 2 * 36px + 12px;
        Menu {
            VerticalLayout {
                padding: 6px;
                MenuItem {
                    text: "Back up amp channels";
                    enabled: connected;
                    clicked => { backup-amp(); }
                }
                MenuItem {
                    text: "Export list…";
                    clicked => { export-list(); }
                }
            }
        }
    }
    Rectangle {
        vertical-stretch: 1;
        LibraryGrid {
            tones: tones;
            selected-index: selected-index;
            clicked(i) => { tone-clicked(i); }
            opened(i) => { tone-opened(i); }
            fav(i) => { tone-fav(i); }
            add(i) => { tone-add(i); }
        }
        if tones.length == 0 && (query != "" || tag != ""): EmptyState {
            art: 2;
            title: "Nothing matches";
            body: "No preset fits this search or filter. Try fewer words, or clear the filter.";
            Btn {
                text: "Clear search and filter";
                clicked => {
                    query = "";
                    search("");
                    tag-picked("");
                }
            }
        }
        if tones.length == 0 && query == "" && tag == "" && nav-selected == "fav": EmptyState {
            art: 3;
            title: "No favorites yet";
            body: "Star a preset (the ☆ on its card or next to its name on the Rig) and it shows up here and in the quick picker.";
            Btn {
                text: "Show all presets";
                clicked => { nav-clicked("all"); }
            }
        }
        if tones.length == 0 && query == "" && tag == "" && nav-selected != "fav": EmptyState {
            art: 0;
            title: "Your library is empty";
            body: "Import your presets from BOSS Tone Studio or a .tsl file, back up the amp's channels, or add a starter rig.";
            Btn {
                primary: true;
                text: "Import presets";
                clicked => { import-request(); }
            }
            Btn {
                text: "Back up amp";
                enabled: connected;
                clicked => { backup-amp(); }
            }
        }
    }
}
