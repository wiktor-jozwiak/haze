// Boutique amp: black tolex, brushed gunmetal faceplates, cream silk-screen lettering, 1px hairlines,
// one accent LED colour that follows the engine mode (amber = Katana over USB-MIDI,
// cyan = standalone PC DSP). Flat fills only: the CPU renderer never shades per frame.
export global T {
    /// true: HARDWARE (Katana USB-MIDI), false: STANDALONE (PC DSP engine). Set from Rust.
    in-out property <bool> hw: true;

    // surfaces
    out property <color> bg: #131211;
    out property <color> bg-side: #0D0C0C;
    out property <color> chrome: #0D0C0C;
    out property <color> panel: #1A1918;
    out property <color> panel-hi: #22201F;
    out property <color> well: #100F0E;
    out property <color> hover: #2B2927;
    out property <color> line: #282624;
    out property <color> line-hi: #35322F;

    // mode LEDs
    out property <color> cyan: #00E5FF;
    out property <color> amber: #FF9F1C;
    out property <color> accent: hw ? amber : cyan;
    out property <color> accent-hi: hw ? #FFB955 : #6CF0FF;
    out property <color> accent-lo: hw ? #7A4E14 : #00616D;
    out property <color> accent-ink: #0D0E11;

    // text: text-2 / text-3 keep WCAG AA (>= 4.5:1) on every surface up to `hover`;
    // text-off is only for disabled controls (exempt from contrast rules)
    out property <color> text: #EEEAE3;
    out property <color> text-2: #ADA79D;
    out property <color> text-3: #98928A;
    out property <color> text-off: #5E5953;
    // silk-screen print on hardware faces (amp panel, header): warm cream like real amp lettering
    out property <color> silk: #E8DDC6;
    out property <color> silk-2: #A89F8C;

    // status LEDs
    out property <color> led-green: #38E07B;
    out property <color> led-red: #FF3B4E;
    out property <color> led-yellow: #FFC23A;
    out property <color> danger: #FF4D5E;

    // all three faces ship inside the binary (fonts/, imported in main.slint): same look on every system
    out property <string> display: "Barlow Semi Condensed";
    out property <string> mono: "JetBrains Mono";
    out property <length> r: 8px;
    out property <length> r-card: 12px;

    /// block colour of BOOSTER, MOD, FX, DELAY, REVERB (summary LED order)
    public pure function fx(i: int) -> color {
        if i == 0 { return #FF6B3D; }
        if i == 1 { return #4C8DFF; }
        if i == 2 { return #A070FF; }
        if i == 3 { return #2FD69A; }
        return #3FC8E0;
    }

    /// amp drive scale: 0 acoustic, 1 clean, 2 pushed, 3 crunch, 4 lead, 5 high gain
    public pure function drive(d: int) -> color {
        if d <= 0 { return #C89B6A; }
        if d == 1 { return #6FB7FF; }
        if d == 2 { return #4FD1A5; }
        if d == 3 { return #FFC23A; }
        if d == 4 { return #FF8A3D; }
        return #FF4D5E;
    }

    public pure function led(state: int) -> color {
        if state == 1 { return led-green; }
        if state == 2 { return led-red; }
        if state == 3 { return led-yellow; }
        return #2A2D35;
    }
}
