import { T } from "theme.slint";
import { Paper, Silk } from "gear.slint";
import { Icon, Icons } from "widgets.slint";
import { ToneRow, FxSig } from "library.slint";
import { AmpBadge, Drive } from "art.slint";

/// Stage footswitch: hex nut, domed chrome cap, silk label underneath.
component BigStep inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;
    width: 96px;
    height: 128px;
    opacity: enabled ? 1 : 0.35;
    Rectangle {
        y: 0;
        width: 96px;
        height: 96px;
        border-radius: 48px;
        background: @radial-gradient(circle, #2A2A2C 0%, #0E0E0F 100%);
        border-width: 1px;
        border-color: #ffffff14;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000;
        Rectangle {
            width: 74px;
            height: 74px;
            border-radius: 37px;
            background: @radial-gradient(circle, #DADDE2 0%, #8D9199 60%, #4C5057 100%);
            border-width: 1px;
            border-color: #000000;
            Rectangle {
                width: ta.pressed ? 48px : 54px;
                height: self.width;
                border-radius: self.width / 2;
                background: ta.pressed
                    ? @linear-gradient(135deg, #8A8F98 0%, #D0D3D8 100%)
                    : @linear-gradient(135deg, #FAFBFC 0%, #BFC3CA 50%, #737881 100%);
                border-width: 1px;
                border-color: #2E3036;
                Icon {
                    d: root.icon;
                    size: 26px;
                    tint: #2B2E33;
                }
            }
        }
    }
    Silk {
        y: 104px;
        width: parent.width;
        horizontal-alignment: center;
        text: root.label;
        color: ta.has-hover && enabled ? T.silk : T.silk-2;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Stage view: the current song huge, the next one underneath. Arrow keys, PageUp/PageDown
/// (USB page-turner pedals send those) and the big buttons step through the list; Esc leaves.
export component LiveView inherits Rectangle {
    in property <[ToneRow]> tones;
    in property <int> selected-index;
    in property <string> list-name;
    in property <bool> connected;
    callback step(int);
    callback close();
    property <bool> has: selected-index >= 0 && selected-index < tones.length;
    property <bool> has-next: selected-index + 1 < tones.length;

    background: #070707;
    TouchArea { }
    // spotlight on the song
    Rectangle {
        x: parent.width * 0.5 - self.width / 2;
        y: parent.height * 0.44 - self.height / 2;
        width: Math.min(parent.width * 0.9, 1200px);
        height: self.width * 0.62;
        border-radius: self.width / 2;
        background: @radial-gradient(circle, #FFE7B81f 0%, #FFE7B80a 40%, #FFE7B800 70%);
    }
    fs := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.close();
                return accept;
            }
            if e.text == Key.RightArrow || e.text == Key.DownArrow || e.text == Key.PageDown || e.text == " " {
                root.step(1);
                return accept;
            }
            if e.text == Key.LeftArrow || e.text == Key.UpArrow || e.text == Key.PageUp {
                root.step(-1);
                return accept;
            }
            reject
        }
    }

    // ---- top strip: list name, position, exit
    Text {
        x: 40px;
        y: 30px;
        text: root.list-name.to-uppercase();
        color: T.silk-2;
        font-family: T.display;
        font-size: 17px;
        font-weight: 700;
        letter-spacing: 1.5px;
    }
    Text {
        x: (parent.width - self.width) / 2;
        y: 26px;
        text: root.has ? (selected-index + 1) + " / " + tones.length : tones.length + " presets";
        color: T.text-2;
        font-family: T.mono;
        font-size: 20px;
        font-weight: 700;
    }
    Rectangle {
        x: parent.width - self.width - 32px;
        y: 22px;
        width: et.preferred-width + 30px;
        height: 34px;
        border-radius: 6px;
        background: eta.has-hover ? @linear-gradient(180deg, #3A3734 0%, #201E1C 100%) : @linear-gradient(180deg, #2E2B28 0%, #1A1917 100%);
        border-width: 1px;
        border-color: #000000c0;
        et := Text {
            text: "EXIT LIVE  ·  ESC";
            color: T.silk;
            font-family: T.display;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1px;
        }
        eta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.close(); }
        }
    }

    // ---- current song
    VerticalLayout {
        x: 140px;
        width: parent.width - 280px;
        y: 0;
        height: parent.height;
        alignment: center;
        spacing: 18px;
        Text {
            text: root.has ? (selected-index + 1 < 10 ? "0" : "") + (selected-index + 1) : "—";
            horizontal-alignment: center;
            color: T.accent;
            font-family: T.mono;
            font-size: 40px;
            font-weight: 700;
        }
        Text {
            text: root.has ? tones[selected-index].name : "Press → to start";
            horizontal-alignment: center;
            wrap: word-wrap;
            color: T.silk;
            font-family: T.display;
            font-size: Math.min(120px, Math.max(56px, root.width / 14));
            font-weight: 800;
        }
        Text {
            text: root.has ? tones[selected-index].amp + (tones[selected-index].fx == "" ? "" : "   ·   " + tones[selected-index].fx) : "";
            horizontal-alignment: center;
            overflow: elide;
            color: T.text-2;
            font-size: 20px;
        }
        HorizontalLayout {
            alignment: center;
            height: 52px;
            spacing: 22px;
            if root.has: VerticalLayout {
                alignment: center;
                spacing: 6px;
                HorizontalLayout {
                    alignment: center;
                    AmpBadge {
                        width: 52px;
                        meter: false;
                        drive: tones[selected-index].drive;
                    }
                }
                Text {
                    text: Drive.names[tones[selected-index].drive];
                    horizontal-alignment: center;
                    color: T.drive(tones[selected-index].drive);
                    font-family: T.display;
                    font-size: 12px;
                    font-weight: 700;
                }
            }
            if root.has: VerticalLayout {
                alignment: center;
                FxSig {
                    h: 40px;
                    labels: true;
                    leds: tones[selected-index].leds;
                }
            }
        }
        Rectangle { height: 8px; }
        if root.has && tones[selected-index].live: Text {
            text: "● On amp";
            horizontal-alignment: center;
            color: T.led-red;
            font-size: 15px;
            font-weight: 700;
        }
        if root.has && !tones[selected-index].live && connected: Text {
            text: "Sending to amp…";
            horizontal-alignment: center;
            color: T.text-3;
            font-size: 15px;
        }
    }

    BigStep {
        x: 32px;
        y: (parent.height - self.height) / 2;
        icon: Icons.chevron-left;
        label: "PREV";
        enabled: root.has && selected-index > 0;
        clicked => {
            root.step(-1);
            fs.focus();
        }
    }
    BigStep {
        x: parent.width - self.width - 32px;
        y: (parent.height - self.height) / 2;
        icon: Icons.chevron-right;
        label: "NEXT";
        enabled: root.has-next;
        clicked => {
            root.step(1);
            fs.focus();
        }
    }

    // ---- next up: a strip of paper taped to the floor
    Paper {
        x: 40px;
        y: parent.height - 92px;
        width: Math.min(parent.width - 80px, nx.preferred-width + 160px);
        height: 62px;
        HorizontalLayout {
            padding-left: 26px;
            padding-right: 26px;
            spacing: 18px;
            Text {
                text: "NEXT";
                color: #7A7264;
                font-family: T.mono;
                font-size: 14px;
                font-weight: 700;
                letter-spacing: 2px;
                vertical-alignment: center;
            }
            nx := Text {
                text: root.has-next ? tones[selected-index + 1].name.to-uppercase() : "END OF LIST";
                color: root.has-next ? #191715 : #7A7264;
                font-family: T.display;
                font-size: 30px;
                font-weight: 700;
                letter-spacing: 0.8px;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }
    Text {
        x: parent.width - self.width - 40px;
        y: parent.height - 70px;
        text: "← → / PgUp PgDn";
        color: T.silk-2;
        font-size: 13px;
    }
}
