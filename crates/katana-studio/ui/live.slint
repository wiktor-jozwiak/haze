import { T } from "theme.slint";
import { Icon, Icons } from "widgets.slint";
import { ToneRow } from "library.slint";

component BigStep inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked;
    width: 88px;
    height: 88px;
    border-radius: 44px;
    background: !enabled ? transparent : ta.pressed ? T.accent-lo : ta.has-hover ? T.hover : T.panel;
    border-width: 1px;
    border-color: T.line-hi;
    Icon {
        d: root.icon;
        size: 40px;
        tint: enabled ? T.text : T.text-off;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Stage view: the current song huge, the next one underneath. Arrow keys, PageUp/PageDown
/// (USB page-turner pedals send those) and the big buttons step through the list; Esc leaves.
export component LiveView inherits Rectangle {
    in property <[ToneRow]> tones;
    in property <int> selected-index;
    in property <string> list-name;
    in property <bool> connected;
    callback step(int);
    callback close();
    property <bool> has: selected-index >= 0 && selected-index < tones.length;
    property <bool> has-next: selected-index + 1 < tones.length;

    background: #08090B;
    TouchArea { }
    fs := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.close();
                return accept;
            }
            if e.text == Key.RightArrow || e.text == Key.DownArrow || e.text == Key.PageDown || e.text == " " {
                root.step(1);
                return accept;
            }
            if e.text == Key.LeftArrow || e.text == Key.UpArrow || e.text == Key.PageUp {
                root.step(-1);
                return accept;
            }
            reject
        }
    }

    // ---- top strip: list name, position, exit
    Text {
        x: 40px;
        y: 30px;
        text: root.list-name;
        color: T.text-2;
        font-size: 16px;
        font-weight: 600;
    }
    Text {
        x: (parent.width - self.width) / 2;
        y: 26px;
        text: root.has ? (selected-index + 1) + " / " + tones.length : tones.length + " presets";
        color: T.text-2;
        font-family: T.mono;
        font-size: 20px;
        font-weight: 700;
    }
    Rectangle {
        x: parent.width - self.width - 32px;
        y: 22px;
        width: et.preferred-width + 30px;
        height: 34px;
        border-radius: 17px;
        background: eta.has-hover ? T.hover : T.panel;
        et := Text {
            text: "Exit live  ·  Esc";
            color: T.text;
            font-size: 13px;
            font-weight: 600;
        }
        eta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.close(); }
        }
    }

    // ---- current song
    VerticalLayout {
        x: 140px;
        width: parent.width - 280px;
        y: 0;
        height: parent.height;
        alignment: center;
        spacing: 18px;
        Text {
            text: root.has ? (selected-index + 1 < 10 ? "0" : "") + (selected-index + 1) : "—";
            horizontal-alignment: center;
            color: T.accent;
            font-family: T.mono;
            font-size: 40px;
            font-weight: 700;
        }
        Text {
            text: root.has ? tones[selected-index].name : "Press → to start";
            horizontal-alignment: center;
            wrap: word-wrap;
            color: T.text;
            font-family: T.display;
            font-size: Math.min(120px, Math.max(56px, root.width / 14));
            font-weight: 800;
        }
        Text {
            text: root.has ? tones[selected-index].amp + (tones[selected-index].fx == "" ? "" : "   ·   " + tones[selected-index].fx) : "";
            horizontal-alignment: center;
            overflow: elide;
            color: T.text-2;
            font-size: 20px;
        }
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            height: 18px;
            if root.has: HorizontalLayout {
                spacing: 8px;
                for l[i] in tones[selected-index].leds: Rectangle {
                    width: 44px;
                    border-radius: 4px;
                    background: l > 0 ? T.fx(i) : #1E2127;
                }
            }
        }
        Rectangle { height: 8px; }
        if root.has && tones[selected-index].live: Text {
            text: "● On amp";
            horizontal-alignment: center;
            color: T.led-red;
            font-size: 15px;
            font-weight: 700;
        }
        if root.has && !tones[selected-index].live && connected: Text {
            text: "Sending to amp…";
            horizontal-alignment: center;
            color: T.text-3;
            font-size: 15px;
        }
    }

    BigStep {
        x: 32px;
        y: (parent.height - self.height) / 2;
        icon: Icons.chevron-left;
        enabled: root.has && selected-index > 0;
        clicked => {
            root.step(-1);
            fs.focus();
        }
    }
    BigStep {
        x: parent.width - self.width - 32px;
        y: (parent.height - self.height) / 2;
        icon: Icons.chevron-right;
        enabled: root.has-next;
        clicked => {
            root.step(1);
            fs.focus();
        }
    }

    // ---- next up
    Rectangle {
        x: 0;
        y: parent.height - 110px;
        width: parent.width;
        height: 1px;
        background: T.line;
    }
    HorizontalLayout {
        x: 40px;
        y: parent.height - 110px;
        width: parent.width - 80px;
        height: 110px;
        spacing: 18px;
        Text {
            text: "NEXT";
            color: T.text-3;
            font-family: T.mono;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 2px;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.has-next ? tones[selected-index + 1].name : "End of list";
            color: root.has-next ? T.text : T.text-3;
            font-size: 30px;
            font-weight: 700;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            text: "← → / PgUp PgDn";
            color: T.text-3;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
}
