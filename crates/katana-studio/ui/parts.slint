import { T } from "theme.slint";
import { Icon, Icons, Tip } from "widgets.slint";
import { Slot } from "types.slint";

// ---------------------------------------------------------------- small parts

export component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <bool> filled;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <string> tip;
    callback clicked;
    width: 34px;
    height: 34px;
    border-radius: T.r;
    background: active ? T.hover : ta.has-hover ? T.panel-hi : transparent;
    border-width: 1px;
    border-color: ta.has-hover || active ? T.line-hi : transparent;
    Icon {
        d: icon;
        filled: root.filled;
        size: 20px;
        tint: !enabled ? T.text-off : ta.has-hover || active ? T.text : T.text-2;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if ta.has-hover && tip != "": Tip {
        x: parent.width - self.width;
        y: parent.height + 6px;
        text: root.tip;
    }
}

export component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked;
    height: 36px;
    border-radius: 6px;
    background: ta.has-hover && enabled ? T.hover : transparent;
    Text {
        x: 14px;
        text: root.text;
        color: !enabled ? T.text-off : danger ? T.danger : T.text;
        vertical-alignment: center;
        height: parent.height;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Menu inherits Rectangle {
    background: T.panel-hi;
    border-radius: 6px;
    border-width: 1px;
    border-color: T.line-hi;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 10px;
    drop-shadow-color: #000000c0;
    @children
}

export component SlotChip inherits Rectangle {
    in property <Slot> slot;
    callback clicked;
    callback pull;
    callback push;
    height: 40px;
    border-radius: T.r;
    background: slot.current ? T.panel-hi : ta.has-hover ? T.panel : transparent;
    border-width: slot.current ? 1px : 0;
    border-color: T.accent-lo;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        Text {
            text: slot.label;
            color: slot.current ? T.accent-hi : T.text-3;
            font-family: T.mono;
            font-weight: 700;
            font-size: 10.5px;
            letter-spacing: 1px;
            vertical-alignment: center;
        }
        Text {
            text: slot.name;
            color: slot.current ? T.text : T.text-2;
            font-family: T.display;
            font-weight: 700;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if ta.has-hover: Rectangle {
            width: 16px;
            Icon { d: Icons.pull; size: 16px; tint: pa.has-hover ? T.text : T.text-3; y: (parent.height - 16px) / 2; }
            pa := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.pull(); }
            }
        }
        if ta.has-hover && slot.label != "PANEL": Rectangle {
            width: 16px;
            Icon { d: Icons.push; size: 16px; tint: wa.has-hover ? T.text : T.text-3; y: (parent.height - 16px) / 2; }
            wa := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.push(); }
            }
        }
    }
}

// ---------------------------------------------------------------- top bar parts

/// One half of the [ Hardware | Standalone ] segmented control.
export component ModeBtn inherits Rectangle {
    in property <string> text;
    in property <color> led;
    in property <bool> active;
    in property <string> tip;
    callback clicked;
    width: row.preferred-width + 28px;
    border-radius: 7px;
    background: active ? T.hover : ta.has-hover ? T.panel-hi : transparent;
    row := HorizontalLayout {
        x: 14px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: active ? led : #2A2D35;
            }
        }
        Text {
            text: root.text;
            color: active ? T.text : T.text-2;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if ta.has-hover && tip != "": Tip {
        x: 0;
        y: parent.height + 8px;
        text: root.tip;
    }
}

/// Small segmented option (buffer size, sample rate, A/B, in-pill actions).
export component Pick inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked;
    width: Math.min(t.preferred-width + 16px, self.max-width);
    height: 26px;
    border-radius: 3px;
    background: active ? T.accent : ta.has-hover && enabled ? T.hover : transparent;
    t := Text {
        x: 8px;
        width: parent.width - 16px;
        horizontal-alignment: center;
        overflow: elide;
        text: root.text;
        color: !enabled ? T.text-off : active ? T.accent-ink : T.text;
        font-weight: 600;
        font-size: 12px;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Recessed well grouping top-bar controls.
export component Well inherits Rectangle {
    height: 36px;
    border-radius: 10px;
    background: T.panel;
}

export component PillDivider inherits Rectangle {
    width: 1px;
    background: T.line-hi;
}

/// Peak meter with clip LED.
export component Meter inherits Rectangle {
    in property <string> label;
    in property <float> level; // 0..1 peak
    in property <bool> clipped;
    width: 48px;
    height: 36px;
    Text {
        x: 0;
        y: 5px;
        text: root.label;
        color: T.text-2;
        font-size: 10.5px;
        font-weight: 600;
    }
    Rectangle {
        x: parent.width - 6px;
        y: 7px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: clipped ? T.led-red : #2A2D35;
    }
    Rectangle {
        x: 0;
        y: 22px;
        width: parent.width;
        height: 6px;
        border-radius: 1px;
        background: T.panel-hi;
        Rectangle {
            x: 1px;
            y: 1px;
            height: 4px;
            width: (parent.width - 2px) * clamp(root.level, 0, 1);
            background: root.level > 0.89 ? T.led-red : root.level > 0.7 ? T.led-yellow : T.accent;
        }
    }
}

export component SettingsRow inherits HorizontalLayout {
    in property <string> label;
    spacing: 10px;
    height: 30px;
    Text {
        width: 96px;
        text: root.label;
        color: T.text-2;
        font-size: 12px;
        vertical-alignment: center;
    }
    @children
}

/// Top-level page tab (Rig / Library / Setlists).
export component PageTab inherits Rectangle {
    in property <string> text;
    in property <string> badge;
    in property <bool> active;
    callback clicked;
    property <length> badge-w: badge == "" ? 0px : badge.character-count * 7px + 12px;
    width: lbl.preferred-width + 28px + (badge == "" ? 0px : badge-w + 7px);
    height: 36px;
    border-radius: 9px;
    background: active ? T.panel-hi : ta.has-hover ? T.panel : transparent;
    lbl := Text {
        x: 14px;
        text: root.text;
        color: active ? T.text : ta.has-hover ? T.text : T.text-2;
        font-size: 13.5px;
        font-weight: 600;
        vertical-alignment: center;
    }
    if badge != "": Rectangle {
        x: 14px + lbl.preferred-width + 7px;
        width: root.badge-w;
        height: 18px;
        border-radius: 9px;
        background: active ? T.hover : T.panel-hi;
        Text {
            text: root.badge;
            color: T.text-2;
            font-size: 11px;
            font-weight: 600;
        }
    }
    // active marker under the label
    if active: Rectangle {
        x: 14px;
        y: parent.height - 3px;
        width: parent.width - 28px;
        height: 2px;
        border-radius: 1px;
        background: T.accent;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Text + icon toolbar button (page toolbars).
export component ToolBtn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked;
    width: row.preferred-width + 26px;
    height: 36px;
    border-radius: 10px;
    background: !enabled ? transparent : ta.has-hover ? T.hover : T.panel;
    border-width: enabled ? 0 : 1px;
    border-color: T.line;
    row := HorizontalLayout {
        x: 12px;
        spacing: 7px;
        if icon != "": VerticalLayout {
            alignment: center;
            Icon { d: root.icon; size: 16px; tint: enabled ? T.text-2 : T.text-off; }
        }
        Text {
            text: root.text;
            color: enabled ? T.text : T.text-off;
            font-size: 12.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
