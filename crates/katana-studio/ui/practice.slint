// Status bar under every page: the Practice page key, looper and drum state, the engine
// requirement, the tuner readout and the Space hint. The practice tools themselves live on
// their own page (`page-practice.slint`).
import { T } from "theme.slint";
import { Lamp } from "gear.slint";

component Caption inherits Text {
    color: T.text-2;
    font-size: 12px;
    vertical-alignment: center;
}

export component PracticeDrawer inherits Rectangle {
    /// the Practice page is showing
    in property <bool> open;
    in property <bool> engine;
    // looper: 0 empty, 1 rec, 2 play, 3 dub, 4 stopped
    in property <int> loop-state;
    in property <string> loop-time;
    in property <bool> drum-on;
    in property <int> bpm: 100;
    /// looper request on hold: 0 none, 1 waiting for the bar line, 2 counting in
    in property <int> loop-wait;
    // chromatic tuner readout (PC engine), shown in the status bar
    in property <bool> show-tuner;
    in property <string> tuner-note;
    in property <float> tuner-cents;
    in property <bool> tuner-active;
    /// the Practice key: open the page (or go back to the rig from it)
    callback toggled(bool);
    /// hardware mode: switch to the PC engine so the practice tools can run
    callback engine-request();

    property <length> bar-h: 34px;
    property <bool> badge: !engine && !open;
    // fixed band in the stage column: layouts honour min/max, not a bare height
    min-height: bar-h;
    max-height: self.min-height;
    vertical-stretch: 0;
    background: transparent;

    // ---------------------------------------------------------------- status bar
    Rectangle {
        y: 0;
        height: bar-h;
        HorizontalLayout {
            padding-top: 4px;
            padding-bottom: 2px;
            spacing: 12px;
            // drawer toggle: a real button, not a caption
            Rectangle {
                width: 118px;
                border-radius: 8px;
                background: open ? #ffffff14
                    : hta.has-hover ? #ffffff10 : #ffffff08;
                border-width: 1px;
                border-color: #ffffff12;
                pl := HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Text {
                        text: open ? "◂" : "♩";
                        color: open ? T.accent-hi : T.text-2;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Practice";
                        color: open ? T.accent-hi : T.text;
                        font-family: T.display;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                hta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggled(!root.open); }
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: loop-state == 1 ? T.led-red : loop-state == 3 ? T.led-yellow : loop-state == 2 ? T.led-green : #2A2D35;
                }
            }
            Caption {
                text: loop-wait == 2 ? "Loop: count-in…" : loop-wait == 1 ? "Loop: waits for the bar line"
                    : "Loop " + ["empty", "rec", "play", "dub", "stopped"][loop-state] + (loop-state == 0 ? "" : " " + loop-time);
            }
            Caption { text: drum-on ? "Drums " + bpm + " BPM" : "Drums off"; }
            Rectangle { horizontal-stretch: 1; }
            // mode requirement as a badge, not a sentence (the Practice page has its own)
            if badge: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    VerticalLayout { alignment: center; Lamp { size: 9px; c: T.led-yellow; lit: false; } }
                    bt := Text {
                        vertical-alignment: center;
                        text: T.hw ? "Looper, drums and tuner run on the PC engine" : "Audio engine stopped";
                        color: T.text-2;
                        font-size: 12px;
                    }
                    // the fix right next to the reason
                    if T.hw: Rectangle {
                        width: sw.preferred-width + 20px;
                        height: 24px;
                        border-radius: 6px;
                        background: swa.has-hover ? T.cyan.with-alpha(0.22) : T.cyan.with-alpha(0.12);
                        border-width: 1px;
                        border-color: T.cyan.with-alpha(0.45);
                        sw := Text {
                            text: "Switch to PC";
                            color: T.cyan;
                            font-size: 12px;
                            font-weight: 600;
                        }
                        swa := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.engine-request(); }
                        }
                    }
                }
            }
            if show-tuner: HorizontalLayout {
                spacing: 6px;
                opacity: tuner-active ? 1 : 0.6;
                Caption { text: "Tuner"; }
                Text {
                    min-width: 26px;
                    text: tuner-note;
                    color: tuner-active && abs(tuner-cents) < 3 ? T.led-green : T.text;
                    font-family: T.mono;
                    font-weight: 700;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 72px;
                    for i in 9: Rectangle {
                        x: i * (parent.width - 2px) / 8;
                        y: i == 4 ? (parent.height - 14px) / 2 : (parent.height - 6px) / 2;
                        width: 2px;
                        height: i == 4 ? 14px : 6px;
                        background: i == 4 ? T.text-3 : T.line-hi;
                    }
                    if tuner-active: Rectangle {
                        x: (parent.width - 4px) * (clamp(tuner-cents, -50, 50) + 50) / 100;
                        y: (parent.height - 14px) / 2;
                        width: 4px;
                        height: 14px;
                        border-radius: 1px;
                        background: abs(tuner-cents) < 3 ? T.led-green : T.accent;
                    }
                }
            }
            // keyboard hint as a key cap
            if !T.hw: HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: kt.preferred-width + 12px;
                        height: 20px;
                        border-radius: 3px;
                        background: T.panel-hi;
                        border-width: 1px;
                        border-color: T.line-hi;
                        kt := Text { text: "Space"; color: T.text-2; font-family: T.mono; font-size: 10px; }
                    }
                }
                Caption { text: open ? "Looper" : "Play DI"; }
            }
        }
    }
}
